@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vox Angelos | Register</title>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/dist/liveness/vox-angelos-v1.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
</head>
<body>
    <div class="bg"></div>

    <div id="loadingModal" class="registration-loading-modal" role="status" aria-live="polite">
        <div class="registration-loading-indicator"><div></div></div>
        <p>Checking identity</p>
    </div>

    <div id="resultModal" class="registration-result-modal" role="dialog" aria-modal="true" aria-labelledby="resultTitle">
        <div class="registration-result-card">
            <div id="resultIcon" class="registration-result-icon"></div>
            <h3 id="resultTitle"></h3>
            <p id="resultMessage"></p>
            <button onclick="closeResultModal()" class="cta registration-result-button">Acknowledge</button>
        </div>
    </div>

    <div class="main-viewport d-flex align-items-center justify-content-center w-100">
        <div class="tech-wrapper">
            <div class="row g-0">
                <div class="col-lg-5 panel-left">
                    <div class="glass-inner w-100">
                        <div class="portal-brand" aria-label="Vox Angelos">
                            <img src="~/assets/VoxAngelosLogo.png" alt="" />
                            <span><strong>Vox Angelos</strong><small>Citizen portal</small></span>
                        </div>
                        <span class="sys-label">Citizen enrollment</span>
                        <h1 class="portal-title">A stronger voice<br />starts here.</h1>
                        <p class="tagline">Create a verified citizen account to submit concerns, follow official updates, and take part in Angeles City recommendations.</p>
                        <div class="step-indicator" aria-label="Registration progress">
                            <div class="step-indicator__item active" id="si-step1">
                                <div class="step-indicator__dot">1</div>
                                <div class="step-indicator__text">Your details</div>
                            </div>
                            <div class="step-indicator__line"></div>
                            <div class="step-indicator__item" id="si-step2">
                                <div class="step-indicator__dot">2</div>
                                <div class="step-indicator__text">Verify identity</div>
                            </div>
                            <div class="step-indicator__line"></div>
                            <div class="step-indicator__item" id="si-step3">
                                <div class="step-indicator__dot">3</div>
                                <div class="step-indicator__text">Secure account</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7 panel-right">
                    <form id="registerForm" class="registration-form-panel" asp-route-returnUrl="@Model.ReturnUrl" method="post" enctype="multipart/form-data" autocomplete="off" novalidate>
                        <div class="top-part">
                            <a asp-area="" asp-page="/Index" class="back-link">
                                <span class="back-link-arrow" aria-hidden="true">←</span>
                                Back to Home Page
                            </a>
                        </div>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="tech-validation-summary" role="alert"></div>
                        <input type="file" id="selfieHiddenInput" name="Input.SelfiePhoto" style="display:none;" accept="image/*" />
                        <input type="file" id="idPhotoHiddenInput" name="Input.IdPhoto" style="display:none;" accept="image/*" />
                        <input type="hidden" id="faceVerificationToken" name="Input.FaceVerificationToken" />

                        <div id="step1">
                            <span class="eyebrow">Step 1 of 3</span>
                            <div class="step-title mb-3">Personal Information</div>

                            <div class="mb-2">
                                <label asp-for="Input.FirstName" class="form-text-label">First Name</label>
                                <input asp-for="Input.FirstName" class="form-control tech-input" placeholder="Juan" autocomplete="off" />
                                <span asp-validation-for="Input.FirstName" class="tech-validation"></span>
                            </div>

                            <div class="mb-2">
                                <label asp-for="Input.MiddleName" class="form-text-label">
                                    Middle Name <span class="optional-tag">(Optional)</span>
                                </label>
                                <input asp-for="Input.MiddleName" class="form-control tech-input" placeholder="Santos" autocomplete="off" />
                            </div>

                            <div class="mb-2">
                                <label asp-for="Input.LastName" class="form-text-label">Last Name</label>
                                <input asp-for="Input.LastName" class="form-control tech-input" placeholder="dela Cruz" autocomplete="off" />
                                <span asp-validation-for="Input.LastName" class="tech-validation"></span>
                            </div>

                            <div class="mb-2">
                                <label asp-for="Input.PhoneNumber" class="form-text-label">Phone Number</label>
                                <div class="phone-wrapper">
                                    <span class="phone-prefix">+63</span>
                                    <input asp-for="Input.PhoneNumber" class="form-control tech-input" placeholder="9XXXXXXXXX" autocomplete="off" maxlength="10" inputmode="numeric" oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                                </div>
                                <span asp-validation-for="Input.PhoneNumber" class="tech-validation"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.Email" class="form-text-label">Email Address</label>
                                <input asp-for="Input.Email" class="form-control tech-input" placeholder="name@example.com" autocomplete="off" />
                                <span asp-validation-for="Input.Email" class="tech-validation"></span>
                            </div>

                            <button type="button" id="nextStepButton" class="cta w-100">
                                Next Step <span class="cta-arr ms-2"></span>
                            </button>

                            <div class="mt-2 text-center sign-in-note">
                                Already registered? <a asp-page="./Login" class="tech-link ms-1">Sign in here</a>
                            </div>
                        </div>

                        <div id="step2" style="display:none;">
                            <span class="eyebrow">Step 2 of 3</span>
                            <div class="step-title mb-3">Identity Verification</div>

                            <div id="privacyAgreementSection" class="mb-3">
                                <div class="privacy-agreement-card">
                                    <div class="privacy-agreement__header">
                                        <h4 class="privacy-agreement__title">Data Privacy Consent</h4>
                                        <p class="privacy-agreement__subtitle">Republic Act No. 10173</p>
                                    </div>
                                    <div class="privacy-agreement__content">
                                        <p class="privacy-agreement__intro">
                                            By proceeding with identity verification, you acknowledge that:
                                        </p>
                                        <div class="privacy-terms">
                                            <div class="privacy-term">
                                                <svg class="term-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                                <div>
                                                    <strong>Data Collection & Processing:</strong> Your personal information, including government-issued ID and biometric data (selfie), will be collected and processed solely for identity verification purposes in accordance with RA 10173.
                                                </div>
                                            </div>
                                            <div class="privacy-term">
                                                <svg class="term-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                                <div>
                                                    <strong>Lawful Basis:</strong> Your data is processed under the legitimate purpose of account authentication and compliance with government regulations for the Vox Angelos platform.
                                                </div>
                                            </div>
                                            <div class="privacy-term">
                                                <svg class="term-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                                <div>
                                                    <strong>Data Security:</strong> All data is encrypted and protected using industry-standard security measures. Access is restricted to authorized personnel only.
                                                </div>
                                            </div>
                                            <div class="privacy-term">
                                                <svg class="term-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                                <div>
                                                    <strong>Your Rights:</strong> You have the right to access, correct, or delete your personal data. Contact National Privacy Commission (NPC) for any concerns.
                                                </div>
                                            </div>
                                            <div class="privacy-term">
                                                <svg class="term-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                                <div>
                                                    <strong>Retention Period:</strong> Your data will be retained for the duration of your account plus 3 years thereafter, in compliance with Philippine law.
                                                </div>
                                            </div>
                                        </div>
                                        <div class="privacy-agreement__consent mt-3">
                                            <div class="consent-checkbox">
                                                <input type="checkbox" id="privacyConsent" name="Input.PrivacyConsent" />
                                                <label for="privacyConsent" class="consent-label ms-2">I have read and agree to the privacy terms</label>
                                            </div>
                                            <span id="privacyConsentError" class="tech-validation" style="display:none;">You must consent to proceed</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div id="identityFields" style="display:none;">
                                <div class="mb-2">
                                    <label asp-for="Input.IdType" class="form-text-label">ID Type</label>
                                    <select asp-for="Input.IdType" id="idTypeSelect" class="form-select tech-input tech-select" onchange="onIdTypeChange()">
                                        <option value="">— Select ID Type —</option>
                                        <option value="National ID">National ID</option>
                                        <option value="Driver's License">Driver's License</option>
                                        <option value="Passport">Passport</option>
                                        <option value="Voter's ID">Voter's ID</option>
                                    </select>
                                    <span asp-validation-for="Input.IdType" class="tech-validation"></span>
                                </div>

                                <div class="mb-2" id="idPhotoSection" style="display:none;">
                                    <p class="id-type-help" id="idTypeHelp"></p>
                                    <ul class="id-capture-checklist">
                                        <li>Don't cover any part of the ID</li>
                                        <li>Avoid glare — angle away from direct light</li>
                                        <li>Use your physical ID, not a photo or a screen</li>
                                    </ul>
                                    <div id="idCaptureSlots"></div>
                                    <span asp-validation-for="Input.IdPhoto" class="tech-validation"></span>
                                </div>

                                <div class="mb-2">
                                    <label class="form-text-label">Live Face Check</label>
                                    <section class="face-check-card" id="faceCheckCard" aria-label="Secure live face verification">
                                        <div class="face-check-card__header">
                                            <span class="face-check-card__icon" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" fill="none"><path d="M12 3 5.5 5.7v5.8c0 4.1 2.7 7.8 6.5 9.5 3.8-1.7 6.5-5.4 6.5-9.5V5.7L12 3Z" stroke="currentColor" stroke-width="1.7"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                            </span>
                                            <span class="face-check-card__copy">
                                                <strong>Secure face verification</strong>
                                                <small>A short guided video confirms you are present.</small>
                                            </span>
                                            <span class="face-check-card__badge">Secure</span>
                                        </div>
                                        <div id="awsLivenessRoot" class="aws-liveness-shell"
                                             data-config='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { region = Model.AwsRegion, identityPoolId = Model.AwsIdentityPoolId }))'></div>
                                        <div class="camera-controls" id="cameraControls">
                                            <button type="button" id="btnStartCamera" onclick="startAwsLiveness()" class="face-check-start">Start secure face check <span aria-hidden="true">→</span></button>
                                        </div>
                                        <div id="selfieStatus" class="selfie-status" aria-live="polite"></div>
                                        <p class="face-check-card__privacy">Your video is encrypted and used only for this identity check.</p>
                                    </section>
                                </div>
                            </div>

                            <div class="d-flex gap-3 mt-3">
                                <button type="button" class="cta-back" onclick="goToStep1()">Back</button>
                                <button type="button" id="step2NextBtn" class="cta flex-grow-1" onclick="goToStep3()">
                                    Next Step <span class="cta-arr ms-2"></span>
                                </button>
                            </div>
                        </div>

                        <div id="step3" style="display:none;">
                            <span class="eyebrow">Step 3 of 3</span>
                            <div class="step-title mb-3">Account Security</div>

                            <div class="mb-2">
                                <label asp-for="Input.Password" class="form-text-label">Password</label>
                                <div class="pw-wrapper">
                                    <input asp-for="Input.Password" id="regPassword" class="form-control tech-input w-100" type="password" oninput="checkPasswordRules()" placeholder="••••••••" />
                                    <button type="button" class="pw-toggle" onclick="togglePw('regPassword', this)" tabindex="-1">
                                        <svg id="regPassword-eye" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                            <path d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                                            <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        </svg>
                                    </button>
                                </div>
                                <span asp-validation-for="Input.Password" class="tech-validation"></span>
                                <div class="pw-guidelines">
                                    <div class="pw-rule" id="rule-length"><span class="pw-rule-icon">✕</span> At least 6 characters</div>
                                    <div class="pw-rule" id="rule-upper"><span class="pw-rule-icon">✕</span> At least one uppercase letter</div>
                                    <div class="pw-rule" id="rule-lower"><span class="pw-rule-icon">✕</span> At least one lowercase letter</div>
                                    <div class="pw-rule" id="rule-digit"><span class="pw-rule-icon">✕</span> At least one number</div>
                                    <div class="pw-rule" id="rule-special"><span class="pw-rule-icon">✕</span> At least one special character</div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.ConfirmPassword" class="form-text-label">Confirm Password</label>
                                <div class="pw-wrapper">
                                    <input asp-for="Input.ConfirmPassword" id="regConfirmPassword" class="form-control tech-input w-100" type="password" oninput="checkMatch()" placeholder="••••••••" />
                                    <button type="button" class="pw-toggle" onclick="togglePw('regConfirmPassword', this)" tabindex="-1">
                                        <svg id="regConfirmPassword-eye" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                            <path d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                                            <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        </svg>
                                    </button>
                                </div>
                                <span asp-validation-for="Input.ConfirmPassword" class="tech-validation"></span>
                                <div class="pw-rule mt-1" id="rule-match" style="display:none;"><span class="pw-rule-icon">✕</span> Passwords match</div>
                            </div>

                            <span id="createAccountGeneralError" class="tech-validation d-block mb-2" style="display:none;"></span>

                            <div class="d-flex gap-3">
                                <button type="button" class="cta-back w-50" onclick="goBackToStep2()">Back</button>
                                <button id="registerSubmit" type="button" class="cta w-50" onclick="submitRegistration()">Create Account</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div id="cameraCaptureModal" class="camera-capture-modal" role="dialog" aria-modal="true" aria-labelledby="cameraCaptureTitle" aria-hidden="true">
        <div class="camera-capture-dialog">
            <div class="camera-capture-header">
                <div>
                    <span class="eyebrow">Live Selfie</span>
                    <h2 id="cameraCaptureTitle">Center your face in the guide</h2>
                </div>
                <button type="button" class="camera-close-button" onclick="closeCameraCapture()" aria-label="Close camera">×</button>
            </div>
            <p class="camera-capture-help">Keep your whole face visible, including your forehead and chin. Remove masks, hats, and sunglasses.</p>
            <div class="camera-capture-viewport">
                <video id="cameraOverlayBackdrop" autoplay playsinline muted aria-hidden="true"></video>
                <video id="cameraOverlayFeed" autoplay playsinline></video>
                <div class="face-guide" aria-hidden="true"></div>
            </div>
            <div class="camera-capture-actions">
                <button type="button" class="cta-back" onclick="closeCameraCapture()">Cancel</button>
                <button type="button" id="btnCapture" onclick="capturePhoto()" class="cta">Capture Selfie</button>
            </div>
        </div>
    </div>

    <div id="idCaptureModal" class="camera-capture-modal" role="dialog" aria-modal="true" aria-labelledby="idCaptureTitle" aria-hidden="true">
        <div class="camera-capture-dialog">
            <div class="camera-capture-header">
                <div>
                    <span class="eyebrow" id="idCaptureEyebrow">ID Scan</span>
                    <h2 id="idCaptureTitle">Align your ID in the guide</h2>
                </div>
                <button type="button" class="camera-close-button" onclick="closeIdCapture()" aria-label="Close camera">×</button>
            </div>
            <ul class="id-capture-checklist">
                <li>Don't cover any part of the ID</li>
                <li>Avoid glare — angle away from direct light</li>
                <li>Use your physical ID, not a photo or a screen</li>
            </ul>
            <div class="camera-capture-viewport">
                <video id="idOverlayBackdrop" autoplay playsinline muted aria-hidden="true"></video>
                <video id="idOverlayFeed" autoplay playsinline></video>
                <div class="id-guide" id="idGuide" aria-hidden="true"></div>
            </div>
            <div id="idCaptureHint" class="selfie-status"></div>
            <div class="camera-capture-actions">
                <button type="button" class="cta-back" onclick="closeIdCapture()">Cancel</button>
                <button type="button" id="btnCaptureId" onclick="captureIdPhoto()" class="cta">Capture ID</button>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/dist/liveness/liveness.js" defer></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        let cameraStream = null;
        let livenessCompleted = false;

        // ── Privacy Consent Logic ─────────────────────────────────────
        document.getElementById('privacyConsent').addEventListener('change', function() {
        const privacyCard = document.getElementById('privacyAgreementSection');
        const identityFields = document.getElementById('identityFields');
        document.getElementById('privacyConsentError').style.display = 'none';
            
        if (this.checked) {
        $(privacyCard).fadeOut(300, function() { $(identityFields).fadeIn(400); });
        } else {
        $(identityFields).fadeOut(300, function() { $(privacyCard).fadeIn(400); });
        }
        });

        // ── ID Type Config & Capture ───────────────────────────────────
        // ratio = width/height of the guide overlay and the dimension check below.
        // Every supported ID type only needs its front captured — passports and
        // National ID both carry everything required on a single side.
        const ID_CONFIG = {
        "National ID":      { ratio: 1.585, help: "Everything we need is on the front of your National ID." },
        "Driver's License":  { ratio: 1.585, help: "Everything we need is on the front of your license." },
        "Passport":          { ratio: 1.42,  help: "Use the photo/bio-data page only." },
        "Voter's ID":        { ratio: 1.585, help: "Everything we need is on the front of your Voter's ID." },
        };

        let idFile = null;
        let idCameraStream = null;
        let idHintInterval = null;

        // Keeps the real, form-bound hidden input (Input.IdPhoto) in sync with
        // whatever was last scanned or uploaded — submitRegistration() reads it via
        // `new FormData(form)` for the final account-creation POST, the same way
        // #selfieHiddenInput already works for the selfie capture.
        function syncIdHiddenInput(file) {
        resetFaceVerification();
        const input = document.getElementById('idPhotoHiddenInput');
        if (file) {
        const dt = new DataTransfer(); dt.items.add(file);
        input.files = dt.files;
        } else {
        input.value = '';
        }
        }

        function resetFaceVerification() {
        livenessCompleted = false;
        document.getElementById('faceVerificationToken').value = '';
        setStatus('', '');
        }

        function startAwsLiveness() {
        if (!idFile || !document.getElementById('idTypeSelect').value) {
        return setStatus('Select and capture your ID before starting the face check.', 'error');
        }
        setStatus('Preparing secure liveness check…', '');
        document.getElementById('faceCheckCard').classList.add('is-loading');
        window.dispatchEvent(new Event('vox:start-liveness'));
        }

        window.addEventListener('vox:liveness-started', () => {
        document.getElementById('faceCheckCard').classList.remove('is-loading');
        document.getElementById('faceCheckCard').classList.add('is-active');
        });

        window.addEventListener('vox:liveness-ended', () => {
        document.getElementById('faceCheckCard').classList.remove('is-loading', 'is-active');
        });

        window.addEventListener('vox:liveness-complete', async event => {
        $('#loadingModal').css('display', 'flex');
        const formData = new FormData();
        formData.append('idType', document.getElementById('idTypeSelect').value);
        formData.append('idPhoto', idFile);
        formData.append('sessionId', event.detail.sessionId);
        try {
        const response = await fetch('?handler=CompleteFaceLiveness', {
        method: 'POST', body: formData,
        headers: { RequestVerificationToken: document.querySelector('input[name="__RequestVerificationToken"]').value }
        });
        const data = await response.json();
        const metricText = data.metrics
        ? ` Liveness: ${data.metrics.liveness}%. Face similarity: ${data.metrics.similarity}%. Required: ${data.metrics.requiredSimilarity}%.`
        : '';
        if (!response.ok || !data.success) throw new Error((data.error || 'Face verification failed.') + metricText);
        document.getElementById('faceVerificationToken').value = data.verificationToken;
        livenessCompleted = true;
        setStatus('Live face verified against your ID.' + metricText, 'success');
        } catch (error) {
        resetFaceVerification();
        setStatus(error.message, 'error');
        } finally { $('#loadingModal').hide(); }
        });

        function onIdTypeChange() {
        const val = document.getElementById('idTypeSelect').value;
        document.getElementById('idPhotoSection').style.display = val ? 'block' : 'none';
        idFile = null;
        syncIdHiddenInput(null);
        if (!val) { document.getElementById('idCaptureSlots').innerHTML = ''; return; }

        const cfg = ID_CONFIG[val];
        document.getElementById('idTypeHelp').textContent = cfg.help;
        document.getElementById('idCaptureSlots').innerHTML = `
        <div class="id-capture-slot">
        <div class="id-capture-buttons">
        <button type="button" class="btn-camera-text" onclick="openIdCapture()">📷 Scan ID</button>
        <button type="button" class="btn-camera-text" onclick="document.getElementById('idFileInput').click()">⬆ Upload Photo</button>
        </div>
        <input type="file" id="idFileInput" class="file-input" accept=".jpg,.jpeg,.png" style="display:none;" onchange="handleIdFileSelected(event)" />
        <div class="id-capture-preview" id="idPreview"><span class="id-preview-placeholder">No photo yet</span></div>
        <div class="id-capture-status" id="idStatus"></div>
        </div>
        `;
        }

        async function handleIdFileSelected(event) {
        const file = event.target.files[0];
        if (!file) return;
        // Phones embed an EXIF orientation tag on freshly-taken photos instead of
        // rotating the actual pixel data; browsers honor it for display, but the
        // raw bytes we'd otherwise upload are still sideways. Re-drawing onto a
        // canvas bakes in the on-screen orientation and strips the EXIF tag.
        idFile = await normalizeImageOrientation(file);
        syncIdHiddenInput(idFile);
        renderIdPreview();
        }

        function renderIdPreview() {
        const container = document.getElementById('idPreview');
        const status = document.getElementById('idStatus');
        if (!idFile) {
        container.classList.remove('has-photo');
        container.innerHTML = '<span class="id-preview-placeholder">No photo yet</span>';
        status.textContent = '';
        return;
        }
        container.classList.add('has-photo');
        container.innerHTML = `<img src="${URL.createObjectURL(idFile)}" alt="ID photo" />` +
        '<button type="button" class="id-preview-remove" onclick="clearIdPhoto()" aria-label="Remove ID photo" title="Remove photo">×</button>';
        status.textContent = 'Captured. Tap Scan or Upload again to retake.';
        status.className = 'id-capture-status success';
        }

        // Lets the applicant explicitly clear a captured/uploaded ID photo instead of
        // the only path being Scan/Upload again, which silently overwrote it with no
        // way back.
        function clearIdPhoto() {
        idFile = null;
        syncIdHiddenInput(null);
        renderIdPreview();
        }

        // ── ID Capture Modal ────────────────────────────────────────────
        async function openIdCapture() {
        const idType = document.getElementById('idTypeSelect').value;
        const cfg = ID_CONFIG[idType];
        document.getElementById('idCaptureEyebrow').textContent = idType;
        document.getElementById('idCaptureTitle').textContent = 'Align your ID in the guide';
        document.getElementById('idGuide').style.setProperty('--id-ratio', cfg.ratio);
        document.getElementById('idCaptureHint').textContent = '';

        try {
        stopIdCamera();
        idCameraStream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: { ideal: 'environment' }, width: { ideal: 1280 }, height: { ideal: 960 } },
        audio: false
        });
        document.getElementById('idOverlayFeed').srcObject = idCameraStream;
        document.getElementById('idOverlayBackdrop').srcObject = idCameraStream;
        document.getElementById('idCaptureModal').classList.add('is-open');
        document.getElementById('idCaptureModal').setAttribute('aria-hidden', 'false');
        startIdHintSampling();
        } catch(e) {
        document.getElementById('idStatus').textContent = 'We could not open your camera. Please allow camera access or upload a photo instead.';
        document.getElementById('idStatus').className = 'id-capture-status error';
        }
        }

        function captureIdPhoto() {
        const v = document.getElementById('idOverlayFeed');
        const c = document.createElement('canvas');
        c.width = v.videoWidth; c.height = v.videoHeight;
        c.getContext('2d').drawImage(v, 0, 0);
        closeIdCapture();
        c.toBlob(blob => {
        idFile = new File([blob], 'id-photo.jpg', { type: 'image/jpeg' });
        syncIdHiddenInput(idFile);
        renderIdPreview();
        }, 'image/jpeg', 0.92);
        }

        function closeIdCapture() {
        document.getElementById('idCaptureModal').classList.remove('is-open');
        document.getElementById('idCaptureModal').setAttribute('aria-hidden', 'true');
        stopIdCamera();
        }

        function stopIdCamera() {
        stopIdHintSampling();
        if (idCameraStream) idCameraStream.getTracks().forEach(t => t.stop());
        idCameraStream = null;
        document.getElementById('idOverlayFeed').srcObject = null;
        document.getElementById('idOverlayBackdrop').srcObject = null;
        }

        // Advisory-only live hints while scanning — never blocks capture. The server
        // response after capture/upload remains the authoritative pass/fail check.
        function startIdHintSampling() {
        const v = document.getElementById('idOverlayFeed');
        const hint = document.getElementById('idCaptureHint');
        const sampleCanvas = document.createElement('canvas');
        sampleCanvas.width = 96; sampleCanvas.height = 72;
        const ctx = sampleCanvas.getContext('2d', { willReadFrequently: true });
        idHintInterval = setInterval(() => {
        if (!v.videoWidth) return;
        ctx.drawImage(v, 0, 0, sampleCanvas.width, sampleCanvas.height);
        const data = ctx.getImageData(0, 0, sampleCanvas.width, sampleCanvas.height).data;
        let brightCount = 0, gradientSum = 0, prevLuma = null;
        for (let i = 0; i < data.length; i += 4) {
        const luma = 0.299*data[i] + 0.587*data[i+1] + 0.114*data[i+2];
        if (luma > 245) brightCount++;
        if (prevLuma !== null) gradientSum += Math.abs(luma - prevLuma);
        prevLuma = luma;
        }
        const pixelCount = data.length / 4;
        const glareRatio = brightCount / pixelCount;
        const avgGradient = gradientSum / pixelCount;
        if (glareRatio > 0.18) { hint.textContent = 'Glare detected — tilt the ID slightly.'; hint.className = 'id-capture-status error'; }
        else if (avgGradient < 2) { hint.textContent = 'Looks blurry — hold steady.'; hint.className = 'id-capture-status error'; }
        else { hint.textContent = 'Looking good — capture when ready.'; hint.className = 'id-capture-status success'; }
        }, 400);
        }

        function stopIdHintSampling() {
        if (idHintInterval) clearInterval(idHintInterval);
        idHintInterval = null;
        }

        // ── Step navigation ───────────────────────────────────────────
        function setRegistrationInteractionLock(locked) {
        const form = document.getElementById('registerForm');
        form.inert = locked;
        if (locked) form.setAttribute('aria-busy', 'true');
        else form.removeAttribute('aria-busy');
        }

        async function goToStep2() {
        let isValid = true;
        ['#Input_FirstName','#Input_LastName','#Input_Email','#Input_PhoneNumber'].forEach(f => { if (!$(f).valid()) isValid = false; });
        if (!isValid) return;

        const btn = document.getElementById('nextStepButton');
        setRegistrationInteractionLock(true);
        btn.disabled = true; btn.innerHTML = 'Validating...';
        const email = $('#Input_Email').val();
        const phone = '+63' + $('#Input_PhoneNumber').val();

        try {
        const res = await fetch(`?handler=CheckDuplicates&email=${encodeURIComponent(email)}&phone=${encodeURIComponent(phone)}`);
        const data = await res.json();
        $('.custom-duplicate-error').remove();
        if (data.success) { showStep(1, 2); }
        else {
        for (const [id, msg] of Object.entries(data.errors)) {
        $(`#${id}`).after(`<span class="text-danger custom-duplicate-error tech-validation">${msg}</span>`);
        }
        }
        } finally { setRegistrationInteractionLock(false); btn.disabled = false; btn.innerHTML = 'Next Step <span class="cta-arr ms-2"></span>'; }
        }

        document.getElementById('nextStepButton').addEventListener('click', goToStep2);

        async function goToStep3() {
        if (!document.getElementById('privacyConsent').checked) {
        document.getElementById('privacyConsentError').style.display = 'block';
        return;
        }

        const idType = document.getElementById('idTypeSelect').value;
        if (!idType) return showResultModal('error', 'ID Required', 'Please select an ID type.');
        const cfg = ID_CONFIG[idType];

        if (!idFile) {
        return showResultModal('error', 'Photo Required', 'Please scan or upload your ID photo.');
        }
        if (!livenessCompleted || !document.getElementById('faceVerificationToken').value)
        return setStatus('Complete the secure live face check before continuing.', 'error');

        const dimensionOk = await checkIdDimensions(idFile, cfg);
        if (!dimensionOk) return;

        showResultModal('success', 'Verified', 'Identity check successful.', () => showStep(2, 3));
        }

        function normalizeImageOrientation(file) {
        return new Promise((resolve) => {
        const img = new Image();
        img.onload = function() {
        const canvas = document.createElement('canvas');
        canvas.width = img.naturalWidth;
        canvas.height = img.naturalHeight;
        canvas.getContext('2d').drawImage(img, 0, 0);
        URL.revokeObjectURL(img.src);
        canvas.toBlob((blob) => {
        resolve(new File([blob], 'id-photo.jpg', { type: 'image/jpeg' }));
        }, 'image/jpeg', 0.92);
        };
        img.src = URL.createObjectURL(file);
        });
        }

        function checkIdDimensions(file, cfg) {
        return new Promise((resolve) => {
        const img = new Image();
        img.onload = function() {
        const ratio = img.naturalWidth / img.naturalHeight;
        // Some mobile browsers report a captured photo's raw pixel dimensions
        // rotated relative to what was actually filmed/displayed (a getUserMedia
        // or EXIF-handling quirk, not a bad capture) — so a genuinely correct
        // landscape ID can still arrive with portrait-shaped naturalWidth/Height.
        // Accept either the expected orientation or its 90°-rotated (reciprocal)
        // form; only reject something that matches neither, like an unrelated
        // square/portrait photo.
        const reciprocalRatio = 1 / cfg.ratio;
        const matchesExpected = Math.abs(ratio - cfg.ratio) / cfg.ratio <= 0.25;
        const matchesRotated = Math.abs(ratio - reciprocalRatio) / reciprocalRatio <= 0.25;
        if (!matchesExpected && !matchesRotated) {
        showResultModal('error', 'Invalid Format', `Your ID photo doesn't look like a ${cfg.ratio > 1 ? 'landscape' : 'portrait'} ID photo. Please retake it so the whole ID fills the guide.`);
        resolve(false);
        } else resolve(true);
        };
        img.src = URL.createObjectURL(file);
        });
        }

        function showStep(from, to) {
        $(`#step${from}`).hide(); $(`#step${to}`).show();
        $(`#si-step${from}`).removeClass('active').addClass('done');
        $(`#si-step${to}`).addClass('active');
        window.scrollTo(0,0);
        }

        function goToStep1() { stopCamera(); stopIdCamera(); showStep(2, 1); }
        function goBackToStep2() { showStep(3, 2); }

        // ── Final submission (AJAX, no page reload) ────────────────────
        // Kept in-place on Step 3 regardless of which field fails server-side
        // validation (e.g. password policy), instead of doing a native form
        // submit — a full page reload would reset the wizard to Step 1 and
        // wipe the already-selected ID photo / captured selfie, since browsers
        // never restore <input type="file"> values after a navigation.
        async function submitRegistration() {
        document.querySelectorAll('.custom-account-error').forEach(el => el.remove());
        document.getElementById('createAccountGeneralError').style.display = 'none';

        const btn = document.getElementById('registerSubmit');
        const originalText = btn.textContent;
        setRegistrationInteractionLock(true);
        btn.disabled = true; btn.textContent = 'Creating Account...';
        let registrationSucceeded = false;

        // Re-check email/phone duplicates right before the real submit — Step 1
        // already checked these, but time has passed (ID/selfie verification in
        // between), so someone else could have taken the same email/phone since
        // then. Catching it here, with a clear popup back to Step 1, is much
        // better than only finding out after this expensive step, buried in an
        // inline message on a step that's no longer visible.
        const email = $('#Input_Email').val();
        const phone = '+63' + $('#Input_PhoneNumber').val();
        try {
        const dupRes = await fetch(`?handler=CheckDuplicates&email=${encodeURIComponent(email)}&phone=${encodeURIComponent(phone)}`);
        const dupData = await dupRes.json().catch(() => null);
        if (dupData && !dupData.success) {
        setRegistrationInteractionLock(false);
        btn.disabled = false; btn.textContent = originalText;
        $('.custom-duplicate-error').remove();
        for (const [id, msg] of Object.entries(dupData.errors)) {
        $(`#${id}`).after(`<span class="text-danger custom-duplicate-error tech-validation">${msg}</span>`);
        }
        const messages = Object.values(dupData.errors).join(' ');
        showResultModal('error', 'Please Check Your Info', messages, () => showStep(3, 1));
        return;
        }
        } catch (e) {
        // If the duplicate pre-check itself fails to reach the server, fall
        // through to the real submit below — it re-validates the same thing
        // server-side and will surface its own error if still a problem.
        }

        const form = document.getElementById('registerForm');
        const formData = new FormData(form);
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        try {
        const res = await fetch('?handler=CreateAccount', {
        method: 'POST',
        body: formData,
        headers: { 'RequestVerificationToken': token }
        });
        const data = await res.json().catch(() => null);

        if (data?.success) {
        registrationSucceeded = true;
        window.location.href = data.redirectUrl;
        return;
        }

        let shown = false;

        if (data?.fieldErrors) {
        for (const [id, msg] of Object.entries(data.fieldErrors)) {
        const field = document.getElementById(id);
        // Fields like Input_PhoneNumber live on Step 1, but this handler only
        // ever runs from Step 3 — if the field's step is currently hidden,
        // inserting the message right after it is invisible to the user (this
        // was the "nothing happens" bug). Always also surface it in the
        // Step 3 general error banner so it's visible regardless of which
        // step the failing field lives on.
        const isVisible = field && field.offsetParent !== null;
        if (field) {
        field.insertAdjacentHTML('afterend', `<span class="text-danger custom-account-error tech-validation">${msg}</span>`);
        }
        if (!isVisible) {
        const el = document.getElementById('createAccountGeneralError');
        el.textContent = (el.textContent ? el.textContent + ' ' : '') + msg;
        el.style.display = 'block';
        }
        shown = true;
        }
        }

        if (data?.generalErrors && data.generalErrors.length) {
        const el = document.getElementById('createAccountGeneralError');
        el.textContent = data.generalErrors.join(' ');
        el.style.display = 'block';
        shown = true;
        }

        // Rate-limiter rejections (and other flat error responses) use
        // {success:false, error:"..."} instead of fieldErrors/generalErrors.
        if (!shown && data?.error) {
        const el = document.getElementById('createAccountGeneralError');
        el.textContent = data.error;
        el.style.display = 'block';
        shown = true;
        }

        // Last resort: something failed (non-2xx, unparseable body, or a shape
        // we don't recognize) but we still haven't shown anything — never let
        // the button just silently reset with no explanation.
        if (!shown) {
        const el = document.getElementById('createAccountGeneralError');
        el.textContent = `Something went wrong (server returned ${res.status}). Please try again.`;
        el.style.display = 'block';
        }
        } catch (e) {
        showResultModal('error', 'Error', 'Connection error. Please try again.');
        } finally {
        if (!registrationSucceeded) setRegistrationInteractionLock(false);
        btn.disabled = false; btn.textContent = originalText;
        }
        }

        // ── Result Feedback Modal ─────────────────────────────────────
        function showResultModal(type, title, message, callback) {
        const icon = type === 'success' ?
        `<svg viewBox="0 0 100 100" class="svg-icon svg-info"><circle cx="50" cy="50" r="42" stroke="#2B45B0" stroke-width="5" fill="none"/><path d="M50,30 L50,70" stroke="#2B45B0" stroke-width="6" stroke-linecap="round"/></svg>` :
        `<svg viewBox="0 0 100 100" class="svg-icon svg-error"><circle cx="50" cy="50" r="42" stroke="#e53e3e" stroke-width="5" fill="none"/><path d="M34,34 L66,66 M66,34 L34,66" stroke="#e53e3e" stroke-width="6" stroke-linecap="round"/></svg>`;
        $('#resultIcon').html(icon); $('#resultTitle').text(title); $('#resultMessage').text(message);
        $('#resultModal').css('display', 'flex');
        window.onModalClose = callback;
        }

        function closeResultModal() { $('#resultModal').hide(); if(window.onModalClose) window.onModalClose(); }

        // ── Camera Implementation ──────────────────────────────────────
        async function startCamera() {
        try {
        stopCamera();
        cameraStream = await navigator.mediaDevices.getUserMedia({
            video: {
                facingMode: { ideal: 'user' },
                width: { ideal: 720 },
                height: { ideal: 960 },
                aspectRatio: { ideal: 0.75 }
            },
            audio: false
        });
        document.getElementById('cameraOverlayFeed').srcObject = cameraStream;
        document.getElementById('cameraOverlayBackdrop').srcObject = cameraStream;
        document.getElementById('cameraCaptureModal').classList.add('is-open');
        document.getElementById('cameraCaptureModal').setAttribute('aria-hidden', 'false');
        } catch(e) { setStatus('We could not open your camera. Please allow camera access and try again.', 'error'); }
        }

        function capturePhoto() {
        const v = document.getElementById('cameraOverlayFeed'), c = document.getElementById('capturedCanvas');
        c.width = v.videoWidth; c.height = v.videoHeight;
        c.getContext('2d').drawImage(v, 0, 0);
        closeCameraCapture();
        $('#capturedCanvas').show(); $('#selfiePreviewPlaceholder').hide(); $('#btnStartCamera').hide(); $('#btnRetake').show();
        c.toBlob(blob => {
        const file = new File([blob], 'selfie.jpg', { type: 'image/jpeg' });
        const dt = new DataTransfer(); dt.items.add(file);
        document.getElementById('selfieHiddenInput').files = dt.files;
        selfieCaptured = true; setStatus('Biometric captured.', 'success');
        }, 'image/jpeg', 0.9);
        }

        function retakePhoto() {
        selfieCaptured = false;
        $('#capturedCanvas').hide(); $('#selfiePreviewPlaceholder').show(); $('#btnRetake').hide(); $('#btnStartCamera').show();
        setStatus('', '');
        startCamera();
        }
        function closeCameraCapture() {
        document.getElementById('cameraCaptureModal').classList.remove('is-open');
        document.getElementById('cameraCaptureModal').setAttribute('aria-hidden', 'true');
        stopCamera();
        }
        function stopCamera() {
        if (cameraStream) cameraStream.getTracks().forEach(t => t.stop());
        cameraStream = null;
        document.getElementById('cameraOverlayFeed').srcObject = null;
        document.getElementById('cameraOverlayBackdrop').srcObject = null;
        }
        function setStatus(m, t) { $('#selfieStatus').text(m).removeClass('success error').addClass(t); }

        // ── Security Validation ────────────────────────────────────────
        function togglePw(id) { const i = document.getElementById(id); i.type = i.type === 'password' ? 'text' : 'password'; }
        function checkPasswordRules() {
        const v = $('#regPassword').val();
        setRule('rule-length', v.length >= 6);
        setRule('rule-upper', /[A-Z]/.test(v));
        setRule('rule-lower', /[a-z]/.test(v));
        setRule('rule-digit', /[0-9]/.test(v));
        setRule('rule-special', /[^A-Za-z0-9]/.test(v));
        checkMatch();
        }
        function setRule(id, met) { const el = document.getElementById(id); el.classList.toggle('met', met); el.querySelector('.pw-rule-icon').textContent = met ? '✓' : '✕'; }
        function checkMatch() {
        const p = $('#regPassword').val(), c = $('#regConfirmPassword').val();
        if(!c) return $('#rule-match').hide();
        $('#rule-match').show().toggleClass('met', p === c && p !== '');
        document.getElementById('rule-match').querySelector('.pw-rule-icon').textContent = (p === c && p !== '') ? '✓' : '✕';
        }

        window.addEventListener('load', () => { setTimeout(() => { document.querySelectorAll('input:not([type="hidden"])').forEach(i => i.value = ''); }, 100); });
        window.addEventListener('beforeunload', stopCamera);
        window.addEventListener('beforeunload', stopIdCamera);
    </script>
    <script src="~/js/form-submit-lock.js" asp-append-version="true"></script>
</body>
</html>
