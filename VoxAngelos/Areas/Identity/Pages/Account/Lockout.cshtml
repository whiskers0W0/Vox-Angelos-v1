@page
@model LockoutModel
@{
    ViewData["Title"] = "Account Locked";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vox Angelos | Account Locked</title>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&family=Syne+Mono&family=Barlow:wght@300;400&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/lockout.css" asp-append-version="true" />
</head>
<body>
    <div class="lockout-background" aria-hidden="true"></div>

    <main class="lockout-shell">
        <div class="lockout-card">
            <aside class="lockout-brand-panel">
                <div class="portal-brand" aria-label="Vox Angelos">
                    <img src="~/assets/VoxAngelosLogo.png" alt="" />
                    <span><strong>Vox Angelos</strong><small>Citizen portal</small></span>
                </div>

                <span class="sys-label">Account security</span>
                <h1 class="portal-title">Your access<br />is protected.</h1>
                <p class="portal-copy">Account safeguards help protect your reports, recommendations, and personal information.</p>

                <ul class="security-points" aria-label="Account protection details">
                    <li><span aria-hidden="true">01</span> Temporary lockout protection</li>
                    <li><span aria-hidden="true">02</span> Automatic re-entry when time expires</li>
                </ul>
            </aside>

            <section class="lockout-content" aria-labelledby="lockout-heading">
                <div class="lockout-panel">
                    <span class="eyebrow">Security notice</span>
                    <span class="security-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /><path d="M12 14v2" /></svg>
                    </span>
                    <h2 id="lockout-heading">Account temporarily locked</h2>
                    <p class="lockout-intro">We paused sign-in after several unsuccessful attempts to help keep your account secure.</p>

                    @if (Model.MinutesRemaining > 0 || Model.SecondsRemaining > 0)
                    {
                        <div class="countdown-card" aria-live="polite">
                            <span class="countdown-label">Time remaining before you can try again</span>
                            <div class="time-remaining" id="countdown">
                                <span class="time-number" id="minutes">@Model.MinutesRemaining</span><span class="time-unit">min</span>
                                <span class="time-number" id="seconds">@Model.SecondsRemaining.ToString("D2")</span><span class="time-unit">sec</span>
                            </div>
                            <p id="lockout-status">Try again in <strong id="minuteText">@(Model.MinutesRemaining > 0 ? $"{Model.MinutesRemaining} minute{(Model.MinutesRemaining == 1 ? "" : "s")}" : "less than a minute")</strong>.</p>
                        </div>
                    }
                    else
                    {
                        <div class="unlocked-notice" role="status">
                            <strong>Account unlocked</strong>
                            <span>Your lockout period has ended. You may sign in again.</span>
                        </div>
                    }

                    <div class="support-note">
                        <strong>Need help?</strong>
                        <span>If you believe this lockout was applied in error, please contact your system administrator.</span>
                    </div>

                    <a asp-page="./Login" class="cta">
                        <span aria-hidden="true">&larr;</span>
                        Back to login
                    </a>
                </div>
            </section>
        </div>
    </main>

    <script>
        const countdown = document.getElementById('countdown');
        const minutesEl = document.getElementById('minutes');
        const secondsEl = document.getElementById('seconds');
        const lockoutStatus = document.getElementById('lockout-status');
        const minuteText = document.getElementById('minuteText');
        let totalSeconds = (@Model.MinutesRemaining * 60) + @Model.SecondsRemaining;

        if (countdown && minutesEl && secondsEl && lockoutStatus && minuteText) {
            const updateCountdown = () => {
                if (totalSeconds <= 0) {
                    countdown.innerHTML = '<span class="countdown-unlocked">Unlocked</span>';
                    lockoutStatus.textContent = 'You may sign in again now.';
                    return false;
                }

                const minutes = Math.floor(totalSeconds / 60);
                const seconds = totalSeconds % 60;
                minutesEl.textContent = minutes;
                secondsEl.textContent = seconds.toString().padStart(2, '0');
                minuteText.textContent = minutes > 0 ? `${minutes} minute${minutes === 1 ? '' : 's'}` : 'less than a minute';
                return true;
            };

            const interval = setInterval(() => {
                totalSeconds--;
                if (!updateCountdown()) clearInterval(interval);
            }, 1000);
        }
    </script>
</body>
</html>