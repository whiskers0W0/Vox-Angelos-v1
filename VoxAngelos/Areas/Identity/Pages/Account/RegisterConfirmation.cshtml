@page
@model VoxAngelos.Areas.Identity.Pages.Account.RegisterConfirmationModel
@{
    ViewData["Title"] = "Registration Submitted";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registration Submitted | Vox Angelos</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/registerconfirmation.css" asp-append-version="true" />
</head>
<body>
    <div class="bg"></div>

    <main class="tech-wrapper confirmation-shell">
        <div class="row g-0">
            <section class="panel-left" aria-label="Registration introduction">
                <div class="portal-brand" aria-label="Vox Angelos">
                    <img src="~/assets/VoxAngelosLogo.png" alt="" />
                    <span><strong>Vox Angelos</strong><small>Unified Portal</small></span>
                </div>

                <span class="eyebrow">Registration received</span>
                <h1 class="title">Almost<br />there.</h1>
                <p class="tagline">Your application has been submitted and is now in the queue for admin review.</p>

                <ul class="portal-points" aria-label="What happens next">
                    <li><span aria-hidden="true">01</span> Application reviewed by admin</li>
                    <li><span aria-hidden="true">02</span> Approval email sent to your inbox</li>
                    <li><span aria-hidden="true">03</span> Sign in to your workspace</li>
                </ul>
            </section>

            <section class="panel-right" aria-labelledby="confirmationHeading">
                <a href="/" class="back-home-btn">
                    <span aria-hidden="true">&larr;</span> Back to Home Page
                </a>

                <div class="confirmation-form">
                    <span class="eyebrow eyebrow-chip">Application submitted</span>
                    <h2 id="confirmationHeading">Check your email</h2>
                    <p class="confirmation-intro">
                        Thank you for registering, <strong>@Model.Email</strong>.
                    </p>

                    <div class="status-alert">
                        <div class="status-alert-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M12 8v5"></path>
                                <circle cx="12" cy="16" r="0.5" fill="currentColor"></circle>
                            </svg>
                        </div>
                        <div class="status-alert-text">
                            <strong>Pending admin approval</strong>
                            <p>This process typically takes 1 to 3 business days. You'll receive an automated email once your credentials are verified.</p>
                        </div>
                    </div>

                    <p class="confirmation-note">Please check your inbox and spam folder for further instructions.</p>

                    <a href="/Identity/Account/Login" class="cta">
                        Go to login now
                        <span class="cta-arr" aria-hidden="true">&rarr;</span>
                    </a>

                    <p class="fine-print">
                        <strong>Authorized personnel tracking active.</strong> Your submission is logged in accordance with the Data Privacy Act of the Philippines.
                    </p>
                </div>
            </section>
        </div>
    </main>
</body>
</html>