@page
@model VoxAngelos.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password"; Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vox Angelos | Forgot Password</title>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="bg"></div>
    <div class="main-viewport d-flex align-items-center justify-content-center w-100">
        <div class="tech-wrapper">
            <div class="row g-0">
                <div class="col-lg-5 panel-left"><div class="glass-inner"><div class="portal-brand" aria-label="Vox Angelos"><img src="~/assets/VoxAngelosLogo.png" alt="" /><span><strong>Vox Angelos</strong><small>Access portal</small></span></div><span class="sys-label">Account recovery</span><h1 class="portal-title">Return to<br />your workspace.</h1><p class="login-instruction">Request a secure password-reset link for your verified account. We will never reveal whether an email is registered.</p></div></div>
                <div class="col-lg-7 panel-right"><section class="recovery-form-panel"><span class="eyebrow">Account recovery</span><h2>Reset your password</h2><p class="recovery-form-intro">Enter the email address associated with your account. If it is eligible, we will send password-reset instructions.</p><form method="post" autocomplete="off" novalidate>@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="d-none" id="validationSummary" role="alert"></div><div class="mb-4"><label asp-for="Input.Email" class="form-text-label">Email Address</label><input asp-for="Input.Email" class="form-control tech-input" placeholder="name@example.com" autocomplete="email" /><span asp-validation-for="Input.Email" class="text-danger"></span></div><div class="mb-4 pt-2"><button type="submit" class="cta">Send Reset Link</button></div><div class="d-flex justify-content-center align-items-center mt-4"><a href="/Identity/Account/Login" class="tech-link">Back to Login</a></div></form></section><div class="form-footer mt-5 pt-3"><p class="privacy-note">Protected by <strong>RA 10173</strong>. Your recovery data is handled in accordance with the Data Privacy Act.</p></div></div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
