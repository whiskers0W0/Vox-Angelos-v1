@page
@model LoginWith2faModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Two-factor authentication";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vox Angelos | OTP Verification</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/loginwith2fa.css" asp-append-version="true" />
</head>
<body>
    <div class="bg"></div>

    <main class="tech-wrapper two-factor-shell">
        <div class="row g-0">
            <section class="panel-left" aria-label="Citizen verification introduction">
                <div class="portal-brand" aria-label="Vox Angelos citizen portal">
                    <img src="~/assets/VoxAngelosLogo.png" alt="" />
                    <span><strong>Vox Angelos</strong><small>Citizen portal</small></span>
                </div>
                <span class="eyebrow">Secure verification</span>
                <h1 class="title">One more step<br />to your city.</h1>
                <p class="tagline">Confirm your identity to continue to your verified citizen workspace.</p>
                <ul class="portal-points" aria-label="Verification details">
                    <li><span aria-hidden="true">01</span> Check your email for the code</li>
                    <li><span aria-hidden="true">02</span> Enter the six-digit verification code</li>
                    <li><span aria-hidden="true">03</span> Access Vox Angelos</li>
                </ul>
            </section>

            <section class="panel-right" aria-labelledby="twoFactorHeading">
                <div class="two-factor-form">
                    <span class="eyebrow">Identity verification</span>
                    <h2 id="twoFactorHeading">Confirm your access</h2>
                    <p class="two-factor-intro">A 6-digit verification code has been sent to your email. Enter it below to authorize this session.</p>

                    <form method="post" asp-route-returnUrl="@Model.ReturnUrl" autocomplete="off">
                        <input asp-for="RememberMe" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="tech-validation-summary" role="alert"></div>

                        <div class="code-field">
                            <label asp-for="Input.TwoFactorCode" class="form-text-label">Verification code</label>
                            <input asp-for="Input.TwoFactorCode" class="form-control otp-input" autocomplete="off" maxlength="6" placeholder="------" inputmode="numeric" />
                            <span asp-validation-for="Input.TwoFactorCode" class="tech-validation"></span>
                        </div>

                        <button type="submit" class="cta">
                            Verify &amp; sign in
                            <span class="cta-arr" aria-hidden="true">→</span>
                        </button>
                    </form>
                </div>
            </section>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    @if (Configuration.GetValue<bool>("Email:ShowOtpInBrowser", true) && !string.IsNullOrEmpty(Model.GeneratedOtp))
    {
        <script>
            console.log("%c[DEV] Citizen login OTP:", "color:#39ff14;font-weight:bold;", @Json.Serialize(Model.GeneratedOtp));
        </script>
    }
</body>
</html>
