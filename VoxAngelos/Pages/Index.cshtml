@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vox Angelos</title>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&family=Syne+Mono&family=Barlow:wght@300;400&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/index.css?v=home-hero-fullbleed-v2" asp-append-version="true" />
</head>
<body>
    <main id="main-content">

    <!-- Main stage -->
    <div class="stage position-relative d-flex flex-column align-items-center justify-content-center text-center w-100" style="z-index:10">
    
        <!-- Background layers - now inside stage so they scroll -->
        <div class="bg" style="z-index:0"></div>
        <div class="bg-grid" style="z-index:1"></div>
        <div class="bg-vig" style="z-index:2"></div>

        <!-- Scanline -->
        <div class="scanline position-fixed" style="z-index:200"></div>

        <!-- Corner accents -->
        <div class="corner c-tl position-fixed" style="z-index:30"></div>
        <div class="corner c-tr position-fixed" style="z-index:30"></div>
        <div class="corner c-bl position-fixed" style="z-index:30"></div>
        <div class="corner c-br position-fixed" style="z-index:30"></div>
    
        <!-- Status bar -->
        <div class="status-bar d-flex align-items-center justify-content-center gap-2" style="z-index:30; position: absolute; top: 20px; left: 0; right: 0; width: 100%;">
            <div class="s-pip rounded-circle"></div>
            <div class="s-text">The Digital Heart Of Angeles City</div>
            <div class="s-pip rounded-circle"></div>
        </div>

        <!-- Submission-first hero: presentation-only, with no form, request, route, or persistence contract. -->
        <div class="home-submission-hero" id="heroModeSwitcher" data-mode="concern">
            <div class="hero-brand"><img src="~/assets/VoxAngelosLogo.png" alt="Vox Angelos" /></div>
            <div class="hero-copy"><span class="hero-kicker">A clearer path to civic action</span><h1 id="heroModeTitle">What concern needs attention?</h1></div>
            <div class="hero-mode-switcher" role="radiogroup" aria-label="Choose a submission type"><button type="button" class="hero-mode-button is-active" data-mode="concern" role="radio" aria-checked="true">Report a concern</button><button type="button" class="hero-mode-button" data-mode="recommendation" role="radio" aria-checked="false">Propose an idea</button></div>
            <div class="hero-composer" aria-live="polite">
                <div class="hero-composer-heading"><label for="heroModeMessage" id="heroModeLabel">Describe the concern</label><span class="hero-mode-badge" id="heroModeBadge">Concern report</span></div><textarea id="heroModeMessage" rows="3" autocomplete="off" placeholder="Example: The streetlight near our barangay hall has been out for several nights."></textarea><div class="hero-composer-footer"><span id="heroModeHelper">Keep it specific: include the issue, where it is happening, and who it affects.</span><span class="hero-composer-scope">Non-urgent matters only</span></div><div class="hero-composer-submit-row">
                <button id="heroModeSubmit" class="hero-submit-button" type="button" aria-label="Continue concern">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 2L11 13"></path>
                        <path d="M22 2L15 22L11 13L2 9L22 2Z"></path>
                    </svg>
                </button>
            </div>
        </div>
            <div class="hero-portal-container">
                <span class="portal-question">Already have an account?</span>
                <a asp-area="Identity" asp-page="/Account/Login" class="portal-action-btn">Enter Portal</a>
            </div>
        </div>
    
        <script>
                    (() => {
                        const root = document.getElementById('heroModeSwitcher');
                        if (!root) return;
                        const copy = { concern: { title: 'What concern needs attention?', label: 'Describe the concern', badge: 'Concern report', placeholder: 'Example: The streetlight near our barangay hall has been out for several nights.', helper: 'Keep it specific: include the issue, where it is happening, and who it affects.', submit: 'Continue concern' }, recommendation: { title: 'What improvement would you like to propose?', label: 'Share your recommendation', badge: 'Community recommendation', placeholder: 'Example: Add shaded seating and clear waste bins near the public market entrance.', helper: 'Share the improvement you propose, the location or service involved, and the people it may help.', submit: 'Continue recommendation' } };
                        const fields = { title: document.getElementById('heroModeTitle'), label: document.getElementById('heroModeLabel'), badge: document.getElementById('heroModeBadge'), input: document.getElementById('heroModeMessage'), helper: document.getElementById('heroModeHelper'), submit: document.getElementById('heroModeSubmit') };
                    root.querySelectorAll('.hero-mode-button').forEach(button => button.addEventListener('click', () => { const mode = button.dataset.mode; const content = copy[mode]; root.dataset.mode = mode; root.querySelectorAll('.hero-mode-button').forEach(item => { const selected = item === button; item.classList.toggle('is-active', selected); item.setAttribute('aria-checked', String(selected)); }); fields.title.textContent = content.title; fields.label.textContent = content.label; fields.badge.textContent = content.badge; fields.input.placeholder = content.placeholder; fields.helper.textContent = content.helper; fields.submit.setAttribute('aria-label', content.submit); }));
                        fields.input.addEventListener('keydown', event => { if (event.key === 'Enter' && !event.shiftKey) event.preventDefault(); });
                        fields.submit.addEventListener('click', () => {
                            const draft = {
                                mode: root.dataset.mode === 'recommendation' ? 'recommendation' : 'concern',
                                message: fields.input.value.trim()
                            };

                            try {
                                sessionStorage.setItem('voxAngelosLandingDraft', JSON.stringify(draft));
                            } catch {
                                // Continue securely even when the browser blocks session storage.
                            }

                            const isCitizenAuthenticated = @(User.Identity?.IsAuthenticated == true && User.IsInRole("User") ? "true" : "false");
                            if (isCitizenAuthenticated) {
                                window.location.href = '/User/Create?landingDraft=1';
                                return;
                            }

                            bootstrap.Modal.getOrCreateInstance(document.getElementById('heroContinueModal')).show();
                        });
                    })();
        </script>

    </div>

<div class="modal fade hero-continue-modal" id="heroContinueModal" tabindex="-1" aria-labelledby="heroContinueModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content hcm-content">
            <div class="modal-body hcm-body">
                <div class="hcm-logo">
                    <img src="~/assets/VoxAngelosLogo.png" alt="" />
                </div>
                <button type="button" class="btn-close hcm-close" data-bs-dismiss="modal" aria-label="Close"></button>

                <h5 class="hcm-title" id="heroContinueModalLabel">Continue securely with Vox Angelos</h5>
                <p class="hcm-lead mb-2">Sign in or create an account to complete your submission.</p>
                <p class="hcm-subtext text-muted small mb-0">Your selected submission type and message will remain in this browser while you continue.</p>
            </div>
            <div class="modal-footer hcm-footer">
                <div class="hcm-footer-right">
                    <a asp-area="Identity" asp-page="/Account/Register" asp-route-returnUrl="/User/Create?landingDraft=1" class="btn hcm-btn hcm-btn-outline">Create Citizen Account</a>
                    <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/User/Create?landingDraft=1" class="btn hcm-btn hcm-btn-primary">Sign In and Continue</a>
                </div>
            </div>
        </div>
    </div>
</div>

    <!-- Information Sections -->
    <section class="info-sections position-relative w-100" style="z-index:5">
        
        <!-- Overview Section with Sticky Card -->
        <div class="overview-section">
            <div class="container">
                <div class="row align-items-center g-4">
                    <div class="col-lg-6">
                        <h2 class="section-title">What is Vox Angelos?</h2>
                        <p class="section-text">
                            Vox Angelos is a web-based platform that connects residents with local government units (LGUs) through a centralized space for reporting and monitoring non-urgent community concerns. It enables citizens to share issues they observe while allowing LGU offices to organize, track, and prioritize reports for better decision-making and resource allocation. By streamlining communication and highlighting recurring local problems, the system promotes transparency, accountability, and active community participation, supporting more responsive and data-driven public service delivery.
                        </p>
                    </div>
                    <div class="col-lg-6">
                        <div class="feature-card">
                            <div class="feature-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                </svg>
                            </div>
                            <h3>Concern Reporting</h3>
                            <p>Submit and route community concerns directly to the appropriate LGU office.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Core Values Section -->
        <div class="values-section">
            <div class="container">
                <h2 class="section-title text-center mb-5">Core Values</h2>
                <div class="values-grid">
                    <div class="value-card">
                        <div class="value-icon">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"></path>
                            </svg>
                        </div>
                        <h3>Transparency</h3>
                        <p>Clear visibility on reported concerns and their progress.</p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M17 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2z"></path>
                            </svg>
                        </div>
                        <h3>Inclusivity</h3>
                        <p>An open platform where every community voice can be heard.</p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10zm0-2a8 8 0 100-16 8 8 0 000 16z"></path>
                            </svg>
                        </div>
                        <h3>Accountability</h3>
                        <p>Ensuring every concern is acknowledged and acted upon by the proper authorities.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Features Section with Sticky Layout -->
        <div class="features-section">
            <div class="container">
                <h2 class="section-title text-center mb-5">Platform Features</h2>
                <div class="features-grid">
                    <div class="feature-list-item">
                        <div class="feature-number">01</div>
                        <div class="feature-content">
                            <h3>Submit Concerns</h3>
                            <p>Send non-urgent community concerns directly to the appropriate LGU office.</p>
                        </div>
                    </div>
                    <div class="feature-list-item">
                        <div class="feature-number">02</div>
                        <div class="feature-content">
                            <h3>Smart Categorization</h3>
                            <p>Automatically organize submissions by sector (health, safety, infrastructure, etc.) for efficient handling.</p>
                        </div>
                    </div>
                    <div class="feature-list-item">
                        <div class="feature-number">03</div>
                        <div class="feature-content">
                            <h3>Submit Ideas or Recommendations</h3>
                            <p>Share citizen recommendations on improvements you want to see from the government.</p>
                        </div>
                    </div>
                    <div class="feature-list-item">
                        <div class="feature-number">04</div>
                        <div class="feature-content">
                            <h3>Status Tracking</h3>
                            <p>Monitor the progress and updates of your submitted recommendations.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </section>

    </main>

    <!-- Copyright and Footer -->
    <footer class="footer-section">
        <div class="container">
            <div class="footer-content">
                <div class="footer-about">
                    <h3 class="footer-title">Vox Angelos</h3>
                    <p class="footer-description">Empowering communities through citizen-driven reporting and recommendations.</p>
                </div>
                <div class="footer-links">
                    <a href="#" class="footer-link" data-bs-toggle="modal" data-bs-target="#privacyModal">Privacy Policy</a>
                </div>
            </div>
            <div class="footer-divider"></div>
            <div class="copyright text-center">
                &copy; 2026 Vox Angelos &nbsp;·&nbsp; All Rights Reserved.
            </div>
        </div>
    </footer>

    <!-- Privacy Policy Modal -->
    <div class="modal fade" id="privacyModal" tabindex="-1" aria-labelledby="privacyModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="privacyModalLabel">Privacy Policy & Data Protection</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="privacy-content">
                        <h6>Republic Act No. 10173: Data Privacy Act of 2012</h6>
                        
                        <h6 class="mt-4">1. Data Collection & Purpose</h6>
                        <p>
                            Vox Angelos collects personal information to enable citizen reporting and community engagement with local government units (LGUs).
                            This includes:
                        </p>
                        <ul>
                            <li>Government-issued identification (ID) information</li>
                            <li>Facial image capture for identity verification and face matching</li>
                            <li>Optical Character Recognition (OCR) extracted data from submitted IDs</li>
                            <li>Contact information for concern tracking and updates</li>
                        </ul>

                        <h6 class="mt-4">2. Legal Basis</h6>
                        <p>
                            Data processing is conducted in compliance with the <strong>Republic Act No. 10173 (Data Privacy Act of 2012)</strong>.
                            The collection of Personal Identification Information (PII) is necessary for:
                        </p>
                        <ul>
                            <li>Citizen verification and authentication</li>
                            <li>Prevention of fraudulent reporting</li>
                            <li>Accurate tracking and follow-up of community concerns</li>
                            <li>Compliance with government data retention requirements</li>
                        </ul>

                        <h6 class="mt-4">3. Data Security Measures</h6>
                        <p>
                            Vox Angelos implements industry-standard security measures to protect your personal data:
                        </p>
                        <ul>
                            <li>Encrypted data transmission (SSL/TLS)</li>
                            <li>Secure storage with restricted access</li>
                            <li>Regular security audits and assessments</li>
                            <li>Access controls and authentication requirements</li>
                        </ul>

                        <h6 class="mt-4">4. Data Retention</h6>
                        <p>
                            Personal data is retained only as long as necessary to fulfill the purposes outlined above,
                            and in compliance with government record-keeping requirements. Facial images and extracted ID data
                            are securely deleted after verification is complete unless extended retention is legally required.
                        </p>

                        <h6 class="mt-4">5. Your Rights</h6>
                        <p>Under the Data Privacy Act of 2012, you have the right to:</p>
                        <ul>
                            <li>Access your personal data</li>
                            <li>Correct inaccurate information</li>
                            <li>Request deletion of data (subject to legal obligations)</li>
                            <li>Lodge complaints with the National Privacy Commission (NPC)</li>
                            <li>Withdraw consent (where applicable)</li>
                        </ul>

                        <h6 class="mt-4">6. Third-Party Sharing</h6>
                        <p>
                            Your personal data is shared only with authorized LGU offices and agencies necessary to process and address your reported concerns.
                            Data is not sold or shared with unrelated third parties for commercial purposes.
                        </p>

                        <h6 class="mt-4">7. Contact & Complaints</h6>
                        <p>
                            For privacy concerns or to exercise your rights under the Data Privacy Act, please contact:
                        </p>
                        <ul>
                            <li><strong>National Privacy Commission (NPC):</strong> www.privacy.gov.ph</li>
                            <li><strong>NPC Hotline:</strong> (02) 8926-7275</li>
                        </ul>

                        <p class="mt-4 text-muted small">
                            <em>
                                This privacy policy is effective as of 2026 and may be updated periodically.
                                Users will be notified of significant changes through the platform.
                            </em>
                        </p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Floating CTA Tab -->
    <div class="floating-cta" id="floatingCta">
        <div class="cta-pill d-flex align-items-center">
        
            <div class="pill-logo-wrap">
                <div class="pill-logo-inner">
                    <div class="p-ring p-ring-1"></div>
                    <div class="p-ring p-ring-2"></div>
                    <div class="p-ring p-ring-3"></div>
                
                    <img src="~/assets/VoxAngelosLogo.png" alt="Logo" class="pill-img" />
                </div>
            </div>
        
            <span class="pill-title ms-2">Vox Angelos</span>
        
            <a asp-area="Identity" asp-page="/Account/Login" class="pill-btn d-flex align-items-center">
                <span>Enter Portal</span>
                <svg class="ms-2" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
            </a>
        </div>
    </div>


    <script>
            document.addEventListener('DOMContentLoaded', function() {
                const floatingCta = document.getElementById('floatingCta');
                const heroSection = document.querySelector('.stage');

                if (floatingCta) {
                    // Force-hide on load regardless of CSS defaults
                    floatingCta.style.opacity = '0';
                    floatingCta.style.visibility = 'hidden';
                    floatingCta.style.pointerEvents = 'none';
                }

                if (heroSection && floatingCta) {
                    const observer = new IntersectionObserver(function(entries) {
                        entries.forEach(entry => {
                            if (!entry.isIntersecting) {
                                floatingCta.classList.add('show');
                                floatingCta.style.opacity = '1';
                                floatingCta.style.visibility = 'visible';
                                floatingCta.style.pointerEvents = 'auto';
                            } else {
                                floatingCta.classList.remove('show');
                                floatingCta.style.opacity = '0';
                                floatingCta.style.visibility = 'hidden';
                                floatingCta.style.pointerEvents = 'none';
                            }
                        });
                    }, {
                        threshold: 0
                    });

                    observer.observe(heroSection);
                }

                // Smooth scroll behavior for better UX
                document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                    anchor.addEventListener('click', function (e) {
                        e.preventDefault();
                        const target = document.querySelector(this.getAttribute('href'));
                        if (target) {
                            target.scrollIntoView({
                                behavior: 'smooth',
                                block: 'start'
                            });
                        }
                    });
                });
            });
    </script>

    <!-- Bootstrap 5 JS bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <link rel="stylesheet" href="https://www.gstatic.com/dialogflow-console/fast/df-messenger/prod/v1/themes/df-messenger-default.css">
