@page
@model VoxAngelos.Pages.Admin.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dashboard-widgets.css" asp-append-version="true" />
}

<div class="admin-dashboard">
    <header class="admin-page-header">
        <div>
            <span class="admin-page-eyebrow">Angeles City · Administrative console</span>
            <h1>Administrative overview</h1>
            <p>Monitor citizen account intake, office access, identity-verification health, and submissions awaiting manual routing.</p>
        </div>
        <a class="admin-primary-action" asp-page="/Admin/UserApplications" asp-route-filterStatus="Pending">
            Review pending applications
            <span>@Model.UnverifiedAccounts</span>
        </a>
    </header>

    <section class="admin-summary-grid admin-summary-grid--two" aria-label="Account intake summary">
        <article class="admin-summary-card admin-summary-card--attention">
            <span class="admin-summary-label">Applications awaiting review</span>
            <strong>@Model.UnverifiedAccounts</strong>
            <p>Citizen accounts pending approval</p>
        </article>
        <article class="admin-summary-card admin-summary-card--success">
            <span class="admin-summary-label">Verified citizen accounts</span>
            <strong>@Model.VerifiedAccounts</strong>
            <p>Approved and active in the platform</p>
        </article>
    </section>

    <section class="admin-dashboard-section" aria-labelledby="applicationsHeading">
        <div class="admin-section-heading">
            <div>
                <span>Priority queue</span>
                <h2 id="applicationsHeading">Applications needing attention</h2>
            </div>
            <a asp-page="/Admin/UserApplications" asp-route-filterStatus="Pending">View all pending applications</a>
        </div>
        <div class="admin-dashboard-grid admin-dashboard-grid--two">
            <article class="admin-panel">
                <header class="admin-panel-header"><h3>Oldest pending applications</h3><span>Queue</span></header>
                @if (Model.OldestPending.Count == 0)
                {
                    <p class="admin-empty-state">No pending applications right now.</p>
                }
                else
                {
                    <div class="admin-table-wrap">
                        <table class="admin-data-table">
                            <thead><tr><th scope="col">Applicant</th><th scope="col">Waiting</th><th scope="col"><span class="visually-hidden">Action</span></th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.OldestPending)
                                {
                                    <tr>
                                        <td><strong>@item.Label</strong><small>@item.SubLabel</small></td>
                                        <td>@item.DaysAgo day(s)</td>
                                        <td><a class="admin-table-action" asp-page="/Admin/UserApplications" asp-route-filterStatus="Pending">Review</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </article>

            <article class="admin-panel">
                <header class="admin-panel-header"><h3>Face verification summary</h3><span>Verification</span></header>
                <div class="admin-health">
                    <div class="@(Model.LowFaceMatchCount > 0 ? "text-danger" : "")">
                        <strong class="admin-health-value">@Model.FaceMatchAttentionCount need attention</strong>
                        <p>@Model.FaceMatchFailureRate.ToString("0.0")% of recorded checks scored below the 50% threshold.</p>
                    </div>
                    <div class="admin-health-meta">
                        <strong>@Model.TotalFaceChecks recorded</strong>
                        <span>@Model.PassedFaceMatchCount passed</span>
                        <span>@Model.LowFaceMatchCount below threshold</span>
                        <span>@Model.MissingFaceMatchCount not recorded</span>
                    </div>
                </div>
                @if (Model.LowFaceMatchCount > 0 || Model.MissingFaceMatchCount > 0)
                {
                    <a class="admin-warning admin-warning--action"
                       asp-page="/Admin/UserApplications"
                       asp-route-faceMatchFilter="Attention">
                        Review low or missing face checks <span aria-hidden="true">→</span>
                    </a>
                }
            </article>
        </div>
        <article class="admin-panel admin-panel--wide">
            <header class="admin-panel-header"><h3>Application intake · last 14 days</h3><span>Trend</span></header>
            <div class="admin-chart-wrap"><canvas id="applicationsTrendChart" height="80"></canvas></div>
        </article>
    </section>

    <section class="admin-dashboard-section" aria-labelledby="officesHeading">
        <div class="admin-section-heading">
            <div><span>Office management</span><h2 id="officesHeading">LGU office readiness</h2></div>
            <a asp-page="/Admin/OfficeManagement">Manage office accounts</a>
        </div>
        <div class="admin-dashboard-grid admin-dashboard-grid--spaced">
            <article class="admin-panel admin-panel--wide">
                <header class="admin-panel-header"><h3>Office status</h3><span>One account per office</span></header>
                @if (Model.AccountsByDepartment.Count == 0)
                {
                    <p class="admin-empty-state">No LGU accounts yet.</p>
                }
                else
                {
                    <div class="admin-table-wrap"><table class="admin-data-table"><thead><tr><th scope="col">Office</th><th scope="col">Account</th><th scope="col">Routing setup</th></tr></thead><tbody>
                    @foreach (var dept in Model.AccountsByDepartment)
                    {
                        <tr>
                            <td><strong>@dept.Department</strong><small>@dept.DepartmentFullName</small></td>
                            <td><strong class="@(dept.Active > 0 ? "text-success" : "text-danger")">@(dept.Active > 0 ? "Enabled" : "Disabled")</strong></td>
                            <td>
                                @if (dept.RoutingReady)
                                {
                                    <strong class="text-success">Ready</strong><small>@dept.CategoryCount categories · @dept.KeywordCount keywords</small>
                                }
                                else
                                {
                                    <strong class="text-danger">Needs configuration</strong>
                                    <small>@(dept.Active == 0 ? "Enable the office account" : dept.CategoryCount == 0 && dept.KeywordCount == 0 ? "Add categories and keywords" : dept.CategoryCount == 0 ? "Add routing categories" : "Add NLP keywords")</small>
                                }
                            </td>
                        </tr>
                    }
                    </tbody></table></div>
                }
            </article>
        </div>
    </section>

    <section class="admin-dashboard-section" aria-labelledby="routingHeading">
        <div class="admin-section-heading">
            <div><span>Manual routing</span><h2 id="routingHeading">Unassigned submissions</h2></div>
            <a asp-page="/Admin/NlpAccuracy">Open routing queue</a>
        </div>
        @if (Model.AdminTriageEnabled)
        {
            <div class="admin-kpi-grid admin-kpi-grid--four" aria-label="Admin routing queue summary">
                <article class="admin-kpi"><strong class="@(Model.TotalAwaitingRouting > 0 ? "text-danger" : "text-success")">@Model.TotalAwaitingRouting</strong><span>Total waiting for office assignment</span></article>
                <article class="admin-kpi"><strong>@Model.UncategorizedConcernCount</strong><span>Unassigned concerns</span></article>
                <article class="admin-kpi"><strong>@Model.UncategorizedRecommendationCount</strong><span>Unassigned recommendations</span></article>
                <article class="admin-kpi"><strong>@Model.OldestRoutingAge</strong><span>@(Model.OldestUncategorizedSubmittedAt.HasValue ? $"Oldest item · submitted {Model.OldestUncategorizedSubmittedAt:MMM dd, yyyy}" : "No submissions currently waiting")</span></article>
            </div>
            <div class="admin-kpi-grid admin-routing-extremes admin-dashboard-grid--spaced" aria-label="Manual assignment distribution">
                <article class="admin-kpi">
                    <span class="admin-summary-label">Most assigned department</span>
                    <strong>@(Model.MostAdminRoutedDepartment?.Department ?? "—")</strong>
                    <span>@(Model.MostAdminRoutedDepartment == null
                        ? "No Admin assignments recorded yet"
                        : $"Most assigned · {Model.MostAdminRoutedDepartment.Total} total ({Model.MostAdminRoutedDepartment.Concerns} concerns, {Model.MostAdminRoutedDepartment.Recommendations} recommendations)")</span>
                </article>
                <article class="admin-kpi">
                    <span class="admin-summary-label">Least assigned department</span>
                    <strong>@(Model.LeastAdminRoutedDepartment?.Department ?? "—")</strong>
                    <span>@(Model.LeastAdminRoutedDepartment == null
                        ? "No Admin assignments recorded yet"
                        : Model.AdminRoutedDepartmentCount == 1
                            ? $"Only assigned department · {Model.LeastAdminRoutedDepartment.Total} total"
                            : $"Least assigned · {Model.LeastAdminRoutedDepartment.Total} total ({Model.LeastAdminRoutedDepartment.Concerns} concerns, {Model.LeastAdminRoutedDepartment.Recommendations} recommendations)")</span>
                </article>
            </div>
        }
        else
        {
            <article class="admin-panel admin-panel--wide">
                <p class="admin-empty-state">Admin routing is not enabled in this environment.</p>
            </article>
        }
    </section>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const ctx = document.getElementById("applicationsTrendChart");
        if (!ctx) return;
        if (typeof Chart === "undefined") {
            const fallback = document.createElement("p");
            fallback.className = "admin-empty-state";
            fallback.textContent = "Application intake trend is unavailable in this environment.";
            ctx.replaceWith(fallback);
            return;
        }

        const labels = @Html.Raw(Json.Serialize(Model.ApplicationsLast14Days.Select(d => d.Date.ToString("MMM d"))));
        const data = @Html.Raw(Json.Serialize(Model.ApplicationsLast14Days.Select(d => d.Count)));

        new Chart(ctx, {
            type: "line",
            data: { labels: labels, datasets: [{ label: "Applications submitted", data: data, borderColor: "#1646a0", backgroundColor: "rgba(22, 70, 160, 0.08)", tension: 0.3, fill: true, pointRadius: 3 }] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } }, x: { grid: { display: false } } } }
        });
    });
</script>
