@page
@model VoxAngelos.Pages.Admin.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dashboard-widgets.css" asp-append-version="true" />
}

<div class="admin-dashboard">
    <header class="admin-page-header">
        <div>
            <span class="admin-page-eyebrow">Angeles City · Administrative console</span>
            <h1>Administrative overview</h1>
            <p>Monitor citizen account intake, office access, identity-verification health, and classification quality from one controlled workspace.</p>
        </div>
        <a class="admin-primary-action" asp-page="/Admin/UserApplications" asp-route-filterStatus="Pending">
            Review pending applications
            <span>@Model.UnverifiedAccounts</span>
        </a>
    </header>

    <section class="admin-summary-grid admin-summary-grid--two" aria-label="Account intake summary">
        <article class="admin-summary-card admin-summary-card--attention">
            <span class="admin-summary-label">Applications awaiting review</span>
            <strong>@Model.UnverifiedAccounts</strong>
            <p>Citizen accounts pending approval</p>
        </article>
        <article class="admin-summary-card admin-summary-card--success">
            <span class="admin-summary-label">Verified citizen accounts</span>
            <strong>@Model.VerifiedAccounts</strong>
            <p>Approved and active in the platform</p>
        </article>
    </section>

    <section class="admin-dashboard-section" aria-labelledby="applicationsHeading">
        <div class="admin-section-heading">
            <div>
                <span>Priority queue</span>
                <h2 id="applicationsHeading">Applications needing attention</h2>
            </div>
            <a asp-page="/Admin/UserApplications" asp-route-filterStatus="Pending">View all pending applications</a>
        </div>
        <div class="admin-dashboard-grid admin-dashboard-grid--two">
            <article class="admin-panel">
                <header class="admin-panel-header"><h3>Oldest pending applications</h3><span>Queue</span></header>
                @if (Model.OldestPending.Count == 0)
                {
                    <p class="admin-empty-state">No pending applications right now.</p>
                }
                else
                {
                    <div class="admin-table-wrap">
                        <table class="admin-data-table">
                            <thead><tr><th scope="col">Applicant</th><th scope="col">Waiting</th><th scope="col"><span class="visually-hidden">Action</span></th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.OldestPending)
                                {
                                    <tr>
                                        <td><strong>@item.Label</strong><small>@item.SubLabel</small></td>
                                        <td>@item.DaysAgo day(s)</td>
                                        <td><a class="admin-table-action" asp-page="/Admin/UserApplications" asp-route-filterStatus="Pending">Review</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </article>

            <article class="admin-panel">
                <header class="admin-panel-header"><h3>Face-match health</h3><span>Verification</span></header>
                <div class="admin-health">
                    <div class="@(Model.FaceMatchFailureRate > 20 ? "text-danger" : "")">
                        <strong class="admin-health-value">@Model.FaceMatchFailureRate.ToString("0.0")%</strong>
                        <p>Failure rate for checks below the 50% confidence threshold.</p>
                    </div>
                    <div class="admin-health-meta">@Model.LowFaceMatchCount of @Model.TotalFaceChecks checks are below threshold.</div>
                </div>
                @if (Model.FaceMatchFailureRate > 20 && Model.TotalFaceChecks > 0)
                {
                    <p class="admin-warning">Failure rate is elevated. Review identity-verification service health.</p>
                }
            </article>
        </div>
        <article class="admin-panel admin-panel--wide">
            <header class="admin-panel-header"><h3>Application intake · last 14 days</h3><span>Trend</span></header>
            <div class="admin-chart-wrap"><canvas id="applicationsTrendChart" height="80"></canvas></div>
        </article>
    </section>

    <section class="admin-dashboard-section" aria-labelledby="officesHeading">
        <div class="admin-section-heading">
            <div><span>Office access</span><h2 id="officesHeading">LGU account operations</h2></div>
            <a asp-page="/Admin/OfficeManagement">Manage office accounts</a>
        </div>
        <div class="admin-kpi-grid" aria-label="LGU account summary">
            <article class="admin-kpi"><strong>@Model.TotalLguAccounts</strong><span>Total LGU accounts</span></article>
            <article class="admin-kpi"><strong class="text-success">@Model.ActiveLguAccounts</strong><span>Active accounts</span></article>
            <article class="admin-kpi"><strong class="text-danger">@Model.DisabledLguAccounts</strong><span>Disabled accounts</span></article>
        </div>
        <div class="admin-dashboard-grid admin-dashboard-grid--two admin-dashboard-grid--spaced">
            <article class="admin-panel">
                <header class="admin-panel-header"><h3>Accounts by department</h3><span>Coverage</span></header>
                @if (Model.AccountsByDepartment.Count == 0)
                {
                    <p class="admin-empty-state">No LGU accounts yet.</p>
                }
                else
                {
                    <div class="admin-table-wrap"><table class="admin-data-table"><thead><tr><th scope="col">Department</th><th scope="col">Total</th><th scope="col">Active</th><th scope="col">Disabled</th></tr></thead><tbody>
                    @foreach (var dept in Model.AccountsByDepartment)
                    {
                        <tr><td><strong>@dept.Department</strong></td><td>@dept.Total</td><td class="text-success">@dept.Active</td><td class="text-danger">@dept.Disabled</td></tr>
                    }
                    </tbody></table></div>
                }
            </article>
            <article class="admin-panel">
                <header class="admin-panel-header"><h3>Recently created accounts</h3><span>Latest</span></header>
                @if (Model.RecentLguAccounts.Count == 0)
                {
                    <p class="admin-empty-state">No accounts created yet.</p>
                }
                else
                {
                    <div class="admin-table-wrap"><table class="admin-data-table"><thead><tr><th scope="col">Department</th><th scope="col">Employee ID</th><th scope="col">Created</th></tr></thead><tbody>
                    @foreach (var acct in Model.RecentLguAccounts)
                    {
                        <tr><td><strong>@acct.Label</strong></td><td>@acct.SubLabel</td><td>@acct.Timestamp.ToString("MM/dd/yyyy")</td></tr>
                    }
                    </tbody></table></div>
                }
            </article>
        </div>
    </section>

    <section class="admin-dashboard-section" aria-labelledby="nlpHeading">
        <div class="admin-section-heading">
            <div><span>Classification quality</span><h2 id="nlpHeading">NLP performance</h2></div>
            <a asp-page="/Admin/NlpAccuracy">Open NLP accuracy review</a>
        </div>
        <div class="admin-kpi-grid" aria-label="NLP performance summary">
            <article class="admin-kpi"><strong class="@(Model.NlpThresholdMet ? "text-success" : "text-danger")">@Model.NlpAccuracyPercent.ToString("0.0")%</strong><span>Overall accuracy@(Model.NlpTotalReviewed > 0 ? " · target 75%" : "")</span></article>
            <article class="admin-kpi"><strong>@(Model.WorstDepartment ?? "—")</strong><span>Weakest department@(Model.WorstDepartment != null ? $" · {Model.WorstDepartmentAccuracy:0.0}% accurate" : "")</span></article>
            <article class="admin-kpi"><strong class="@(Model.RecentMisclassificationCount > 0 ? "text-danger" : "")">@Model.RecentMisclassificationCount</strong><span>Misclassified in the last 7 days</span></article>
        </div>
        @if (Model.NlpTotalReviewed == 0)
        {
            <p class="admin-empty-state admin-empty-state--inline">No classification feedback is logged yet. These quality indicators will populate once LGU staff confirm or reassign concern categories.</p>
        }
    </section>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const ctx = document.getElementById("applicationsTrendChart");
        if (!ctx) return;
        if (typeof Chart === "undefined") {
            const fallback = document.createElement("p");
            fallback.className = "admin-empty-state";
            fallback.textContent = "Application intake trend is unavailable in this environment.";
            ctx.replaceWith(fallback);
            return;
        }

        const labels = @Html.Raw(Json.Serialize(Model.ApplicationsLast14Days.Select(d => d.Date.ToString("MMM d"))));
        const data = @Html.Raw(Json.Serialize(Model.ApplicationsLast14Days.Select(d => d.Count)));

        new Chart(ctx, {
            type: "line",
            data: { labels: labels, datasets: [{ label: "Applications submitted", data: data, borderColor: "#1646a0", backgroundColor: "rgba(22, 70, 160, 0.08)", tension: 0.3, fill: true, pointRadius: 3 }] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } }, x: { grid: { display: false } } } }
        });
    });
</script>
