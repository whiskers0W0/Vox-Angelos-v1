@page
@model VoxAngelos.Pages.Admin.ReviewApplicationModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Review Applications"; var citizen = Model.Citizen; var profile = Model.Profile; var doc = Model.IdentityDocument; var face = Model.FaceVerification; var ocr = Model.OcrVerification; var status = citizen?.ApprovalStatus ?? "Pending"; var faceConfidence = face?.MatchConfidence ?? 0; var faceClass = faceConfidence >= 0.6m ? "high" : "low"; var faceWidth = (faceConfidence * 100).ToString("F0"); var facePercent = (faceConfidence * 100).ToString("F1"); var ocrConfidence = ocr?.OcrConfidence ?? 0; var cityProvinceMatched = ocr?.CityProvinceMatched ?? false; var ocrClass = cityProvinceMatched ? "high" : "low"; var ocrWidth = (ocrConfidence * 100).ToString("F0"); var ocrPercent = (ocrConfidence * 100).ToString("F1"); var detectedLocality = ocr?.DetectedLocality ?? "Not detected"; var age = VoxAngelos.Pages.Admin.ReviewApplicationModel.ComputeAge(profile?.BirthDate); }
@section Styles { <link rel="stylesheet" href="~/css/admin-reviewapplication.css" asp-append-version="true" /> }
<div class="admin-review-application">
    <header class="review-header"><div><span class="review-eyebrow">Verification queue · citizen application</span><h1>Review citizen application</h1><p class="review-meta">Applied @citizen?.CreatedAt.ToString("MMMM dd, yyyy") <span aria-hidden="true">·</span> User ID @citizen?.Id.Substring(0, 8).ToUpper()</p></div>@if (status != "Approved") { <div class="review-header-actions"><span class="status-badge status-@status.ToLower()">@status</span><a href="/Admin/UserApplications" class="review-back-link">Back to applications</a></div> }</header>
    @if (Model.IsDevelopmentMock) { <div class="review-dev-mock-notice" role="status">Development mock application — actions are display-only and will not update an account or send email.</div> }
    <div class="review-grid"><section class="review-left" aria-label="Applicant details"><article class="review-card"><header class="review-card-header"><span>Applicant profile</span><h2>Account information</h2></header><div class="info-row"><span class="info-label">Full name</span><span class="info-value">@(profile != null ? $"{profile.FirstName} {profile.MiddleName} {profile.LastName}".Trim() : "N/A")</span></div><div class="info-row"><span class="info-label">Email address</span><span class="info-value">@citizen?.Email</span></div><div class="info-row"><span class="info-label">Contact number</span><span class="info-value">@(citizen?.PhoneNumber ?? "N/A")</span></div></article>
        <article class="review-card"><header class="review-card-header"><span>Document extraction</span><h2>ID information</h2></header><div class="info-row"><span class="info-label">ID type</span><span class="info-value">@(doc?.IdType ?? "N/A")</span></div><div class="info-row"><span class="info-label">Birth date</span><span class="info-value">@(ocr?.DetectedBirthDate ?? "Not extracted yet")</span></div><div class="info-row"><span class="info-label">Age</span><span class="info-value">@(age?.ToString() ?? "Not available")</span></div><div class="info-row"><span class="info-label">Card expiration date</span><span class="info-value">@(doc?.CardExpirationDate?.ToString("MMMM dd, yyyy") ?? ocr?.DetectedCardExpirationDate ?? "Not extracted yet")</span></div><div class="info-row"><span class="info-label">Lot No. / Street address</span><span class="info-value">@(ocr?.DetectedStreetAddress ?? "Not extracted yet")</span></div><div class="info-row"><span class="info-label">Detected barangay</span><span class="info-value">@(ocr?.DetectedLocality ?? "Not extracted yet")</span></div><div class="info-row"><span class="info-label">Detected province</span><span class="info-value">@(ocr?.DetectedProvince ?? "Not extracted yet")</span></div></article></section>
        <section class="review-right" aria-label="Identity verification and decision"><article class="review-card"><header class="review-card-header"><span>Private verification media</span><h2>Identity evidence</h2></header><div class="photos-grid"><div class="photo-box"><p class="photo-label">Government ID</p>@if (doc?.IdPhotoPath != null) { <img src="/Admin/ReviewApplication?handler=IdentityMedia&documentId=@doc.Id&mediaType=id" class="review-photo" onclick="openModal(this.src)" title="Click to enlarge" alt="Applicant identity document" /> } else { <div class="photo-placeholder">No photo</div> }</div><div class="photo-box"><p class="photo-label">Live selfie</p>@if (face?.LiveSelfiePath != null) { <img src="/Admin/ReviewApplication?handler=IdentityMedia&documentId=@doc?.Id&mediaType=selfie" class="review-photo" onclick="openModal(this.src)" title="Click to enlarge" alt="Applicant live selfie" /> } else { <div class="photo-placeholder">No selfie</div> }</div></div>
        <div class="verification-metrics"><div class="confidence-bar-container"><div class="confidence-heading"><p class="photo-label">Face match confidence</p><span class="confidence-value @faceClass">@facePercent%</span></div><div class="confidence-bar"><div class="confidence-fill @faceClass" style="width:@faceWidth%"></div></div><p class="confidence-note @faceClass">@(faceConfidence >= 0.6m ? "✓ Match" : "✗ No Match")</p></div><div class="confidence-bar-container"><div class="confidence-heading"><p class="photo-label">Angeles City, Pampanga residency match</p><span class="confidence-value @ocrClass">@ocrPercent%</span></div><div class="confidence-bar"><div class="confidence-fill @ocrClass" style="width:@ocrWidth%"></div></div><p class="confidence-note @ocrClass">@(cityProvinceMatched ? "✓ Verified — Angeles City, Pampanga detected on ID" : "✗ Not verified — Angeles City, Pampanga not detected on ID")</p><p class="confidence-note">Detected barangay: @detectedLocality</p></div></div></article>
        @if (status == "Pending") { <section class="review-decision" aria-label="Application decision"><div><span>Final review</span><h2>Record a decision</h2><p>Approval or rejection sends the applicant an email and returns you to the verification queue.</p></div><div class="action-buttons"><a href="/Admin/UserApplications" class="btn-cancel">Cancel</a><button type="button" onclick="showRejectModal()" class="btn-reject">Reject application</button><button type="button" onclick="showApproveModal()" class="btn-approve">Verify citizen</button></div></section> } else { <section class="review-decision review-decision--complete"><a href="/Admin/UserApplications" class="btn-cancel">Back to applications</a>@if (status == "Approved") { <p class="status-message approved">This user has been verified.</p> } else { <p class="status-message rejected">This user has been rejected.</p> }</section> }</section></div>
</div>
<div id="approveModal" class="modal-overlay"><div class="modal-box"><span class="modal-eyebrow">Confirmation required</span><h3>Verify citizen?</h3><p>This will mark the account as approved and notify the applicant by email.</p><div class="modal-actions"><button type="button" onclick="closeModals()" class="btn-cancel">Cancel</button><form method="post" asp-page-handler="Approve"><input type="hidden" name="userId" value="@citizen?.Id" />@Html.AntiForgeryToken()<button type="submit" class="btn-approve">Confirm verification</button></form></div></div></div>
<div id="rejectModal" class="modal-overlay"><div class="modal-box"><span class="modal-eyebrow modal-eyebrow--danger">Confirmation required</span><h3>Reject citizen?</h3><p>@(Model.IsDevelopmentMock ? "This is a Development mock. Confirming will not change an account or send email." : "This will mark the account as rejected and notify the applicant by email.")</p><div class="modal-actions"><button type="button" onclick="closeModals()" class="btn-cancel">Cancel</button><form method="post" asp-page-handler="Reject"><input type="hidden" name="userId" value="@citizen?.Id" /><input type="hidden" name="rejectionReason" value="Does not meet verification requirements." />@Html.AntiForgeryToken()<button type="submit" class="btn-reject">Confirm rejection</button></form></div></div></div>
<div id="imageModal" class="modal-overlay image-modal-overlay" onclick="closeModals()"><div class="image-modal-box" onclick="event.stopPropagation()"><button type="button" onclick="closeModals()" aria-label="Close image preview">×</button><img id="modalImage" src="" alt="Identity verification preview" /></div></div>
<script>
function showApproveModal() { document.getElementById('approveModal').style.display = 'flex'; }
function showRejectModal() { document.getElementById('rejectModal').style.display = 'flex'; }
function closeModals() { document.getElementById('approveModal').style.display = 'none'; document.getElementById('rejectModal').style.display = 'none'; document.getElementById('imageModal').style.display = 'none'; }
function openModal(src) { document.getElementById('modalImage').src = src; document.getElementById('imageModal').style.display = 'flex'; }
</script>