@page
@model VoxAngelos.Pages.Admin.NlpAccuracyModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "NLP Performance";
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-nlpaccuracy.css" asp-append-version="true" />
}

<div class="admin-nlp-workspace">
    <header class="admin-nlp-header">
        <div>
            <span class="admin-nlp-eyebrow">Classification quality control</span>
            <h1>NLP Performance</h1>
            <p>Review classification outcomes and route submissions the model could not assign to an LGU department.</p>
        </div>
    </header>

    @if (TempData["RoutingSuccess"] is string successMessage)
    {
        <div class="admin-action-toast admin-action-toast--success" role="status" aria-live="polite">
            <span>@successMessage</span>
            <div class="admin-action-toast-progress" aria-hidden="true"></div>
        </div>
    }
    @if (TempData["RoutingError"] is string errorMessage)
    {
        <div class="admin-action-toast admin-action-toast--error" role="alert" aria-live="assertive">
            <span>@errorMessage</span>
            <div class="admin-action-toast-progress" aria-hidden="true"></div>
        </div>
    }

    <section class="admin-nlp-panel" aria-labelledby="departmentAccuracyHeading">
        <header class="admin-nlp-panel-header">
            <div>
                <span>Department performance</span>
                <h2 id="departmentAccuracyHeading">Accuracy by department</h2>
            </div>
            <p>Reviewed classifications, grouped by the final assigned category.</p>
        </header>
        <div class="admin-nlp-table-wrap">
            <table class="admin-nlp-table">
                <thead><tr><th scope="col">Department</th><th scope="col">Reviewed</th><th scope="col">Correct</th><th scope="col">Accuracy</th></tr></thead>
                <tbody>
                    @if (!Model.ByDepartment.Any())
                    {
                        <tr><td colspan="4" class="admin-nlp-empty">No reviewed classifications yet.</td></tr>
                    }
                    @foreach (var department in Model.ByDepartment)
                    {
                        <tr>
                            <td data-label="Department"><strong>@department.Department</strong></td>
                            <td data-label="Reviewed">@department.Total</td>
                            <td data-label="Correct">@department.Correct</td>
                            <td data-label="Accuracy"><span class="admin-nlp-accuracy @(department.AccuracyPercent >= 75 ? "admin-nlp-accuracy--good" : "admin-nlp-accuracy--bad")">@department.AccuracyPercent%</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @if (Model.AdminTriageEnabled)
    {
        <section class="admin-nlp-panel admin-nlp-panel--spaced" aria-labelledby="uncategorizedHeading">
            <header class="admin-nlp-panel-header">
                <div>
                    <span>Admin routing queue</span>
                    <h2 id="uncategorizedHeading">Uncategorized concerns and recommendations</h2>
                </div>
                <p>Review the full submission and its evidence before choosing the responsible office.</p>
            </header>
            <form method="get" class="admin-nlp-filters" aria-label="Filter Admin routing queue">
                <label><span>Submission type</span><select name="submissionType"><option value="All" selected="@(Model.CurrentType == "All")">All submissions</option><option value="Concern" selected="@(Model.CurrentType == "Concern")">Concerns only</option><option value="Recommendation" selected="@(Model.CurrentType == "Recommendation")">Recommendations only</option></select></label>
                <label><span>Sort by date</span><select name="sortOrder"><option value="Oldest" selected="@(Model.CurrentSort == "Oldest")">Oldest first</option><option value="Newest" selected="@(Model.CurrentSort == "Newest")">Newest first</option></select></label>
                <button type="submit">Apply filters</button>
                <span class="admin-nlp-result-count">@Model.UncategorizedSubmissions.Count result@(Model.UncategorizedSubmissions.Count == 1 ? "" : "s")</span>
            </form>
            <div class="admin-nlp-table-wrap">
                <table class="admin-nlp-table admin-nlp-table--routing">
                    <thead><tr><th scope="col">Type and status</th><th scope="col">Details</th><th scope="col">Waiting since</th><th scope="col">Assign office</th></tr></thead>
                    <tbody>
                        @if (!Model.UncategorizedSubmissions.Any())
                        {
                            <tr><td colspan="4" class="admin-nlp-empty">No uncategorized submissions are waiting for routing.</td></tr>
                        }
                        @foreach (var submission in Model.UncategorizedSubmissions)
                        {
                            <tr>
                                <td data-label="Type and status"><span class="admin-nlp-type">@submission.Type</span><strong>@submission.Status</strong><small>@submission.Attachments.Count attachment@(submission.Attachments.Count == 1 ? "" : "s")</small></td>
                                <td class="admin-nlp-summary" data-label="Details">
                                    <div class="admin-nlp-details-body admin-nlp-details-body--inline">
                                        @if (submission.Type == "Recommendation")
                                        {
                                            <div><span>Title</span><p>@submission.Title</p></div>
                                            <div><span>Community problem / justification</span><p>@submission.Justification</p></div>
                                            <div><span>Proposed improvement</span><p>@submission.Description</p></div>
                                            <div class="admin-nlp-detail-facts"><div><span>Location</span><p>@submission.Location</p></div><div><span>Beneficiaries</span><p>@submission.Beneficiaries</p></div><div><span>People affected</span><p>@submission.EstimatedPeopleAffected</p></div></div>
                                        }
                                        else
                                        {
                                            <div><span>Concern description</span><p>@submission.Description</p></div>
                                            <div><span>Location</span><p>@submission.Location</p></div>
                                        }
                                        <div class="admin-nlp-evidence">
                                            <span>Attachments</span>
                                            @if (!submission.Attachments.Any())
                                            {
                                                <p>No attachments provided.</p>
                                            }
                                            else
                                            {
                                                <div class="admin-nlp-attachments">
                                                    @for (var attachmentIndex = 0; attachmentIndex < submission.Attachments.Count; attachmentIndex++)
                                                    {
                                                        var attachment = submission.Attachments[attachmentIndex];
                                                        var isImage = attachment.Type == "image" || attachment.Type.StartsWith("image/");
                                                        var isVideo = attachment.Type == "video" || attachment.Type.StartsWith("video/");
                                                        <a href="@attachment.Path" target="_blank" rel="noopener" class="admin-nlp-attachment" aria-label="Open attachment @(attachmentIndex + 1)">
                                                            @if (isImage) { <img src="@attachment.Path" alt="Submission attachment @(attachmentIndex + 1)" loading="lazy" /> }
                                                            else if (isVideo) { <video src="@attachment.Path" muted preload="metadata"></video><strong>Open video</strong> }
                                                            else { <strong>Open document @(attachmentIndex + 1)</strong> }
                                                        </a>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td data-label="Waiting since"><time datetime="@submission.SubmittedAt.ToString("O")">@submission.SubmittedAt.ToString("MMM dd, yyyy h:mm tt")</time></td>
                                <td data-label="Assign office">
                                    <form method="post" asp-page-handler="Assign" class="admin-nlp-route-form">
                                        <input type="hidden" name="submissionType" value="@submission.Type" />
                                        <input type="hidden" name="submissionId" value="@submission.Id" />
                                        <input type="hidden" name="currentType" value="@Model.CurrentType" />
                                        <input type="hidden" name="currentSort" value="@Model.CurrentSort" />
                                        <select name="department" aria-label="Department for @submission.Type #@submission.Id" required>
                                            <option value="">Select office…</option>
                                            @foreach (var department in Model.Departments)
                                            {
                                                <option value="@department">@department</option>
                                            }
                                        </select>
                                        <button type="submit">Assign</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
    else
    {
        <section class="admin-nlp-panel admin-nlp-panel--spaced" aria-labelledby="misclassificationHeading">
            <header class="admin-nlp-panel-header"><div><span>Review audit</span><h2 id="misclassificationHeading">Recent misclassifications</h2></div><p>Latest reassignments requiring model-quality attention.</p></header>
            <div class="admin-nlp-table-wrap">
                <table class="admin-nlp-table admin-nlp-table--audit">
                    <thead><tr><th scope="col">Concern</th><th scope="col">Guessed</th><th scope="col">Actual</th><th scope="col">Reviewed by</th><th scope="col">When</th></tr></thead>
                    <tbody>
                        @if (!Model.RecentMisclassifications.Any()) { <tr><td colspan="5" class="admin-nlp-empty">No misclassifications logged yet.</td></tr> }
                        @foreach (var item in Model.RecentMisclassifications)
                        {
                            <tr><td class="admin-nlp-concern" data-label="Concern">#@item.ConcernId — @item.Description</td><td data-label="Guessed">@item.GuessedCategory</td><td data-label="Actual"><strong>@item.ActualCategory</strong></td><td data-label="Reviewed by">@item.ReviewedByEmail</td><td data-label="When">@item.ReviewedAt.ToString("MMM dd, yyyy h:mm tt")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

<script>
    window.setTimeout(() => {
        document.querySelectorAll('.admin-action-toast').forEach(toast => toast.remove());
    }, 5000);
</script>
