@page
@model VoxAngelos.Pages.Admin.UserApplicationsModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User Applications";
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin-userapplications.css" asp-append-version="true" />
}

@if (TempData["AdminSuccess"] is string successMessage)
{
    <div class="admin-action-toast admin-action-toast--success" role="status" aria-live="polite">
        <span>@successMessage</span>
        <div class="admin-action-toast-progress" aria-hidden="true"></div>
    </div>
}
@if (TempData["AdminError"] is string errorMessage)
{
    <div class="admin-action-toast admin-action-toast--error" role="alert" aria-live="assertive">
        <span>@errorMessage</span>
        <div class="admin-action-toast-progress" aria-hidden="true"></div>
    </div>
}

<div class="admin-applications-workspace">
    <header class="admin-applications-header">
        <div>
            <span class="admin-applications-eyebrow">Citizen account intake</span>
            <h1>User applications</h1>
            <p>Review identity verification submissions and move qualified citizen accounts through the approval queue.</p>
        </div>
        <div class="admin-applications-queue-summary" aria-label="Current queue view">
            <span>Current view</span>
            <strong>@(Model.FaceMatchFilter == "Attention" ? "Face checks needing attention" : Model.FilterStatus)</strong>
            <small>@Model.Applications.Count application@(Model.Applications.Count == 1 ? "" : "s")</small>
        </div>
    </header>

    <section class="admin-applications-panel" aria-labelledby="applicationsQueueHeading">
        <header class="admin-applications-panel-header">
            <div>
                <span>Verification queue</span>
                <h2 id="applicationsQueueHeading">Citizen application records</h2>
            </div>
            <p>Filter by status and application date, then choose how results are ordered.</p>
        </header>

        <nav class="admin-applications-filters" aria-label="Filter applications by status">
            <a asp-page="/Admin/UserApplications" asp-route-filterStatus="All" asp-route-dateRange="@Model.DateRange" asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")" asp-route-sortOrder="@Model.SortOrder" class="admin-applications-filter @(Model.FilterStatus == "All" ? "active" : "")">All</a>
            <a asp-page="/Admin/UserApplications" asp-route-filterStatus="Pending" asp-route-dateRange="@Model.DateRange" asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")" asp-route-sortOrder="@Model.SortOrder" class="admin-applications-filter @(Model.FilterStatus == "Pending" ? "active" : "")">Pending</a>
            <a asp-page="/Admin/UserApplications" asp-route-filterStatus="Approved" asp-route-dateRange="@Model.DateRange" asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")" asp-route-sortOrder="@Model.SortOrder" class="admin-applications-filter @(Model.FilterStatus == "Approved" ? "active" : "")">Approved</a>
            <a asp-page="/Admin/UserApplications" asp-route-filterStatus="Rejected" asp-route-dateRange="@Model.DateRange" asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")" asp-route-sortOrder="@Model.SortOrder" class="admin-applications-filter @(Model.FilterStatus == "Rejected" ? "active" : "")">Rejected</a>
        </nav>

        <form method="get" class="admin-applications-date-filters" id="applicationDateFilters">
            <input type="hidden" name="filterStatus" value="@Model.FilterStatus" />
            <input type="hidden" name="faceMatchFilter" value="@Model.FaceMatchFilter" />
            <label>
                <span>Date range</span>
                <select name="dateRange" id="dateRangeFilter">
                    <option value="All" selected="@(Model.DateRange == "All")">All dates</option>
                    <option value="Week" selected="@(Model.DateRange == "Week")">This week</option>
                    <option value="Month" selected="@(Model.DateRange == "Month")">This month</option>
                    <option value="Year" selected="@(Model.DateRange == "Year")">This year</option>
                </select>
            </label>
            <label>
                <span>From date</span>
                <input type="date" name="dateFrom" class="customDateFilter" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
            </label>
            <label>
                <span>To date <small>(optional)</small></span>
                <input type="date" name="dateTo" class="customDateFilter" value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
            </label>
            <label>
                <span>Sort by</span>
                <select name="sortOrder">
                    <option value="Newest" selected="@(Model.SortOrder == "Newest")">Newest first</option>
                    <option value="Oldest" selected="@(Model.SortOrder == "Oldest")">Oldest first</option>
                </select>
            </label>
            <div class="admin-applications-filter-actions">
                <button type="submit">Apply filters</button>
                <a asp-page="/Admin/UserApplications" asp-route-filterStatus="@Model.FilterStatus">Clear</a>
            </div>
        </form>

        <div class="admin-applications-table-wrap">
            <table class="admin-applications-table">
                <thead>
                    <tr>
                        <th scope="col">Applicant</th>
                        <th scope="col">Email address</th>
                        <th scope="col">Contact number</th>
                        <th scope="col">Applied</th>
                        <th scope="col">Face match</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Review application</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Applications.Any())
                    {
                        <tr>
                            <td colspan="7" class="admin-applications-empty">No applications found.</td>
                        </tr>
                    }
                    @foreach (var app in Model.Applications)
                    {
                            <tr class="@(app.IsMock ? "admin-applications-mock-row" : "")">
                            <td data-label="Applicant"><strong>@app.FullName</strong>@if (app.IsMock) { <span class="admin-applications-mock-label">Development mock</span> }</td>
                            <td data-label="Email address"><span class="admin-applications-email">@app.Email</span></td>
                            <td data-label="Contact number">@app.ContactNumber</td>
                            <td data-label="Applied"><time datetime="@app.DateApplied.ToString("s")">@app.DateApplied.ToString("MMM dd, yyyy")<small>@app.DateApplied.ToString("h:mm tt")</small></time></td>
                            <td data-label="Face match">
                                @if (!app.HasFaceVerification)
                                {
                                    <span class="admin-applications-confidence confidence missing">Not recorded</span>
                                }
                                else
                                {
                                    <span class="admin-applications-confidence confidence @(app.FaceMatchConfidence >= 0.50m ? "high" : "low")">
                                        @((app.FaceMatchConfidence.GetValueOrDefault() * 100).ToString("F1"))%
                                    </span>
                                }
                            </td>
                            <td data-label="Status">
                                <span class="admin-applications-status status-badge status-@app.ApprovalStatus.ToLower()">
                                    @app.ApprovalStatus
                                </span>
                            </td>
                            <td class="admin-applications-action" data-label="Action">
                                <a href="/Admin/ReviewApplication?userId=@app.UserId" class="admin-applications-review" aria-label="Review application for @app.FullName">Review<span aria-hidden="true">→</span></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

<script>
    document.getElementById('dateRangeFilter')?.addEventListener('change', event => {
        if (event.target.value !== 'All') document.querySelectorAll('.customDateFilter').forEach(input => input.value = '');
    });
    document.querySelectorAll('.customDateFilter').forEach(input => input.addEventListener('change', event => {
        if (event.target.value) document.getElementById('dateRangeFilter').value = 'All';
    }));
    window.setTimeout(() => {
        document.querySelectorAll('.admin-action-toast').forEach(toast => toast.remove());
    }, 5000);
</script>
