@page
@model VoxAngelos.Pages.Admin.OfficeManagementModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Office Management";
}
@section Styles {
    <link rel="stylesheet" href="/css/admin-officemanagement.css?v=office-management-v5" />
}

@{
    var totalAccounts = Model.LguAccounts.Count;
    var activeAccounts = Model.LguAccounts.Count(account => account.IsActive);
    var disabledAccounts = totalAccounts - activeAccounts;
    var officeCoverage = Model.LguAccounts.Select(account => account.Department).Distinct().Count();
}

<style>
    .admin-offices-workspace { width: 100% !important; max-width: 1280px !important; margin: 0 auto !important; }
    .admin-offices-header { display: flex !important; align-items: flex-end !important; justify-content: space-between !important; gap: 28px !important; margin-bottom: 26px !important; }
    .admin-offices-eyebrow, .admin-offices-panel-header > div > span { display: block !important; margin-bottom: 7px !important; color: #1646a0 !important; font-size: 10px !important; font-weight: 800 !important; letter-spacing: .12em !important; text-transform: uppercase !important; }
    .admin-offices-header h1 { margin: 0 !important; color: #172033 !important; font-size: clamp(30px, 4vw, 43px) !important; font-weight: 760 !important; line-height: 1 !important; letter-spacing: -.045em !important; }
    .admin-offices-header p { max-width: 690px !important; margin: 10px 0 0 !important; color: #5c687b !important; font-size: 13.5px !important; line-height: 1.55 !important; }
    .btn-create.admin-offices-primary-action { display: inline-flex !important; min-height: 43px !important; flex: 0 0 auto !important; align-items: center !important; justify-content: center !important; gap: 8px !important; padding: 0 16px !important; border: 1px solid #1646a0 !important; border-radius: 8px !important; background: #1646a0 !important; color: #ffffff !important; font-size: 12px !important; font-weight: 750 !important; white-space: nowrap !important; box-shadow: 0 7px 16px rgba(22, 70, 160, .18) !important; }
    .btn-create.admin-offices-primary-action > span { font-size: 18px !important; font-weight: 400 !important; line-height: 1 !important; }
    .admin-offices-summary { display: grid !important; grid-template-columns: repeat(4, minmax(0, 1fr)) !important; gap: 14px !important; margin-bottom: 26px !important; }
    .admin-offices-summary article { display: block !important; min-width: 0 !important; padding: 17px !important; border: 1px solid #dfe5ed !important; border-radius: 10px !important; background: #ffffff !important; }
    .admin-offices-summary span { display: block !important; color: #8994a6 !important; font-size: 9px !important; font-weight: 800 !important; letter-spacing: .08em !important; text-transform: uppercase !important; }
    .admin-offices-summary strong { display: block !important; margin: 9px 0 4px !important; color: #172033 !important; font-size: 29px !important; line-height: 1 !important; letter-spacing: -.04em !important; }
    .admin-offices-summary small { display: block !important; color: #5c687b !important; font-size: 10.5px !important; line-height: 1.4 !important; }
    .admin-offices-summary .admin-offices-success { color: #197153 !important; }
    .admin-offices-summary .admin-offices-danger { color: #c43f4b !important; }
    .admin-offices-panel { max-width: 1280px !important; margin: 0 auto !important; overflow: hidden !important; border: 1px solid #dfe5ed !important; border-radius: 10px !important; background: #ffffff !important; }
    .admin-offices-panel-header { display: flex !important; align-items: flex-end !important; justify-content: space-between !important; gap: 20px !important; padding: 20px 20px 16px !important; border-bottom: 1px solid #dfe5ed !important; }
    .admin-offices-panel-header h2 { margin: 0 !important; color: #172033 !important; font-size: 17px !important; font-weight: 750 !important; letter-spacing: -.025em !important; }
    .admin-offices-panel-header p { margin: 0 !important; color: #5c687b !important; font-size: 11px !important; line-height: 1.45 !important; }
    .admin-offices-table-wrap { width: 100% !important; overflow-x: auto !important; }
    .admin-offices-table { width: 100% !important; min-width: 860px !important; border-collapse: collapse !important; color: #334057 !important; font-size: 12px !important; text-align: left !important; }
    .admin-offices-table th { padding: 12px 20px !important; border-bottom: 1px solid #dfe5ed !important; color: #8994a6 !important; font-size: 9px !important; font-weight: 800 !important; letter-spacing: .08em !important; text-transform: uppercase !important; white-space: nowrap !important; }
    .admin-offices-table td { padding: 14px 20px !important; border-bottom: 1px solid #edf0f5 !important; line-height: 1.35 !important; vertical-align: middle !important; }
    .admin-offices-table tbody tr:last-child td { border-bottom: 0 !important; }
    .admin-offices-table td:first-child strong { color: #172033 !important; font-weight: 750 !important; }
    .admin-offices-email { color: #5c687b !important; }
    .admin-offices-actions { min-width: 160px !important; text-align: right !important; white-space: nowrap !important; }
    .admin-offices-inline-form { display: inline !important; }
    .admin-offices-workspace .status-badge { display: inline-flex !important; min-height: 25px !important; align-items: center !important; padding: 0 8px !important; border-radius: 5px !important; font-size: 10px !important; font-weight: 800 !important; white-space: nowrap !important; }
    .admin-offices-workspace .status-badge.status-approved { background: #e7f4ef !important; color: #197153 !important; }
    .admin-offices-workspace .status-badge.status-rejected { background: #fbecef !important; color: #c43f4b !important; }
    .admin-offices-workspace .btn-edit, .admin-offices-workspace .btn-review { display: inline-flex !important; min-height: 30px !important; align-items: center !important; justify-content: center !important; padding: 0 10px !important; border: 1px solid #cad9f3 !important; border-radius: 6px !important; background: #ffffff !important; color: #1646a0 !important; font-size: 10px !important; font-weight: 800 !important; cursor: pointer !important; }
    .admin-offices-workspace .btn-edit { margin-right: 5px !important; }
    .admin-offices-workspace .btn-review.btn-disable { border-color: #efbdc4 !important; background: #ffffff !important; color: #b03440 !important; }
    .admin-offices-workspace .btn-review.btn-enable { border-color: #b9dfd1 !important; background: #ffffff !important; color: #197153 !important; }
    @@media (max-width: 920px) { .admin-offices-summary { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; } }
    @@media (max-width: 700px) { .admin-offices-header, .admin-offices-panel-header { align-items: flex-start !important; flex-direction: column !important; gap: 14px !important; } .btn-create.admin-offices-primary-action { width: 100% !important; } }
</style>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="admin-office-toast admin-office-toast--success" role="status" aria-live="polite">
        <span>@Model.SuccessMessage</span>
        <div class="admin-office-toast-progress" aria-hidden="true"></div>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="admin-office-toast admin-office-toast--error" role="alert" aria-live="assertive">
        <span>@Model.ErrorMessage</span>
        <div class="admin-office-toast-progress" aria-hidden="true"></div>
    </div>
}

<div class="admin-offices-workspace">
    <header class="admin-offices-header">
        <div>
            <span class="admin-offices-eyebrow">Office access administration</span>
            <h1>LGU office accounts</h1>
            <p>Create and maintain department access while keeping account status and credential changes under controlled review.</p>
        </div>
        <button type="button" onclick="showCreateModal()" class="btn-create admin-offices-primary-action">
            <span aria-hidden="true">+</span> Create office account
        </button>
    </header>

    <section class="admin-offices-summary" aria-label="LGU account summary">
        <article><span>Total accounts</span><strong>@totalAccounts</strong><small>LGU user records</small></article>
        <article><span>Active access</span><strong class="admin-offices-success">@activeAccounts</strong><small>Enabled for sign-in</small></article>
        <article><span>Disabled access</span><strong class="admin-offices-danger">@disabledAccounts</strong><small>Locked office accounts</small></article>
        <article><span>Office coverage</span><strong>@officeCoverage</strong><small>Assigned departments</small></article>
    </section>

    <section class="admin-offices-panel" aria-labelledby="officeAccountsHeading">
        <header class="admin-offices-panel-header">
            <div>
                <span>Directory</span>
                <h2 id="officeAccountsHeading">Office account register</h2>
            </div>
            <p>Manage credentials and enablement state for every LGU department account.</p>
        </header>
        <div class="admin-offices-table-wrap">
            <table class="admin-offices-table">
                <thead>
                    <tr>
                        <th scope="col">Department / office</th>
                        <th scope="col">Employee ID</th>
                        <th scope="col">Office email</th>
                        <th scope="col">Created</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Account actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.LguAccounts.Any())
                    {
                        <tr>
                            <td colspan="6" class="empty-row">No LGU accounts found.</td>
                        </tr>
                    }
                    @foreach (var account in Model.LguAccounts)
                    {
                        <tr>
                            <td data-label="Department / office">
                                <strong>@account.Department</strong>
                                @if (!string.IsNullOrWhiteSpace(account.DepartmentFullName))
                                {
                                    <br /><span class="admin-offices-fullname">@account.DepartmentFullName</span>
                                }
                            </td>
                            <td data-label="Employee ID">@account.EmployeeId</td>
                            <td data-label="Office email"><span class="admin-offices-email">@account.Email</span></td>
                            <td data-label="Created"><time datetime="@account.CreatedAt.ToString("yyyy-MM-dd")">@account.CreatedAt.ToString("MM/dd/yyyy")</time></td>
                            <td data-label="Status">
                                <span class="status-badge @(account.IsActive ? "status-approved" : "status-rejected")">
                                    @(account.IsActive ? "Active" : "Disabled")
                                </span>
                            </td>
                            <td class="admin-offices-actions" data-label="Actions">
                                <button type="button"
                                        class="btn-edit"
                                        data-userid="@account.UserId"
                                        data-employeeid="@account.EmployeeId"
                                        data-email="@account.Email"
                                        data-department="@account.Department"
                                        data-fullname="@account.DepartmentFullName"
                                        data-tags="@string.Join(",", account.Tags)"
                                        data-categories="@string.Join(",", account.Categories)"
                                        onclick="showEditModalFromBtn(this)">Edit</button>
                                <form method="post" asp-page-handler="ToggleStatus" class="admin-offices-inline-form">
                                    <input type="hidden" name="userId" value="@account.UserId" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-review @(account.IsActive ? "btn-disable" : "btn-enable")">
                                        @(account.IsActive ? "Disable" : "Enable")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

<!-- ═══════════════════ CREATE MODAL ═══════════════════ -->
<div id="createModal" class="modal-overlay" style="display:none">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Create LGU Office Account</h3>
            <button onclick="closeMainModals()" class="modal-close">✕</button>
        </div>
        <form method="post" asp-page-handler="Create">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>Full Department/Office Name</label>
                <input type="text" name="NewDepartmentFullName" class="form-control" placeholder="e.g. Social Welfare and Development Office" required />
            </div>
            <div class="form-group">
                <label>Abbreviated Department/Office Name</label>
                <input type="text" name="NewDepartment" class="form-control" placeholder="e.g. SWDO" required />
            </div>
            <div class="form-group">
                <label>Employee ID</label>
                <input type="text" name="NewEmployeeId" class="form-control" placeholder="e.g. LGU-SWDO-002" required />
            </div>
            <div class="form-group">
                <label>Office Email</label>
                <input type="email" name="NewEmail" class="form-control" placeholder="e.g. swdo@voxangelos.gov.ph" required />
            </div>
            <div class="form-group">
                <label>Tags <span class="form-hint-inline">(used for NLP concern routing)</span></label>
                <div class="tag-input-wrap" id="newTagsWrap" onclick="document.getElementById('newTagsEntry').focus()">
                    <div class="tag-pills" id="newTagsPills"></div>
                    <input type="text" id="newTagsEntry" class="tag-entry-input"
                           placeholder="Type a tag and press Enter"
                           onkeydown="handleTagEntryKeydown('new', event)" />
                </div>
                <input type="hidden" id="newTags" name="NewTags" />
            </div>
            <div class="form-group">
                <label>Categories <span class="form-hint-inline">(HF classifier categories routed to this office)</span></label>
                <select id="newCategoriesSelect" class="form-control" onchange="addCategory('new', this.value); this.value='';">
                    <option value="" selected hidden>Select a category</option>
                    @foreach (var category in OfficeManagementModel.AvailableCategories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
                <div class="tag-input-wrap" id="newCategoriesWrap">
                    <div class="tag-pills" id="newCategoriesPills"></div>
                </div>
                <input type="hidden" id="newCategories" name="NewCategories" />
            </div>
            <p class="default-pass-note">Account will be created with the default password: <strong>Lgu@123456</strong></p>
            <div class="modal-actions">
                <button type="button" onclick="closeMainModals()" class="btn-cancel">Cancel</button>
                <button type="submit" class="btn-approve">Create Account</button>
            </div>
        </form>
    </div>
</div>

<!-- ═══════════════════ EDIT MODAL ═══════════════════ -->
<div id="editModal" class="modal-overlay" style="display:none">
    <div class="modal-box">
        <div class="modal-header">
            <h3>Edit LGU Account</h3>
            <button onclick="closeMainModals()" class="modal-close">✕</button>
        </div>
        <form id="editForm" method="post" asp-page-handler="Edit">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editUserId" name="EditUserId" />
            <div class="form-group">
                <label>Full Department/Office Name</label>
                <input type="text" id="editDepartmentFullName" name="EditDepartmentFullName" class="form-control" placeholder="e.g. Social Welfare and Development Office" required />
            </div>
            <div class="form-group">
                <label>Abbreviated Department/Office Name</label>
                <input type="text" id="editDepartment" name="EditDepartment" class="form-control" placeholder="e.g. SWDO" required />
            </div>
            <div class="form-group">
                <label>Employee ID</label>
                <input type="text" id="editEmployeeId" name="EditEmployeeId" class="form-control" required />
            </div>
            <div class="form-group">
                <label>Office Email</label>
                <input type="email" id="editEmail" name="EditEmail" class="form-control" required />
            </div>
            <div class="form-group">
                <label>Tags <span class="form-hint-inline">(used for NLP concern routing)</span></label>
                <div class="tag-input-wrap" id="editTagsWrap" onclick="document.getElementById('editTagsEntry').focus()">
                    <div class="tag-pills" id="editTagsPills"></div>
                    <input type="text" id="editTagsEntry" class="tag-entry-input"
                           placeholder="Type a tag and press Enter"
                           onkeydown="handleTagEntryKeydown('edit', event)" />
                </div>
                <input type="hidden" id="editTags" name="EditTags" />
            </div>
            <div class="form-group">
                <label>Categories <span class="form-hint-inline">(HF classifier categories routed to this office)</span></label>
                <select id="editCategoriesSelect" class="form-control" onchange="addCategory('edit', this.value); this.value='';">
                    <option value="" selected hidden>Select a category</option>
                    @foreach (var category in OfficeManagementModel.AvailableCategories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
                <div class="tag-input-wrap" id="editCategoriesWrap">
                    <div class="tag-pills" id="editCategoriesPills"></div>
                </div>
                <input type="hidden" id="editCategories" name="EditCategories" />
            </div>
            <div class="form-group">
                <label>New Password <span class="form-hint-inline">(leave blank to keep current)</span></label>
                <input type="password" id="editPassword" name="EditPassword" class="form-control" placeholder="Leave blank to keep current" />
            </div>
            <div class="modal-actions-split">
                <div class="action-group">
                    <button type="button" onclick="showResetWarning()" class="btn-warning">Reset Password</button>
                    <button type="button" onclick="showDeleteWarning()" class="btn-danger">Delete Account</button>
                </div>
                <div class="action-group">
                    <button type="button" onclick="closeMainModals()" class="btn-cancel" style="flex:0 0 auto;min-width:80px;">Cancel</button>
                    <button type="button" onclick="showSaveWarning()" class="btn-approve" style="flex:0 0 auto;min-width:120px;">Save Changes</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- ═══════════════════ WARNING: SAVE CHANGES ═══════════════════ -->
<div id="saveWarningModal" class="modal-overlay" style="display:none;z-index:1010">
    <div class="modal-box warning-modal">
        <div class="modal-header">
            <h3 class="warning-title">Confirm Changes</h3>
        </div>
        <div class="warning-body">
            <p>You are about to update credentials for the <strong id="saveDeptName"></strong> account.</p>
            <p>To confirm, type the department name below:</p>
            <p class="warning-target" id="saveTargetLabel"></p>
            <div class="confirm-input-group">
                <input type="text" id="saveConfirmInput" class="form-control"
                       placeholder="Type department name to confirm"
                       oninput="checkSaveConfirm()" />
            </div>
        </div>
        <div class="modal-actions">
            <button type="button" onclick="closeSaveWarning()" class="btn-cancel">Cancel</button>
            <button type="button" onclick="confirmSave()" class="btn-approve" id="confirmSaveBtn" disabled>Save Changes</button>
        </div>
    </div>
</div>

<!-- ═══════════════════ WARNING: REMOVE TAG ═══════════════════ -->
<div id="removeTagWarningModal" class="modal-overlay" style="display:none;z-index:1010">
    <div class="modal-box warning-modal">
        <div class="modal-header">
            <h3 class="warning-title">Remove Tag</h3>
        </div>
        <div class="warning-body">
            <p>Remove the tag <strong id="removeTagName"></strong>?</p>
        </div>
        <div class="modal-actions">
            <button type="button" onclick="closeRemoveTagWarning()" class="btn-cancel">Cancel</button>
            <button type="button" onclick="confirmRemoveTag()" class="btn-danger">Remove Tag</button>
        </div>
    </div>
</div>

<!-- ═══════════════════ WARNING: REMOVE CATEGORY ═══════════════════ -->
<div id="removeCategoryWarningModal" class="modal-overlay" style="display:none;z-index:1010">
    <div class="modal-box warning-modal">
        <div class="modal-header">
            <h3 class="warning-title">Remove Category</h3>
        </div>
        <div class="warning-body">
            <p>Remove the category <strong id="removeCategoryName"></strong> from this office? Concerns classified under this category will no longer be routed here until it's reassigned.</p>
        </div>
        <div class="modal-actions">
            <button type="button" onclick="closeRemoveCategoryWarning()" class="btn-cancel">Cancel</button>
            <button type="button" onclick="confirmRemoveCategory()" class="btn-danger">Remove Category</button>
        </div>
    </div>
</div>

<!-- ═══════════════════ WARNING: RESET PASSWORD ═══════════════════ -->
<div id="resetWarningModal" class="modal-overlay" style="display:none;z-index:1010">
    <div class="modal-box warning-modal">
        <div class="modal-header">
            <h3 class="warning-title">Reset Password</h3>
        </div>
        <div class="warning-body">
            <p>This will reset the password for <strong id="resetDeptName"></strong> to the default:</p>
            <p class="warning-target">Lgu@123456</p>
            <p>Type <strong>RESET PASSWORD</strong> to confirm:</p>
            <div class="confirm-input-group">
                <input type="text" id="resetConfirmInput" class="form-control"
                       placeholder="Type RESET PASSWORD"
                       oninput="checkResetConfirm()" />
            </div>
        </div>
        <div class="modal-actions">
            <button type="button" onclick="closeResetWarning()" class="btn-cancel">Cancel</button>
            <button type="button" onclick="confirmReset()" class="btn-warning" id="confirmResetBtn" disabled>Reset Password</button>
        </div>
    </div>
</div>

<!-- ═══════════════════ WARNING: DELETE ACCOUNT ═══════════════════ -->
<div id="deleteWarningModal" class="modal-overlay" style="display:none;z-index:1010">
    <div class="modal-box warning-modal warning-modal-delete">
        <div class="modal-header">
            <h3 class="warning-title warning-title-delete">Delete Account</h3>
        </div>
        <div class="warning-body">
            <p>This action <strong>cannot be undone</strong>. This will permanently delete the <strong id="deleteDeptName"></strong> account.</p>
            <p>To confirm, type the department name:</p>
            <p class="warning-target warning-target-delete" id="deleteTargetLabel"></p>
            <div class="confirm-input-group">
                <input type="text" id="deleteConfirmInput" class="form-control"
                       placeholder="Type department name to confirm"
                       oninput="checkDeleteConfirm()" />
            </div>
        </div>
        <div class="modal-actions">
            <button type="button" onclick="closeDeleteWarning()" class="btn-cancel">Cancel</button>
            <button type="button" onclick="confirmDelete()" class="btn-danger" id="confirmDeleteBtn" disabled>Delete Account</button>
        </div>
    </div>
</div>

<!-- Hidden forms for Reset and Delete (outside edit modal) -->
<form id="resetForm" method="post" asp-page-handler="Reset" style="display:none">
    @Html.AntiForgeryToken()
    <input type="hidden" id="resetUserId" name="userId" />
</form>

<form id="deleteForm" method="post" asp-page-handler="Delete" style="display:none">
    @Html.AntiForgeryToken()
    <input type="hidden" id="deleteUserId" name="userId" />
</form>

<script>
    let currentUserId = '';
    let currentDepartment = '';

    // category -> department already routed there, across every other office. Used to
    // grey out a category in the dropdown before Save Changes even runs, rather than only
    // rejecting the conflict server-side after the fact.
    const categoryOwnership = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryOwnership));

    // ── Tag pill input ──
    const tagState = { new: [], edit: [] };

    function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    function renderTags(key) {
        const pillsEl = document.getElementById(key + 'TagsPills');
        const hiddenEl = document.getElementById(key + 'Tags');
        pillsEl.innerHTML = tagState[key].map((tag, idx) => `
            <span class="tag-pill">
                <span>${escapeHtml(tag)}</span>
                <button type="button" class="tag-pill-remove" aria-label="Remove tag ${escapeHtml(tag)}" onclick="removeTag('${key}', ${idx}); event.stopPropagation();">×</button>
            </span>
        `).join('');
        hiddenEl.value = tagState[key].join(',');
    }

    function addTag(key, raw) {
        const value = raw.trim();
        if (!value) return;
        if (!tagState[key].some(t => t.toLowerCase() === value.toLowerCase())) {
            tagState[key].push(value);
            renderTags(key);
        }
    }

    let pendingTagRemoval = null;

    function removeTag(key, idx) {
        const tag = tagState[key][idx];
        if (tag === undefined) return;
        pendingTagRemoval = { key, idx };
        document.getElementById('removeTagName').textContent = tag;
        document.getElementById('removeTagWarningModal').style.display = 'flex';
    }

    function closeRemoveTagWarning() {
        pendingTagRemoval = null;
        document.getElementById('removeTagWarningModal').style.display = 'none';
    }

    function confirmRemoveTag() {
        if (!pendingTagRemoval) return;
        const { key, idx } = pendingTagRemoval;
        tagState[key].splice(idx, 1);
        renderTags(key);
        closeRemoveTagWarning();
    }

    function setTags(key, tags) {
        tagState[key] = tags.filter(t => t.length > 0);
        renderTags(key);
    }

    // ── Category pill input ──
    const categoryState = { new: [], edit: [] };

    function renderCategories(key) {
        const pillsEl = document.getElementById(key + 'CategoriesPills');
        const hiddenEl = document.getElementById(key + 'Categories');
        pillsEl.innerHTML = categoryState[key].map((category, idx) => `
            <span class="tag-pill">
                <span>${escapeHtml(category)}</span>
                <button type="button" class="tag-pill-remove" aria-label="Remove category ${escapeHtml(category)}" onclick="removeCategory('${key}', ${idx}); event.stopPropagation();">×</button>
            </span>
        `).join('');
        hiddenEl.value = categoryState[key].join(',');
        updateCategorySelectOptions(key);
    }

    function updateCategorySelectOptions(key) {
        const selectEl = document.getElementById(key + 'CategoriesSelect');
        if (!selectEl) return;
        // 'new' accounts have no department yet, so any category already owned elsewhere
        // is off-limits; 'edit' can keep the categories its own department already has.
        const ownerDept = key === 'edit' ? currentDepartment : null;
        [...selectEl.options].forEach(opt => {
            if (!opt.value) return;
            const takenInThisForm = categoryState[key].includes(opt.value);
            const ownedByOtherDept = categoryOwnership[opt.value] && categoryOwnership[opt.value] !== ownerDept;
            opt.hidden = takenInThisForm || ownedByOtherDept;
        });
    }

    function addCategory(key, value) {
        if (!value) return;
        if (!categoryState[key].includes(value)) {
            categoryState[key].push(value);
            renderCategories(key);
        }
    }

    let pendingCategoryRemoval = null;

    function removeCategory(key, idx) {
        const category = categoryState[key][idx];
        if (category === undefined) return;
        pendingCategoryRemoval = { key, idx };
        document.getElementById('removeCategoryName').textContent = category;
        document.getElementById('removeCategoryWarningModal').style.display = 'flex';
    }

    function closeRemoveCategoryWarning() {
        pendingCategoryRemoval = null;
        document.getElementById('removeCategoryWarningModal').style.display = 'none';
    }

    function confirmRemoveCategory() {
        if (!pendingCategoryRemoval) return;
        const { key, idx } = pendingCategoryRemoval;
        categoryState[key].splice(idx, 1);
        renderCategories(key);
        closeRemoveCategoryWarning();
    }

    function setCategories(key, categories) {
        categoryState[key] = categories.filter(c => c.length > 0);
        renderCategories(key);
    }

    function handleTagEntryKeydown(key, event) {
        if (event.key === 'Enter' || event.key === ',') {
            event.preventDefault();
            addTag(key, event.target.value);
            event.target.value = '';
        } else if (event.key === 'Backspace' && event.target.value === '' && tagState[key].length > 0) {
            removeTag(key, tagState[key].length - 1);
        }
    }

    function showEditModalFromBtn(btn) {
        currentUserId = btn.dataset.userid;
        currentDepartment = btn.dataset.department;
        document.getElementById('editUserId').value = currentUserId;
        document.getElementById('editEmployeeId').value = btn.dataset.employeeid;
        document.getElementById('editEmail').value = btn.dataset.email;
        document.getElementById('editDepartment').value = btn.dataset.department;
        document.getElementById('editDepartmentFullName').value = btn.dataset.fullname || '';
        document.getElementById('editPassword').value = '';
        document.getElementById('editTagsEntry').value = '';
        setTags('edit', btn.dataset.tags ? btn.dataset.tags.split(',') : []);
        setCategories('edit', btn.dataset.categories ? btn.dataset.categories.split(',') : []);
        document.getElementById('editModal').style.display = 'flex';
    }

    function showCreateModal() {
        document.getElementById('newTagsEntry').value = '';
        setTags('new', []);
        setCategories('new', []);
        document.getElementById('createModal').style.display = 'flex';
    }

    function closeMainModals() {
        document.getElementById('createModal').style.display = 'none';
        document.getElementById('editModal').style.display = 'none';
    }

    // ── Save Changes Warning ──
    function showSaveWarning() {
        document.getElementById('saveDeptName').textContent = currentDepartment;
        document.getElementById('saveTargetLabel').textContent = currentDepartment;
        document.getElementById('saveConfirmInput').value = '';
        document.getElementById('confirmSaveBtn').disabled = true;
        document.getElementById('saveWarningModal').style.display = 'flex';
    }

    function closeSaveWarning() {
        document.getElementById('saveWarningModal').style.display = 'none';
    }

    function checkSaveConfirm() {
        const val = document.getElementById('saveConfirmInput').value.trim();
        document.getElementById('confirmSaveBtn').disabled = (val !== currentDepartment);
    }

    function confirmSave() {
        document.getElementById('saveWarningModal').style.display = 'none';
        document.getElementById('editModal').style.display = 'none';
        document.getElementById('editForm').requestSubmit();
    }

    // ── Reset Password Warning ──
    function showResetWarning() {
        document.getElementById('resetDeptName').textContent = currentDepartment;
        document.getElementById('resetConfirmInput').value = '';
        document.getElementById('confirmResetBtn').disabled = true;
        document.getElementById('resetUserId').value = currentUserId;
        document.getElementById('resetWarningModal').style.display = 'flex';
    }

    function closeResetWarning() {
        document.getElementById('resetWarningModal').style.display = 'none';
    }

    function checkResetConfirm() {
        const val = document.getElementById('resetConfirmInput').value.trim();
        document.getElementById('confirmResetBtn').disabled = (val !== 'RESET PASSWORD');
    }

    function confirmReset() {
        document.getElementById('resetWarningModal').style.display = 'none';
        document.getElementById('editModal').style.display = 'none';
        document.getElementById('resetForm').requestSubmit();
    }

    // ── Delete Account Warning ──
    function showDeleteWarning() {
        document.getElementById('deleteDeptName').textContent = currentDepartment;
        document.getElementById('deleteTargetLabel').textContent = currentDepartment;
        document.getElementById('deleteConfirmInput').value = '';
        document.getElementById('confirmDeleteBtn').disabled = true;
        document.getElementById('deleteUserId').value = currentUserId;
        document.getElementById('deleteWarningModal').style.display = 'flex';
    }

    function closeDeleteWarning() {
        document.getElementById('deleteWarningModal').style.display = 'none';
    }

    function checkDeleteConfirm() {
        const val = document.getElementById('deleteConfirmInput').value.trim();
        document.getElementById('confirmDeleteBtn').disabled = (val !== currentDepartment);
    }

    function confirmDelete() {
        document.getElementById('deleteWarningModal').style.display = 'none';
        document.getElementById('editModal').style.display = 'none';
        document.getElementById('deleteForm').requestSubmit();
    }

    window.setTimeout(() => {
        document.querySelectorAll('.admin-office-toast').forEach(toast => toast.remove());
    }, 5000);
</script>
