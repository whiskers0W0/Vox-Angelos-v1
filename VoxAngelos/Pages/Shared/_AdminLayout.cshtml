@{

}
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using VoxAngelos.Data
@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@{
    var currentAdminUser = await UserManager.GetUserAsync(User);
    var recentAdminNotifications = new List<UserNotification>();
    var unreadAdminNotificationCount = 0;
    if (currentAdminUser != null)
    {
        unreadAdminNotificationCount = await Db.UserNotifications.AsNoTracking().CountAsync(notification => notification.RecipientUserId == currentAdminUser.Id && !notification.IsRead);
        recentAdminNotifications = await Db.UserNotifications.AsNoTracking().Where(notification => notification.RecipientUserId == currentAdminUser.Id).OrderByDescending(notification => notification.CreatedAt).Take(5).ToListAsync();
    }
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Vox Angelos</title>
    <link rel="stylesheet" href="~/css/admin-layout.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>

<body>

    @{
        var path = Context.Request.Path.Value?.ToLower() ?? "";
    }

    <div class="layout-wrapper">
        <!-- Sidebar -->
        <aside class="sidebar" id="adminSidebar">
            <div class="sidebar-brand" aria-label="Vox Angelos Administration">
                <img src="~/assets/VoxAngelosLogo.png" class="brand-logo" alt="" />
                <span class="brand-name">Vox Angelos</span>
            </div>

            <button type="button" class="sidebar-collapse-toggle" id="adminSidebarCollapseToggle" aria-controls="adminSidebar" aria-expanded="true" aria-label="Collapse sidebar" title="Collapse sidebar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
            </button>
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const toggle = document.getElementById('adminSidebarCollapseToggle');
                    const layout = toggle?.closest('.layout-wrapper');
                    if (!toggle || !layout) return;

                    const preferenceKey = 'voxangelos.admin.sidebar-collapsed';
                    layout.querySelectorAll('.sidebar .nav-item').forEach(item => {
                        const label = item.textContent.trim();
                        if (label) {
                            item.setAttribute('title', label);
                            item.setAttribute('aria-label', label);
                        }
                    });

                    const applyState = collapsed => {
                        layout.classList.toggle('sidebar-collapsed', collapsed);
                        toggle.setAttribute('aria-expanded', (!collapsed).toString());
                        toggle.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
                        toggle.title = collapsed ? 'Expand sidebar' : 'Collapse sidebar';
                    };

                    try { applyState(localStorage.getItem(preferenceKey) === 'true'); } catch { applyState(false); }
                    toggle.addEventListener('click', () => {
                        const collapsed = !layout.classList.contains('sidebar-collapsed');
                        applyState(collapsed);
                        try { localStorage.setItem(preferenceKey, collapsed.toString()); } catch { }
                    });
                });
            </script>

                <nav class="sidebar-nav">

                    <a asp-page="/Admin/Index" class="nav-item @(path == "/admin" ? "active" : "")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7" rx="1" />
                            <rect x="14" y="3" width="7" height="7" rx="1" />
                            <rect x="3" y="14" width="7" height="7" rx="1" />
                            <rect x="14" y="14" width="7" height="7" rx="1" />
                        </svg>
                        <span>Dashboard</span>
                    </a>

                    <a asp-page="/Admin/UserApplications" class="nav-item @(path == "/admin/userapplications" ? "active" : "")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="8.5" cy="7" r="4" />
                            <polyline points="17 11 19 13 23 9" />
                        </svg>
                        <span>User Applications</span>
                    </a>
                    <a asp-page="/Admin/OfficeManagement" class="nav-item @(path == "/admin/officemanagement" ? "active" : "")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="4" y="11" width="16" height="10" rx="2" />
                            <path d="M12 11V7" />
                            <path d="M6 7l6-4 6 4" />
                            <path d="M8 15h.01" />
                            <path d="M12 15h.01" />
                            <path d="M16 15h.01" />
                        </svg>
                        <span>Office Management</span>
                    </a>

                    <a asp-page="/Admin/NlpAccuracy" class="nav-item @(path == "/admin/nlpaccuracy" ? "active" : "")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 3v18h18" />
                            <path d="M18 17V9" />
                            <path d="M13 17V5" />
                            <path d="M8 17v-3" />
                        </svg>
                        <span>NLP &amp; Routing</span>
                    </a>

                </nav>

                <div class="sidebar-footer">
                    <form method="post" action="/Identity/Account/Logout" class="w-100">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="/Identity/Account/Login" />
                        <button type="submit" class="nav-item logout-btn w-100 border-0 bg-transparent text-start">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                <polyline points="16,17 21,12 16,7" />
                                <line x1="21" y1="12" x2="9" y2="12" />
                            </svg>
                            <span>Log Out</span>
                        </button>
                    </form>
                    </div>
            </aside>

            <!-- Mobile top bar -->
            <div class="mobile-topbar">
                <button class="hamburger" id="hamburgerBtn" aria-label="Open menu">
                    <span></span><span></span><span></span>
                </button>
                <div class="mobile-brand">
                    <img src="~/assets/VoxAngelosLogo.png" class="brand-v" alt="" />
                    <span>Vox Angelos</span>
                </div>
                </div>

                <!-- Sidebar overlay -->
                <div class="sidebar-overlay" id="sidebarOverlay"></div>

                <!-- Page Content -->
                <main class="main-content">
                    <form id="admin-notification-antiforgery-form" hidden>@Html.AntiForgeryToken()</form>
                    <div class="admin-notification-toolbar">
                        <details class="admin-notification-menu">
                            <summary class="admin-notification-trigger" aria-label="Open Admin notifications"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" /><path d="M10 21h4" /></svg>@if (unreadAdminNotificationCount > 0){<span class="admin-notification-count"></span>}</summary>
                            <div class="admin-notification-dropdown">
                                <div class="admin-notification-header"><strong>Notifications</strong>@if (unreadAdminNotificationCount > 0){<span>@unreadAdminNotificationCount unread</span>}</div>
                                @if (currentAdminUser != null)
                                {
                                    <div class="admin-notification-email-preference"><div class="admin-notification-email-copy"><strong>Email alerts</strong><span>@(currentAdminUser.EmailConfirmed ? $"Send application and routing alerts to {currentAdminUser.Email}" : "A confirmed Admin email is required.")</span></div><label class="admin-notification-email-switch" for="adminEmailNotificationsToggle"><input type="checkbox" id="adminEmailNotificationsToggle" checked="@currentAdminUser.EmailNotificationsEnabled" disabled="@(!currentAdminUser.EmailConfirmed)" aria-label="Receive Admin alerts by email" /><span aria-hidden="true"></span></label><small id="adminEmailNotificationsStatus" class="admin-notification-email-status" aria-live="polite"></small></div>
                                }
                                @if (recentAdminNotifications.Count == 0)
                                {
                                    <div class="admin-notification-empty"><strong>No notifications yet</strong><span>New applications and submissions requiring routing will appear here.</span></div>
                                }
                                else
                                {
                                    <div class="admin-notification-list">@foreach (var notification in recentAdminNotifications){<a class="admin-notification-item @(!notification.IsRead ? "unread" : "")" href="@(string.IsNullOrWhiteSpace(notification.LinkUrl) ? "/Admin" : notification.LinkUrl)" data-notification-id="@notification.Id"><span class="admin-notification-copy"><strong>@notification.Title</strong><span>@notification.Message</span><small>@notification.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</small></span></a>}</div>
                                }
                            </div>
                        </details>
                    </div>
                    @RenderBody()
                </main>
            </div>

            
            <script>
                    const hamburgerBtn = document.getElementById('hamburgerBtn');
                    const sidebar = document.querySelector('.sidebar');
                    const overlay = document.getElementById('sidebarOverlay');

                    hamburgerBtn.addEventListener('click', () => {
                        sidebar.classList.toggle('open');
                        overlay.classList.toggle('active');
                    });

                    overlay.addEventListener('click', () => {
                        sidebar.classList.remove('open');
                        overlay.classList.remove('active');
                    });
            </script>

            <script src="~/js/form-submit-lock.js" asp-append-version="true"></script>
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const token = document.querySelector('#admin-notification-antiforgery-form input[name="__RequestVerificationToken"]')?.value ?? '';
                    document.querySelectorAll('.admin-notification-item.unread').forEach(item => item.addEventListener('click', async event => {
                        event.preventDefault();
                        try { await fetch('/Admin/Notifications?handler=MarkNotificationRead', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: `notificationId=${encodeURIComponent(item.dataset.notificationId ?? '')}&__RequestVerificationToken=${encodeURIComponent(token)}` }); }
                        finally { window.location.assign(item.href); }
                    }));

                    const toggle = document.getElementById('adminEmailNotificationsToggle');
                    const status = document.getElementById('adminEmailNotificationsStatus');
                    toggle?.addEventListener('change', async () => {
                        const requestedState = toggle.checked;
                        toggle.disabled = true;
                        status.textContent = 'Saving preference...';
                        status.className = 'admin-notification-email-status';
                        try {
                            const response = await fetch('/Admin/Notifications?handler=SetEmailNotifications', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: `enabled=${encodeURIComponent(requestedState)}&__RequestVerificationToken=${encodeURIComponent(token)}` });
                            const result = await response.json();
                            if (!response.ok || !result.success) throw new Error(result.message || 'Unable to update your email preference.');
                            status.textContent = result.message;
                            status.classList.add('is-success');
                        } catch (error) {
                            toggle.checked = !requestedState;
                            status.textContent = error.message || 'Unable to update your email preference.';
                            status.classList.add('is-error');
                        } finally { toggle.disabled = false; }
                    });
                });
            </script>
            @RenderSection("Scripts", required: false)
        </body>

    </html>
