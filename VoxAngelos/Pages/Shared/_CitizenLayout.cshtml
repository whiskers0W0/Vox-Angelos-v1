@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using VoxAngelos.Data
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Db

@{
    var currentUser = await UserManager.GetUserAsync(User);

    var firstName = "User";
    string? sidebarAvatarKey = null;
    var hasUnreadNotifications = false;
    var recentNotifications = new List<UserNotification>();

    if (currentUser != null)
    {
        firstName = await Db.UserProfiles
            .Where(p => p.UserId == currentUser.Id)
            .Select(p => p.FirstName)
            .FirstOrDefaultAsync() ?? "User";

        sidebarAvatarKey = currentUser.ProfilePhotoUrl switch
        {
            "/images/avatars/philippine-eagle.png" => "philippine-eagle",
            "/images/avatars/philippine-tarsier.png" => "philippine-tarsier",
            "/images/avatars/carabao.png" => "carabao",
            "/images/avatars/pawikan.png" => "pawikan",
            "/images/avatars/owl.png" => "owl",
            "/images/avatars/aspin.png" => "aspin",
            "/images/avatars/puspin.png" => "puspin",
            "/images/avatars/rabbit.png" => "rabbit",
            "/images/avatars/dolphin.png" => "dolphin",
            "/images/avatars/philippine-hornbill.png" => "philippine-hornbill",
            _ => null
        };

        hasUnreadNotifications = await Db.UserNotifications
            .AnyAsync(n => n.RecipientUserId == currentUser.Id && !n.IsRead);

        recentNotifications = await Db.UserNotifications
            .Where(n => n.RecipientUserId == currentUser.Id)
            .OrderByDescending(n => n.CreatedAt)
            .Take(5)
            .ToListAsync();
    }
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Vox Angelos</title>
    <link rel="stylesheet" href="~/css/citizen-layout.css" asp-append-version="true" />
    <style>
        .citizen-discover-shell .sidebar-animal-avatar {
            display: block;
            width: 34px;
            height: 34px;
            flex: 0 0 34px;
            border: 1px solid #d7e1f2;
            border-radius: 10px;
            background-color: #eef3fb;
            background-image: url('/images/avatars/generated-animal-avatars.png');
            background-repeat: no-repeat;
            background-size: 565.75% 282.5%;
        }

        .sidebar-animal-avatar.avatar-philippine-eagle { background-position: 3.83% 20.6%; }
        .sidebar-animal-avatar.avatar-philippine-tarsier { background-position: 27.15% 20.6%; }
        .sidebar-animal-avatar.avatar-carabao { background-position: 50.05% 20.6%; }
        .sidebar-animal-avatar.avatar-pawikan { background-position: 72.94% 20.6%; }
        .sidebar-animal-avatar.avatar-owl { background-position: 95.84% 20.6%; }
        .sidebar-animal-avatar.avatar-aspin { background-position: 3.83% 79.9%; }
        .sidebar-animal-avatar.avatar-puspin { background-position: 27.15% 79.9%; }
        .sidebar-animal-avatar.avatar-rabbit { background-position: 50.05% 79.9%; }
        .sidebar-animal-avatar.avatar-dolphin { background-position: 72.94% 79.9%; }
        .sidebar-animal-avatar.avatar-philippine-hornbill { background-position: 95.84% 79.9%; }
    </style>
    @RenderSection("Styles", required: false)
</head>

@{
    var path = Context.Request.Path.Value?.ToLower() ?? "";
}
<body class="citizen-shell citizen-discover-shell">

    <div class="layout-wrapper">
        <!-- Sidebar -->
        <aside class="sidebar" id="citizenSidebar">
            <a asp-page="/User/Index" class="sidebar-brand" aria-label="Vox Angelos citizen portal">
                <img src="~/assets/VoxAngelosLogo.png" class="brand-logo" alt="" />
                <span class="brand-copy">
                    <strong class="brand-name">Vox Angelos</strong>
                    <small>Citizen portal</small>
                </span>
            </a>

            <button type="button" class="sidebar-collapse-toggle" id="citizenSidebarCollapseToggle" aria-controls="citizenSidebar" aria-expanded="true" aria-label="Collapse sidebar" title="Collapse sidebar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
            </button>
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const toggle = document.getElementById('citizenSidebarCollapseToggle');
                    const layout = toggle?.closest('.layout-wrapper');
                    if (!toggle || !layout) return;

                    const preferenceKey = 'voxangelos.citizen.sidebar-collapsed';
                    const navItems = layout.querySelectorAll('.sidebar .nav-item');
                    navItems.forEach(item => {
                        const label = item.textContent.trim();
                        if (label) {
                            item.setAttribute('title', label);
                            item.setAttribute('aria-label', label);
                        }
                    });

                    const applyState = collapsed => {
                        layout.classList.toggle('sidebar-collapsed', collapsed);
                        toggle.setAttribute('aria-expanded', (!collapsed).toString());
                        toggle.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
                        toggle.title = collapsed ? 'Expand sidebar' : 'Collapse sidebar';
                    };

                    try { applyState(localStorage.getItem(preferenceKey) === 'true'); } catch { applyState(false); }
                    toggle.addEventListener('click', () => {
                        const collapsed = !layout.classList.contains('sidebar-collapsed');
                        applyState(collapsed);
                        try { localStorage.setItem(preferenceKey, collapsed.toString()); } catch { }
                    });
                });
            </script>

            <nav class="sidebar-nav" aria-label="Citizen navigation">

                <div class="user-profile">
                    <a asp-page="/User/Profile" class="profile-link @(path == "/user/profile" ? "active" : "")">
                        @if (sidebarAvatarKey != null)
                        {
                            <span class="sidebar-animal-avatar avatar-@sidebarAvatarKey" role="img" aria-label="Selected animal profile avatar"></span>
                        }
                        else
                        {
                            <span class="sidebar-avatar-fallback" aria-hidden="true">@(firstName.Length > 0 ? firstName[0].ToString().ToUpperInvariant() : "U")</span>
                        }
                        <span class="profile-copy">
                            <strong>@firstName</strong>
                            <small>View profile</small>
                        </span>
                        <span class="profile-arrow" aria-hidden="true">›</span>
                    </a>
                </div>

                    <hr class="sidebar-divider" />

                    <a asp-page="/User/Index" class="nav-item @(path == "/user" ? "active" : "")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                            <polyline points="9,22 9,12 15,12 15,22" />
                        </svg>
                        <span>Discover</span>
                    </a>
                    <a asp-page="/User/Concerns" class="nav-item @(path == "/user/concerns" ? "active" : "")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14,2 14,8 20,8" />
                            <line x1="8" y1="13" x2="16" y2="13" />
                            <line x1="8" y1="17" x2="13" y2="17" />
                        </svg>
                        <span>My Concerns</span>
                    </a>
                    <a asp-page="/User/Recommendations" class="nav-item @(path == "/user/recommendations" ? "active" : "")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 4h14v16H5z" />
                            <path d="M8 8h8M8 12h8M8 16h5" />
                        </svg>
                        <span>My Recommendations</span>
                    </a>
                    <a asp-page="/User/Create" class="nav-item @(path == "/user/create" ? "active" : "")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="16" />
                            <line x1="8" y1="12" x2="16" y2="12" />
                        </svg>
                        <span>Create</span>
                    </a>
                    <a asp-page="/User/AccountSecurity" class="nav-item @(path == "/user/accountsecurity" ? "active" : "")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="5" y="10" width="14" height="10" rx="2" />
                            <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                        </svg>
                        <span>Account Security</span>
                    </a>
                </nav>

                <div class="sidebar-footer">
                    <form method="post" action="/Identity/Account/Logout" class="w-100">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="/Identity/Account/Login" />
                        <button type="submit" class="nav-item logout-btn w-100 border-0 bg-transparent text-start">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                <polyline points="16,17 21,12 16,7" />
                                <line x1="21" y1="12" x2="9" y2="12" />
                            </svg>
                            <span>Log Out</span>
                        </button>
                    </form>
                </div>
            </aside>

            <!-- Mobile top bar -->
            <div class="mobile-topbar">
                <button class="hamburger" id="hamburgerBtn" aria-label="Open menu">
                    <span></span><span></span><span></span>
                </button>
                <div class="mobile-brand">
                    <img src="~/assets/VoxAngelosLogo.png" class="brand-v" alt="" />
                    <span>Vox Angelos</span>
                </div>
                </div>

                <!-- Sidebar overlay -->
                <div class="sidebar-overlay" id="sidebarOverlay"></div>

                <!-- Page Content -->
                <main class="main-content">
                    <form id="notification-antiforgery-form" hidden>
                        @Html.AntiForgeryToken()
                    </form>
                    <div class="citizen-topbar-actions">
                        <details class="notification-bell">
                            <summary aria-label="Open notifications" title="Notifications">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                                    <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                                </svg>
                                @if (hasUnreadNotifications)
                                {
                                    <span class="notification-bell-indicator" aria-label="Unread notifications"></span>
                                }
                            </summary>

                            <div class="notification-dropdown">
                                <div class="notification-dropdown-title">Notifications</div>
                                @if (currentUser != null)
                                {
                                    <div class="notification-email-preference">
                                        <div class="notification-email-preference-copy">
                                            <strong>Email updates</strong>
                                            <span>
                                                @(currentUser.EmailConfirmed
                                                    ? $"Send important updates to {currentUser.Email}"
                                                    : "Confirm your email address to enable email updates.")
                                            </span>
                                        </div>
                                        <label class="notification-email-switch" for="emailNotificationsToggle">
                                            <input type="checkbox"
                                                   id="emailNotificationsToggle"
                                                   checked="@currentUser.EmailNotificationsEnabled"
                                                   disabled="@(!currentUser.EmailConfirmed)"
                                                   aria-label="Receive citizen activity updates by email" />
                                            <span aria-hidden="true"></span>
                                        </label>
                                        <small id="emailNotificationsStatus" class="notification-email-status" aria-live="polite"></small>
                                    </div>
                                }
                                @if (!recentNotifications.Any())
                                {
                                    <p class="notification-empty-state">You have no notifications yet.</p>
                                }
                                else
                                {
                                    @foreach (var notification in recentNotifications)
                                    {
                                        <a class="notification-dropdown-item @(notification.IsRead ? "" : "unread")"
                                           data-notification-id="@notification.Id"
                                           href="@(notification.LinkUrl ?? "/User/Concerns")">
                                            <span class="notification-dropdown-item-title">@notification.Title</span>
                                            <span class="notification-dropdown-item-message">@notification.Message</span>
                                            <span class="notification-dropdown-item-date">@notification.CreatedAt.ToLocalTime().ToString("MMM dd, h:mm tt")</span>
                                        </a>
                                    }
                                }
                            </div>
                        </details>
                    </div>
                    @RenderBody()
                </main>
            </div>

            
            <script>
                    const hamburgerBtn = document.getElementById('hamburgerBtn');
                    const sidebar = document.querySelector('.sidebar');
                    const overlay = document.getElementById('sidebarOverlay');
                    const notificationRequestToken = document.querySelector('#notification-antiforgery-form input[name="__RequestVerificationToken"]')?.value;
                    const emailNotificationsToggle = document.getElementById('emailNotificationsToggle');
                    const emailNotificationsStatus = document.getElementById('emailNotificationsStatus');

                    hamburgerBtn.addEventListener('click', () => {
                        sidebar.classList.toggle('open');
                        overlay.classList.toggle('active');
                    });

                    overlay.addEventListener('click', () => {
                        sidebar.classList.remove('open');
                        overlay.classList.remove('active');
                    });

                    emailNotificationsToggle?.addEventListener('change', async () => {
                        const requestedState = emailNotificationsToggle.checked;
                        emailNotificationsToggle.disabled = true;
                        emailNotificationsStatus.textContent = 'Saving preference...';
                        emailNotificationsStatus.classList.remove('is-success', 'is-error');

                        try {
                            const response = await fetch('/User/Concerns?handler=SetEmailNotifications', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/x-www-form-urlencoded'
                                },
                                body: `enabled=${encodeURIComponent(requestedState)}&__RequestVerificationToken=${encodeURIComponent(notificationRequestToken ?? '')}`
                            });
                            const result = await response.json();

                            if (!response.ok || !result.success) {
                                throw new Error(result.message || 'Unable to update your email preference.');
                            }

                            emailNotificationsStatus.textContent = result.message;
                            emailNotificationsStatus.classList.add('is-success');
                        } catch (error) {
                            emailNotificationsToggle.checked = !requestedState;
                            emailNotificationsStatus.textContent = error.message || 'Unable to update your email preference.';
                            emailNotificationsStatus.classList.add('is-error');
                        } finally {
                            emailNotificationsToggle.disabled = false;
                        }
                    });

                    document.querySelectorAll('.notification-dropdown-item.unread').forEach(item => {
                        item.addEventListener('click', async event => {
                            event.preventDefault();

                            const destination = item.href;
                            const notificationId = item.dataset.notificationId;

                            try {
                                await fetch('/User/Concerns?handler=MarkNotificationRead', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/x-www-form-urlencoded'
                                    },
                                    body: `notificationId=${encodeURIComponent(notificationId)}&__RequestVerificationToken=${encodeURIComponent(notificationRequestToken ?? '')}`
                                });
                            } finally {
                                window.location.assign(destination);
                            }
                        });
                    });
            </script>

            <script src="~/lib/signalr/signalr.min.js"></script>
            <script src="~/js/realtime.js"></script>
            <script src="~/js/form-submit-lock.js" asp-append-version="true"></script>

            @RenderSection("Scripts", required: false)

            <link rel="stylesheet" href="https://www.gstatic.com/dialogflow-console/fast/df-messenger/prod/v1/themes/df-messenger-default.css">
            <script src="https://www.gstatic.com/dialogflow-console/fast/df-messenger/prod/v1/df-messenger.js"></script>
            <df-messenger
              project-id="project-f1ec1946-b42e-49fe-b06"
              agent-id="217dac9a-a573-4bfa-af02-96e011e06558"
              language-code="en"
              max-query-length="-1">
              <df-messenger-chat-bubble
                chat-title="Vox Angelos Help Desk">
              </df-messenger-chat-bubble>
            </df-messenger>
            <style>
              /* Dialogflow Messenger uses documented CSS properties on the host
                 element, retaining its existing agent and interaction flow. */
              df-messenger {
                position: fixed;
                right: 24px;
                bottom: 22px;
                z-index: 999;
                --df-messenger-font-family: "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
                --df-messenger-font-size: 13px;
                --df-messenger-font-color: #172033;
                --df-messenger-primary-color: #1646a0;
                --df-messenger-focus-color: #1646a0;
                --df-messenger-focus-color-contrast: #ffffff;
                --df-messenger-chat-border: 1px solid #dfe5ed;
                --df-messenger-chat-border-radius: 12px;
                --df-messenger-chat-window-width: min(380px, calc(100vw - 32px));
                --df-messenger-chat-window-height: min(560px, calc(100vh - 104px));
                --df-messenger-chat-window-offset: 14px;
                --df-messenger-chat-window-box-shadow: 0 18px 45px rgba(23, 32, 51, .18);
                --df-messenger-chat-bubble-size: 54px;
                --df-messenger-chat-bubble-background: #1646a0;
                --df-messenger-chat-bubble-border: 1px solid #0b2e6f;
                --df-messenger-chat-bubble-border-radius: 14px;
                --df-messenger-chat-bubble-icon-color: #ffffff;
                --df-messenger-titlebar-background: #0b2e6f;
                --df-messenger-titlebar-padding: 0 18px;
                --df-messenger-titlebar-border-bottom: 1px solid rgba(255, 255, 255, .16);
                --df-messenger-titlebar-font-color: #ffffff;
                --df-messenger-titlebar-title-font-family: "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
                --df-messenger-titlebar-title-font-size: 14px;
                --df-messenger-titlebar-title-font-weight: 750;
                --df-messenger-titlebar-title-letter-spacing: -.01em;
                --df-messenger-chat-background: #f8fafc;
                --df-messenger-chat-padding: 14px;
                --df-messenger-message-spacing: 9px;
                --df-messenger-message-border-radius: 9px;
                --df-messenger-message-bot-background: #ffffff;
                --df-messenger-message-bot-border: 1px solid #dfe5ed;
                --df-messenger-message-bot-font-color: #253047;
                --df-messenger-message-user-background: #1646a0;
                --df-messenger-message-user-font-color: #ffffff;
                --df-messenger-message-font-size: 12.5px;
                --df-messenger-input-background: #ffffff;
                --df-messenger-input-border-top: 1px solid #dfe5ed;
                --df-messenger-input-box-border: 1px solid #d5deeb;
                --df-messenger-input-box-focus-border: 1px solid #1646a0;
                --df-messenger-input-box-border-radius: 8px;
                --df-messenger-input-box-padding: 10px 14px;
                --df-messenger-input-box-focus-padding: 10px 14px;
                --df-messenger-input-font-color: #172033;
                --df-messenger-input-font-size: 12.5px;
                --df-messenger-send-icon-color: #8994a6;
                --df-messenger-send-icon-color-hover: #1646a0;
                --df-messenger-send-icon-color-active: #1646a0;
              }

              @@media (max-width: 640px) {
                df-messenger {
                  right: 14px;
                  bottom: 14px;
                  --df-messenger-chat-window-width: calc(100vw - 28px);
                  --df-messenger-chat-window-height: min(520px, calc(100vh - 92px));
                }
              }
            </style>
        </body>

    </html>
