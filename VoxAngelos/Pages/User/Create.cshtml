@page
@model VoxAngelos.Pages.User.CreateModel
@{
    Layout = "_CitizenLayout";
    ViewData["Title"] = "Create";
}

@section Styles {
    <link rel="stylesheet" href="~/css/citizen-create.css" asp-append-version="true" />
}

<div class="create-page">
    <header class="content-header citizen-page-header create-page-header">
        <div>
            <span class="citizen-page-eyebrow">Citizen workspace</span>
            <h1 class="page-title">Submit a Concern</h1>
            <p class="citizen-page-description">Report a local issue or share a recommendation for Angeles City.</p>
        </div>
    </header>

    <section class="create-mode-panel" aria-label="Choose what you want to submit">
        <div class="create-mode-copy">
            <span>New submission</span>
            <p>Choose a concern for a current local issue, or a recommendation for a proposed city improvement.</p>
        </div>
        <div class="tab-group">
            <div class="tab-indicator"></div>
            <button class="tab-btn active" data-view="concern">Report a concern</button>
            <button class="tab-btn" data-view="project">Propose an idea</button>
        </div>
    </section>

@if (TempData["ConcernSuccess"] != null)
{
    <div class="custom-alert-container">
        <div class="neomorphic-alert success">
            <div class="alert-icon-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <span class="alert-text">
                @TempData["ConcernSuccess"]
                <a asp-page="/User/Concerns" class="create-success-link">View My Concerns</a>
            </span>
            <button type="button" class="alert-close" onclick="this.parentElement.style.display='none';">
                &times;
            </button>
        </div>
    </div>
}

<!-- Concern Form -->
<div id="concernView" class="view-section active-view">
    <div class="submission-view-wrap">
        <div class="concern-card">

            <form id="concernForm" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                @if (!ViewContext.ViewData.ModelState.IsValid)
                {
                    <div class="custom-alert-container" role="alert">
                        <div class="neomorphic-alert create-error-alert">
                            <div class="alert-icon-circle create-error-icon">!</div>
                            <div class="alert-text create-error-text">
                                <strong>Your concern was not sent.</strong>
                                <div asp-validation-summary="All"></div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Hidden fields populated by JS -->
                <input type="hidden" id="hdnLocationName" name="LocationName" />
                <input type="hidden" id="hdnLatitude" name="Latitude" />
                <input type="hidden" id="hdnLongitude" name="Longitude" />

                <!-- User row -->
                <div class="concern-user-row">
                    <div class="concern-avatar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                    </div>
                    <span class="concern-username">@Model.CitizenFullName</span>
                </div>

                <!-- Description -->
                <div class="concern-form-group">
                    <label class="concern-form-label">Description:</label>
                    <div class="concern-description-guide" id="concernDescriptionGuide">
                        <p><strong>For faster routing:</strong> Include <strong>what happened</strong>, the <strong>exact location or nearby landmark</strong>, <strong>when</strong> you noticed it, and important details such as the affected area or severity. Use specific words like “pothole,” “uncollected garbage,” or “broken streetlight.”</p>
                        <p><strong>Para mas mabilis na maipadala sa tamang tanggapan:</strong> Isama ang <strong>nangyari</strong>, ang <strong>eksaktong lugar o malapit na palatandaan</strong>, <strong>kailan</strong> ito napansin, at mahahalagang detalye tulad ng apektadong bahagi o tindi ng problema. Gumamit ng tiyak na salita gaya ng “lubak,” “hindi nakolektang basura,” o “sirang poste ng ilaw.”</p>
                    </div>
                    <textarea class="concern-textarea" id="concernDescription"
                              name="Description" aria-describedby="concernDescriptionGuide"
                              placeholder="Describe your concern..."></textarea>
                </div>
                
                <span class="text-danger small" id="err-description"></span>

                <!-- Location -->
                <div class="concern-location-row">
                    <label class="concern-form-label">Location:</label>
                    <span class="concern-location-value" id="concernLocationText" aria-live="polite">No location selected</span>
                    <button class="use-map-link" id="useMapBtn" type="button" aria-label="Select the concern location on a map">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
                            <circle cx="12" cy="10" r="2.5" />
                        </svg>
                        <span>Select on map</span>
                    </button>
                </div>
                
                <span class="text-danger small" id="err-location"></span>

                <!-- Attachments -->
                <div class="concern-attachment-row">
                    <label class="concern-form-label">Attachment/s:</label>
                    <button class="concern-upload-btn" type="button" id="concernUploadBtn">
                        <span class="upload-label">Upload</span>
                        <span class="upload-hint">(.jpg .png .mp4 .pdf .doc .docx)</span>
                    </button>
                    <input type="file" id="concernFileInput" name="Attachments"
                           class="create-file-input" multiple accept="image/*,video/*,.pdf,.doc,.docx" />
                    <span class="concern-file-names" id="concernFileNames"></span>
                    <div id="concernAttachmentPreview" class="concern-attachment-preview" aria-live="polite"></div>
                </div>
                <span class="text-danger small" id="err-attachment"></span>

                <!-- Submit -->
                <div class="concern-submit-row">
                    <button class="btn-submit draft-delete-btn" id="concernDeleteDraftBtn" type="button"
                            style="@(Model.SavedConcernDraft == null ? "display:none;" : "display:inline-flex;")">Delete Draft</button>
                    <button class="btn-submit btn-draft" id="concernSaveDraftBtn" type="button">Save Draft</button>
                    <button class="btn-submit" id="concernSubmitBtn" type="button">Submit</button>
                </div>
                <p id="concernDraftStatus" class="draft-status" aria-live="polite"></p>

            </form>

            <div class="success-state" id="concernSuccessState">
                <div class="success-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12" />
                    </svg>
                </div>
                <h3>Concern Submitted!</h3>
                <p>Your concern has been received.<br>We’ll review it and keep you updated.</p>
                <button class="btn-new" id="btnNewConcern" type="button">Submit Another</button>
            </div>
        </div>
    </div>
</div>

<!-- Project Proposal Multi-Step Form -->
<div id="projectView" class="view-section">
    <div class="submission-view-wrap">
        <div class="proposal-card">

            <div class="proposal-card-header">
                <h2>Submit a Citizen Recommendation</h2>
                <p>Vox Angelos: Make your voice heard.</p>
            </div>

            <!-- STEP 1: Problem and Recommendation Details -->
            <div class="step-content active" id="step1">
                <div class="form-group">
                    <label class="form-label bilingual-question" for="projectTitle">
                        <span><strong>What is a clear title for your recommendation?</strong> Keep it short and specific.</span>
                        <span><strong>Ano ang malinaw na pamagat ng inyong rekomendasyon?</strong> Panatilihin itong maikli at tiyak.</span>
                    </label>
                    <input type="text" class="form-input" id="projectTitle" placeholder="Example: Improve drainage near the public market" />
                </div>
                <div class="form-group">
                    <label class="form-label bilingual-question" for="projectJustification">
                        <span><strong>What community problem are you trying to solve?</strong> Tell us what is happening, where it occurs, who is affected, and how it affects daily life, safety, health, or the environment.</span>
                        <span>Anong problema sa komunidad ang nais ninyong maresolba? Ilarawan ang nangyayari, saan ito nagaganap, sino ang naaapektuhan, at paano nito naaapektuhan ang araw-araw na buhay, kaligtasan, kalusugan, o kapaligiran.</span>
                    </label>
                    <textarea class="form-textarea" id="projectJustification" placeholder="Example: Flooding near the public market affects commuters and vendors during heavy rain..."></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label bilingual-question" for="projectDescription">
                        <span><strong>What should the city do, and what improvement do you expect?</strong> Mention the key activities, facilities, or services that should be included.</span>
                        <span><strong>Ano ang iminumungkahi ninyong gawin ng lungsod, at anong pagbabago ang inaasahan ninyo?</strong> Banggitin ang mahahalagang gawain, pasilidad, o serbisyong dapat isama.</span>
                    </label>
                    <textarea class="form-textarea" id="projectDescription" placeholder="Example: Build covered drainage and add waste bins to reduce flooding and improve sanitation..."></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label bilingual-question" for="projectLocation">
                        <span><strong>Where should this recommendation be implemented?</strong> Include the barangay, street, facility, or nearby landmark.</span>
                        <span><strong>Saan dapat ipatupad ang rekomendasyong ito?</strong> Isama ang barangay, kalye, pasilidad, o malapit na palatandaan.</span>
                    </label>
                    <input type="text" class="form-input" id="projectLocation" placeholder="Example: Sto. Rosario, near the public market" />
                </div>
            </div>

            <!-- STEP 2: More Details -->
            <div class="step-content" id="step2">
                <p class="step-question bilingual-question">
                    <span><strong>Who will benefit most from this recommendation?</strong> Select all groups that may benefit.</span>
                    <span><strong>Sino ang pangunahing makikinabang sa rekomendasyong ito?</strong> Piliin ang lahat ng grupong maaaring makinabang.</span>
                </p>

                <div class="form-group">
                    <label class="form-label left">Beneficiary groups / Mga grupong makikinabang</label>
                    <div class="checkbox-group">
                        <label class="checkbox-label"><input type="checkbox" name="beneficiary" value="Local residents" /> Local residents</label>
                        <label class="checkbox-label"><input type="checkbox" name="beneficiary" value="Students" /> Students</label>
                        <label class="checkbox-label"><input type="checkbox" name="beneficiary" value="Businesses" /> Businesses</label>
                        <label class="checkbox-label"><input type="checkbox" name="beneficiary" value="Senior citizens" /> Senior citizens</label>
                        <label class="checkbox-label"><input type="checkbox" name="beneficiary" value="Entire community" /> Entire community</label>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label left bilingual-question" for="peopleAffected">
                        <span><strong>Approximately how many people may benefit?</strong> Give your best estimate.</span>
                        <span><strong>Humigit-kumulang ilang tao ang maaaring makinabang?</strong> Ibigay ang pinakamalapit ninyong tantiya.</span>
                    </label>
                    <input type="number" class="form-input" id="peopleAffected" placeholder="e.g. 500" />
                </div>

                <div class="anonymous-choice">
                    <input type="checkbox" id="recIsAnonymous" />
                    <label for="recIsAnonymous">
                        <span><strong>Post anonymously on Discover</strong> — other citizens will see “Anonymous Citizen” instead of your name.</span>
                        <span>Manatiling anonymous sa Discover — makikita ng ibang mamamayan ang “Anonymous Citizen” sa halip na ang inyong pangalan.</span>
                    </label>
                </div>
                <p class="anonymous-note">Authorized LGU staff can still view your identity when reviewing or following up on the recommendation.</p>

                <div class="form-group">
                    <label class="form-label left bilingual-question">
                        <span><strong>Do you have photos, examples, or documents that support your recommendation?</strong> This is optional.</span>
                        <span><strong>Mayroon ba kayong larawan, halimbawa, o dokumentong sumusuporta sa inyong rekomendasyon?</strong> Opsyonal ito.</span>
                    </label>
                    <button class="upload-btn" type="button" id="uploadBtn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                            <polyline points="17 8 12 3 7 8" />
                            <line x1="12" y1="3" x2="12" y2="15" />
                        </svg>
                        Upload Photo or Document
                    </button>
                    <input type="file" id="fileInput"
                           class="create-file-input"
                           multiple
                           accept="image/*,video/*,.pdf,.doc,.docx" />
                    <p class="file-name-label" id="fileLabel"></p>
                    <div id="recAttachmentPreview" class="rec-attachment-preview" aria-live="polite"></div>
                </div>
            </div>

            <!-- STEP 3: Review -->
            <div class="step-content" id="step3">
                <p class="review-section-title">Review Your Recommendation</p>
                <div class="review-box" id="reviewBox">
                    <div><strong>Justification:</strong> <span id="r-justification"></span></div>
                    <div><strong>Recommendation Title:</strong> <span id="r-title"></span></div>
                    <div><strong>Location:</strong> <span id="r-location"></span></div>
                    <div><strong>Description:</strong> <span id="r-description"></span></div>
                    <br>
                    <div><strong>Beneficiaries:</strong> <span id="r-beneficiaries"></span></div>
                    <div><strong>Est. people affected:</strong> <span id="r-people"></span></div>
                    <div><strong>Privacy:</strong> <span id="r-privacy"></span></div>
                    <div><strong>Attachments:</strong> <div id="r-attachments" class="review-attachments"></div></div>
                </div>
            </div>

            <!-- Success State -->
            <div class="success-state" id="successState">
                <div class="success-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12" />
                    </svg>
                </div>
                <h3>Recommendation Submitted!</h3>
                <p>Your proposed recommendation has been received.<br>We'll review it and get back to you.</p>
                <button class="btn-new" id="btnNewProposal">Submit Another</button>
            </div>

            <!-- Footer -->
            <div class="step-footer" id="stepFooter">
                <span class="step-counter" id="stepCounter">Step 1 of 3</span>
                <div class="footer-actions">
                    <button class="btn-back draft-delete-btn" id="btnDeleteRecommendationDraft" type="button"
                            style="@(Model.SavedRecommendationDraft == null ? "display:none;" : "display:inline-flex;")">Delete Draft</button>
                    <button class="btn-back" id="btnSaveDraft" type="button">Save Draft</button>
                    <button class="btn-back" id="btnBack" style="display:none;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="15 18 9 12 15 6" />
                        </svg>
                        Back
                    </button>
                    <button class="btn-next" id="btnNext">
                        Next
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="9 18 15 12 9 6" />
                        </svg>
                    </button>
                </div>
                <p id="recommendationStatus" class="draft-status" aria-live="polite"></p>
            </div>

        </div>
    </div>
</div>
</div>

<!-- Map Modal -->
<div class="map-modal-overlay" id="mapModalOverlay">
    <div class="map-modal">
        <div class="map-search-row">
            <div id="mapAutocompleteHost" style="flex: 1; min-width: 0;"></div>
        </div>
        <div class="map-boundary-notice" id="mapBoundaryNotice" role="alert" hidden>
            <div class="map-boundary-notice-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 9v4" />
                    <path d="M12 17h.01" />
                    <path d="M10.3 3.7 2.2 18a2 2 0 0 0 1.8 3h16a2 2 0 0 0 1.8-3L13.7 3.7a2 2 0 0 0-3.4 0Z" />
                </svg>
            </div>
            <div class="map-boundary-notice-copy">
                <strong>Outside the service area</strong>
                <span>Please place the pin inside the blue Angeles City boundary.</span>
            </div>
            <button class="map-boundary-notice-close" id="mapBoundaryNoticeClose" type="button" aria-label="Dismiss location warning">&times;</button>
        </div>
        <div id="googleMap" class="google-map"></div>
        <div class="map-modal-footer">
            <span class="map-coord-label">Location/Coordinate:</span>
            <span class="map-coord-value" id="mapCoordDisplay"></span>
            <button class="btn-submit" id="mapConfirmBtn" type="button">Confirm</button>
        </div>
    </div>
</div>

<div class="draft-action-toast" id="draftActionToast" role="status" aria-live="polite" hidden>
    <span id="draftActionToastMessage">Draft saved successfully.</span>
    <div class="draft-action-toast-progress" aria-hidden="true"></div>
</div>

<!-- Delete Draft Confirmation -->
<div class="map-modal-overlay" id="deleteDraftModal" role="dialog" aria-modal="true" aria-labelledby="deleteDraftTitle">
    <div class="map-modal draft-delete-modal">
        <div class="draft-delete-modal-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 6h18" />
                <path d="M8 6V4h8v2" />
                <path d="m19 6-1 14H6L5 6" />
                <path d="M10 11v5M14 11v5" />
            </svg>
        </div>
        <span class="draft-delete-modal-eyebrow">Saved draft</span>
        <h3 id="deleteDraftTitle">Delete this draft?</h3>
        <p id="deleteDraftMessage">This removes the unfinished draft permanently. Submitted records will not be affected.</p>
        <div class="draft-delete-modal-actions">
            <button id="deleteDraftCancelBtn" type="button" class="btn-back">Keep Draft</button>
            <button id="deleteDraftConfirmBtn" type="button" class="btn-submit draft-delete-confirm-btn">Delete Draft</button>
        </div>
    </div>
</div>

<!-- AI Classification Error Modal -->
<div class="map-modal-overlay" id="classificationErrorModal" role="dialog" aria-modal="true" aria-labelledby="classificationErrorTitle">
    <div class="map-modal classification-error-modal">
        <div class="classification-error-icon">!</div>
        <h3 id="classificationErrorTitle" class="classification-error-title">We couldn't categorize your concern</h3>
        <p id="classificationErrorMessage" class="classification-error-message">The AI service could not analyze your concern right now.</p>
        <p class="classification-error-help">Your concern was not sent. Your description, location, and attachments are still saved on this form. You can edit the details and submit again later.</p>
        <div class="classification-error-actions">
            <button id="classificationErrorBackBtn" type="button" class="btn-submit classification-back-btn">Back to Form</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const isDevEnvironment = @Html.Raw(Model.IsDevelopmentEnvironment ? "true" : "false");

        const savedConcernDraft = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
            HasDraft = Model.SavedConcernDraft != null,
            Description = Model.SavedConcernDraft?.Description,
            Category = Model.SavedConcernDraft?.Category,
            LocationName = Model.SavedConcernDraft?.LocationName,
            Latitude = Model.SavedConcernDraft?.Latitude,
            Longitude = Model.SavedConcernDraft?.Longitude
        }));

        const savedRecommendationDraft = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
            HasDraft = Model.SavedRecommendationDraft != null,
            Justification = Model.SavedRecommendationDraft?.Justification,
            Category = Model.SavedRecommendationDraft?.Category,
            Title = Model.SavedRecommendationDraft?.Title,
            Location = Model.SavedRecommendationDraft?.Location,
            Description = Model.SavedRecommendationDraft?.Description,
            Beneficiaries = Model.SavedRecommendationDraft?.Beneficiaries,
            EstimatedPeopleAffected = Model.SavedRecommendationDraft?.EstimatedPeopleAffected,
            IsAnonymous = Model.SavedRecommendationDraft?.IsAnonymous
        }));

        /* ── Tab switching ──────────────────────────── */
        const tabButtons = document.querySelectorAll('.tab-btn');
        const concernView = document.getElementById('concernView');
        const projectView = document.getElementById('projectView');
        const tabIndicator = document.querySelector('.tab-indicator');
        const pageTitle = document.querySelector('.page-title');

        tabButtons.forEach((btn, index) => {
            btn.addEventListener('click', () => {
                tabButtons.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                tabIndicator.style.transform = `translateX(${index * 100}%)`;
                const selectedView = btn.dataset.view;
                if (selectedView === "concern") {
                    concernView.classList.add("active-view");
                    projectView.classList.remove("active-view");
                    pageTitle.textContent = "Submit a Concern";
                } else {
                    concernView.classList.remove("active-view");
                    projectView.classList.add("active-view");
                    pageTitle.textContent = "Submit a Recommendation";
                }
            });
        });
                     
               /* ── Multi-step form ────────────────────────── */
        let currentStep = 1;
        const totalSteps = 3;
        const maximumAttachmentCount = 8;
        let selectedCategory = '';
        const recommendationFormSurface = projectView.querySelector('.proposal-card');
        const createModePanel = document.querySelector('.create-mode-panel');

        function setSubmissionInteractionLock(element, locked) {
            element.inert = locked;
            createModePanel.inert = locked;

            if (locked) {
                element.setAttribute('aria-busy', 'true');
                createModePanel.setAttribute('aria-busy', 'true');
            } else {
                element.removeAttribute('aria-busy');
                createModePanel.removeAttribute('aria-busy');
            }
        }

        const steps = document.querySelectorAll('.step-content');
        const btnBack = document.getElementById('btnBack');
        const btnNext = document.getElementById('btnNext');
        const btnSaveDraft = document.getElementById('btnSaveDraft');
        const btnDeleteRecommendationDraft = document.getElementById('btnDeleteRecommendationDraft');
        const stepCounter = document.getElementById('stepCounter');
        const stepFooter = document.getElementById('stepFooter');
        const successState = document.getElementById('successState');
        const recommendationStatus = document.getElementById('recommendationStatus');
        const draftActionToast = document.getElementById('draftActionToast');
        const draftActionToastMessage = document.getElementById('draftActionToastMessage');
        let draftActionToastTimer = null;

        function hideDraftActionToast() {
            window.clearTimeout(draftActionToastTimer);
            draftActionToast.hidden = true;
        }

        function showDraftActionToast(title, message) {
            window.clearTimeout(draftActionToastTimer);
            draftActionToastMessage.textContent = `${title}. ${message}`;
            draftActionToast.hidden = false;
            draftActionToastTimer = window.setTimeout(hideDraftActionToast, 5000);
        }

        function restoreDraftActionNotice() {
            const rawNotice = sessionStorage.getItem('voxAngelosDraftActionNotice');
            if (!rawNotice) return;
            sessionStorage.removeItem('voxAngelosDraftActionNotice');

            try {
                const notice = JSON.parse(rawNotice);
                const draftLabel = notice.draftType === 'recommendation' ? 'Recommendation' : 'Concern';
                if (notice.action === 'deleted') {
                    showDraftActionToast(`${draftLabel} draft deleted`, 'The Create page is ready for a new submission.');
                }
            } catch { }
        }

        restoreDraftActionNotice();

        // File upload
        const uploadBtn = document.getElementById('uploadBtn');
        const fileInput = document.getElementById('fileInput');
        const fileLabel = document.getElementById('fileLabel');
        const recAttachmentPreview = document.getElementById('recAttachmentPreview');
        let selectedRecommendationFiles = [];
        let recommendationPreviewUrls = [];
        let reviewAttachmentPreviewUrls = [];

        uploadBtn.addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', () => {
            let limitExceeded = false;

            Array.from(fileInput.files).forEach(file => {
                const alreadySelected = selectedRecommendationFiles.some(selected =>
                    selected.name === file.name && selected.size === file.size && selected.lastModified === file.lastModified);

                if (!alreadySelected) {
                    if (selectedRecommendationFiles.length >= maximumAttachmentCount) {
                        limitExceeded = true;
                        return;
                    }

                    selectedRecommendationFiles.push(file);
                }
            });
            syncRecommendationFileInput();
            renderRecommendationAttachmentPreview();

            if (limitExceeded) {
                fileLabel.textContent = `You can upload a maximum of ${maximumAttachmentCount} attachments.`;
                fileLabel.style.color = '#b91c1c';
            }
        });

        function syncRecommendationFileInput() {
            const transfer = new DataTransfer();
            selectedRecommendationFiles.forEach(file => transfer.items.add(file));
            fileInput.files = transfer.files;
        }

        function getDocumentLabel(file) {
            const extension = file.name.split('.').pop()?.toLowerCase();
            if (extension === 'pdf') return 'PDF document';
            if (extension === 'doc' || extension === 'docx') return 'Word document';
            return 'Document';
        }

        function appendRecommendationAttachmentPreview(container, file, previewUrls, canRemove, index) {
            const item = document.createElement('div');
            item.className = canRemove ? 'rec-attachment-item' : 'rec-attachment-item review-attachment-item';

            if (file.type.startsWith('image/')) {
                const image = document.createElement('img');
                const url = URL.createObjectURL(file);
                previewUrls.push(url);
                image.src = url;
                image.alt = `Preview of ${file.name}`;
                item.appendChild(image);
            } else if (file.type.startsWith('video/')) {
                const video = document.createElement('video');
                const url = URL.createObjectURL(file);
                previewUrls.push(url);
                video.src = url;
                video.controls = true;
                video.preload = 'metadata';
                video.setAttribute('aria-label', `Preview of ${file.name}`);
                item.appendChild(video);
            } else {
                const documentCard = document.createElement('div');
                documentCard.className = 'rec-document-preview';
                const documentType = document.createElement('strong');
                documentType.textContent = file.name.split('.').pop()?.toUpperCase() || 'FILE';
                const documentLabel = document.createElement('span');
                documentLabel.textContent = getDocumentLabel(file);
                documentCard.append(documentType, documentLabel);
                item.appendChild(documentCard);
            }

            const name = document.createElement('span');
            name.className = 'rec-attachment-name';
            name.title = file.name;
            name.textContent = file.name;
            item.appendChild(name);

            if (canRemove) {
                const removeButton = document.createElement('button');
                removeButton.type = 'button';
                removeButton.className = 'rec-attachment-remove';
                removeButton.textContent = '×';
                removeButton.title = `Remove ${file.name}`;
                removeButton.setAttribute('aria-label', `Remove ${file.name}`);
                removeButton.addEventListener('click', () => {
                    selectedRecommendationFiles.splice(index, 1);
                    syncRecommendationFileInput();
                    renderRecommendationAttachmentPreview();
                });
                item.appendChild(removeButton);
            }

            container.appendChild(item);
        }

        function renderRecommendationAttachmentPreview() {
            recommendationPreviewUrls.forEach(URL.revokeObjectURL);
            recommendationPreviewUrls = [];
            recAttachmentPreview.innerHTML = '';
            fileLabel.style.color = '';
            fileLabel.textContent = selectedRecommendationFiles.length
                ? `${selectedRecommendationFiles.length} file${selectedRecommendationFiles.length === 1 ? '' : 's'} selected`
                : '';

            selectedRecommendationFiles.forEach((file, index) =>
                appendRecommendationAttachmentPreview(recAttachmentPreview, file, recommendationPreviewUrls, true, index));
        }

        function renderReview() {
            document.getElementById('r-justification').textContent = document.getElementById('projectJustification').value || '—';
            document.getElementById('r-title').textContent = document.getElementById('projectTitle').value || '—';
            document.getElementById('r-location').textContent = document.getElementById('projectLocation').value || '—';
            document.getElementById('r-description').textContent = document.getElementById('projectDescription').value || '—';

            const checked = Array.from(document.querySelectorAll('input[name="beneficiary"]:checked')).map(c => c.value);
            document.getElementById('r-beneficiaries').textContent = checked.length ? checked.join(', ') : '—';
    
            const people = document.getElementById('peopleAffected').value;
            document.getElementById('r-people').textContent = people || '—';
            document.getElementById('r-privacy').textContent = document.getElementById('recIsAnonymous').checked
                ? 'Anonymous on Discover'
                : 'Show my name on Discover';
    
            const attachmentContainer = document.getElementById('r-attachments');
            reviewAttachmentPreviewUrls.forEach(URL.revokeObjectURL);
            reviewAttachmentPreviewUrls = [];
            attachmentContainer.innerHTML = '';

            if (selectedRecommendationFiles.length === 0) {
                attachmentContainer.textContent = 'None';
            } else {
                selectedRecommendationFiles.forEach(file =>
                    appendRecommendationAttachmentPreview(attachmentContainer, file, reviewAttachmentPreviewUrls, false));
            }
        }

        function goToStep(step) {
            steps.forEach(s => s.classList.remove('active'));
            document.getElementById('step' + step).classList.add('active');
            stepCounter.textContent = `Step ${step} of ${totalSteps}`;
            btnBack.style.display = step > 1 ? 'flex' : 'none';

            if (step === totalSteps) {
                renderReview();
                btnNext.innerHTML = 'Submit';
                btnNext.className = 'btn-submit';
            } else {
                btnNext.innerHTML = 'Next <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;"><polyline points="9 18 15 12 9 6"/></svg>';
                btnNext.className = 'btn-next';
            }
        }

        function buildRecommendationFormData(includeAttachments) {
            const formData = new FormData();
            formData.append('RecJustification', document.getElementById('projectJustification').value);
            formData.append('RecCategory', selectedCategory);
            formData.append('RecTitle', document.getElementById('projectTitle').value);
            formData.append('RecLocation', document.getElementById('projectLocation').value);
            formData.append('RecDescription', document.getElementById('projectDescription').value);

            const checked = Array.from(document.querySelectorAll('input[name="beneficiary"]:checked'))
                .map(c => c.value).join(', ');
            formData.append('RecBeneficiaries', checked);
            formData.append('RecPeopleAffected', document.getElementById('peopleAffected').value);
            formData.append('RecIsAnonymous', document.getElementById('recIsAnonymous').checked);

            if (includeAttachments) {
                const files = fileInput.files;
                for (let i = 0; i < files.length; i++) {
                    formData.append('RecAttachments', files[i]);
                }
            }

            formData.append('__RequestVerificationToken',
                document.querySelector('input[name="__RequestVerificationToken"]').value);
            return formData;
        }

        async function readRecommendationResponse(response) {
            const data = await response.json().catch(() => null);
            if (!response.ok || !data?.success) {
                throw new Error(data?.message || data?.error || `Server returned ${response.status}. Please try again.`);
            }

            return data;
        }

        btnSaveDraft.addEventListener('click', async () => {
            recommendationStatus.textContent = '';
            setSubmissionInteractionLock(recommendationFormSurface, true);
            btnSaveDraft.disabled = true;
            btnSaveDraft.textContent = 'Saving...';

            try {
                const response = await fetch('?handler=SaveRecommendationDraft', {
                    method: 'POST',
                    body: buildRecommendationFormData(false)
                });
                const data = await readRecommendationResponse(response);
                recommendationStatus.textContent = `${data.message} Attachments will be uploaded when you submit.`;
                btnDeleteRecommendationDraft.style.display = 'inline-flex';
                showDraftActionToast('Recommendation draft saved', 'Your progress is safe. You can return and continue it later.');
            } catch (error) {
                recommendationStatus.textContent = error.message;
                console.error('Draft save error:', error);
            } finally {
                setSubmissionInteractionLock(recommendationFormSurface, false);
                btnSaveDraft.disabled = false;
                btnSaveDraft.textContent = 'Save Draft';
            }
        });

        let recommendationSubmitting = false;

        btnNext.addEventListener('click', async () => {
            if (currentStep < totalSteps) {
                // Run validation for the current step
                if (validateStep(currentStep)) {
                    currentStep++;
                    goToStep(currentStep);
                }
            } else {
                if (recommendationSubmitting) return;

                recommendationSubmitting = true;
                setSubmissionInteractionLock(recommendationFormSurface, true);
                btnNext.disabled = true;
                btnSaveDraft.disabled = true;
                btnNext.textContent = 'Submitting...';
                recommendationStatus.textContent = '';

                const formData = buildRecommendationFormData(true);

                try {
                    const response = await fetch('?handler=Recommendation', {
                        method: 'POST',
                        body: formData
                    });
                    const data = await readRecommendationResponse(response);

                    if (data.success) {
                        if (isDevEnvironment) {
                            const confidenceLabel = data.confidence != null ? `${(data.confidence * 100).toFixed(1)}%` : 'n/a';
                            console.log(`[VoxAngelos] Recommendation classified via ${data.classifierTier}: office=${data.office}, confidence=${confidenceLabel}`);
                        }
                        setSubmissionInteractionLock(recommendationFormSurface, false);
                        stepFooter.style.display = 'none';
                        steps.forEach(s => s.classList.remove('active'));
                        successState.classList.add('active');
                    }
                } catch (err) {
                    recommendationStatus.textContent = `Recommendation was not sent. ${err.message}`;
                    recommendationStatus.style.color = '#b91c1c';
                    console.error('Submission error:', err);
                    recommendationSubmitting = false;
                    setSubmissionInteractionLock(recommendationFormSurface, false);
                    btnNext.disabled = false;
                    btnSaveDraft.disabled = false;
                    btnNext.textContent = 'Submit';
                }
            }
        });

        function validateStep(step) {
            let isValid = true;

            // Helper to highlight invalid fields
            const invalidate = (el) => {
                el.classList.add('input-error');
                isValid = false;
                // Optional: Add a shake effect or specific error message here
            };

            // Reset previous errors
            document.querySelectorAll('.input-error').forEach(el => el.classList.remove('input-error'));

            if (step === 1) {
                // Validate the combined problem and recommendation details.
                const justification = document.getElementById('projectJustification');
                const title = document.getElementById('projectTitle');
                const loc = document.getElementById('projectLocation');
                const desc = document.getElementById('projectDescription');

                if (!justification.value.trim()) invalidate(justification);
                if (!title.value.trim()) invalidate(title);
                if (!loc.value.trim()) invalidate(loc);
                if (!desc.value.trim()) invalidate(desc);
            }
            else if (step === 2) {
                // Validate Beneficiaries (at least one checked)
                const checked = document.querySelectorAll('input[name="beneficiary"]:checked');
                if (checked.length === 0) {
                    document.querySelector('.checkbox-group').classList.add('input-error');
                    isValid = false;
                }
                // Validate People Affected
                const people = document.getElementById('peopleAffected');
                if (!people.value || people.value <= 0) invalidate(people);
            }

            if (!isValid) {
                console.log("Validation failed for step " + step);
            }
    
            return isValid;
        }

        // Clear error styling when user starts typing/clicking
        document.addEventListener('input', (e) => {
            if (e.target.classList.contains('form-input') || e.target.classList.contains('form-textarea')) {
                e.target.classList.remove('input-error');
            }
        });

        btnBack.addEventListener('click', () => {
            if (currentStep > 1) {
                currentStep--;
                goToStep(currentStep);
                stepFooter.style.display = 'flex';
            }
        });

        document.getElementById('btnNewProposal').addEventListener('click', () => {
            currentStep = 1;
            selectedCategory = '';
            recommendationSubmitting = false;
            setSubmissionInteractionLock(recommendationFormSurface, false);
            btnNext.disabled = false;
            btnSaveDraft.disabled = false;
            btnNext.textContent = 'Next';
            recommendationStatus.textContent = '';
            document.getElementById('projectJustification').value = '';
            document.getElementById('projectTitle').value = '';
            document.getElementById('projectLocation').value = '';
            document.getElementById('projectDescription').value = '';
            document.querySelectorAll('input[name="beneficiary"]').forEach(c => c.checked = false);
            document.getElementById('peopleAffected').value = '';
            document.getElementById('recIsAnonymous').checked = false;
            selectedRecommendationFiles = [];
            syncRecommendationFileInput();
            renderRecommendationAttachmentPreview();
            successState.classList.remove('active');
            stepFooter.style.display = 'flex';
            goToStep(1);
        });

        function restoreSavedRecommendationDraft() {
            if (!savedRecommendationDraft.HasDraft) return;

            document.getElementById('projectJustification').value = savedRecommendationDraft.Justification || '';
            document.getElementById('projectTitle').value = savedRecommendationDraft.Title || '';
            document.getElementById('projectLocation').value = savedRecommendationDraft.Location || '';
            document.getElementById('projectDescription').value = savedRecommendationDraft.Description || '';
            document.getElementById('peopleAffected').value = savedRecommendationDraft.EstimatedPeopleAffected || '';
            document.getElementById('recIsAnonymous').checked = savedRecommendationDraft.IsAnonymous === true;

            const savedBeneficiaries = (savedRecommendationDraft.Beneficiaries || '')
                .split(',')
                .map(value => value.trim());
            document.querySelectorAll('input[name="beneficiary"]').forEach(checkbox => {
                checkbox.checked = savedBeneficiaries.includes(checkbox.value);
            });

            if (!savedConcernDraft.HasDraft) {
                tabButtons.forEach(button => {
                    button.classList.toggle('active', button.dataset.view === 'project');
                });
                concernView.classList.remove('active-view');
                projectView.classList.add('active-view');
                tabIndicator.style.transform = 'translateX(100%)';
                pageTitle.textContent = 'Continue Your Recommendation Draft';
            }
            recommendationStatus.textContent = 'Your saved draft has been restored. Attachments upload when you submit.';
        }

        restoreSavedRecommendationDraft();
        goToStep(1);

               /* ── Concern form ───────────────────────────── */
        const useMapBtn = document.getElementById('useMapBtn');
        const mapModalOverlay = document.getElementById('mapModalOverlay');
        const mapConfirmBtn = document.getElementById('mapConfirmBtn');
        const concernLocationText = document.getElementById('concernLocationText');
        const mapCoordDisplay = document.getElementById('mapCoordDisplay');
        const mapBoundaryNotice = document.getElementById('mapBoundaryNotice');
        const mapBoundaryNoticeClose = document.getElementById('mapBoundaryNoticeClose');

        let selectedLat = null;
        let selectedLng = null;
        let selectedAddress = '';
        let map, marker, autocompleteEl;
        let locationValidationPending = false;
        let hasValidMapSelection = false;
        let lastValidPosition = null;
        let angelesBoundaryFeatures = [];
        let angelesBoundaryGeoJson = null;
        let mapBoundaryNoticeTimer = null;
        const angelesBoundaryPromise = fetch('/geojson/angeles-city-barangays.geojson')
            .then(response => {
                if (!response.ok) throw new Error('Boundary file unavailable.');
                return response.json();
            })
            .then(geoJson => {
                angelesBoundaryGeoJson = geoJson;
                angelesBoundaryFeatures = geoJson.features || [];
                return angelesBoundaryFeatures;
            });


        useMapBtn.addEventListener('click', () => {
            mapModalOverlay.classList.add('active');
            if (!map) {
                initMap();
            }
        });

        function initMap() {
            const defaultCenter = { lat: 15.1450, lng: 120.5887 };
            const initialCenter = selectedLat !== null && selectedLng !== null
                ? { lat: selectedLat, lng: selectedLng }
                : defaultCenter;

            // Angeles City bounds
            const angelesBounds = new google.maps.LatLngBounds(
                new google.maps.LatLng(15.1084, 120.4491), // SW edge of saved barangay polygons
                new google.maps.LatLng(15.2226, 120.6427)  // NE edge of saved barangay polygons
            );

            map = new google.maps.Map(document.getElementById('googleMap'), {
                center: initialCenter,
                zoom: 14,
                restriction: {
                    latLngBounds: angelesBounds,
                    strictBounds: true  // hard lock — cannot pan outside
                }
            });

            angelesBoundaryPromise.then(() => {
                map.data.addGeoJson(angelesBoundaryGeoJson);
                map.data.setStyle({
                    fillColor: '#1d4ed8',
                    fillOpacity: 0.04,
                    strokeColor: '#1d4ed8',
                    strokeOpacity: 0.65,
                    strokeWeight: 1,
                    clickable: true
                });

                // Google Maps sends clicks on GeoJSON features to the Data layer
                // instead of the base map. Route those clicks through the same pin
                // selection flow so citizens can click anywhere inside a barangay.
                map.data.addListener('click', event => {
                    validateAndApplyLocation(event.latLng);
                });
            }).catch(() => { });

            marker = new google.maps.Marker({
                position: initialCenter,
                map: map,
                draggable: true
            });

            lastValidPosition = new google.maps.LatLng(defaultCenter);

            // Click on map to move marker
            map.addListener('click', (e) => {
                validateAndApplyLocation(e.latLng);
            });

            // Drag marker
            marker.addListener('dragend', (e) => {
                validateAndApplyLocation(e.latLng);
            });

            // Set initial values when there is no saved concern location.
            if (selectedLat === null || selectedLng === null) {
                selectedAddress = '';
                mapConfirmBtn.disabled = true;
                mapCoordDisplay.textContent = 'Click or drag the pin to choose a location within Angeles City.';
            } else {
                const savedPosition = new google.maps.LatLng(selectedLat, selectedLng);
                selectedLat = null;
                selectedLng = null;
                selectedAddress = '';
                validateAndApplyLocation(savedPosition, false);
            }

            async function applySelectedLocation(latLng) {
                if (!angelesBounds.contains(latLng)) {
                    showOutsideAngelesMessage();
                    return false;
                }

                return validateAndApplyLocation(latLng);
            }

            // Use the current Places API (New) autocomplete widget. The older
            // google.maps.places.Autocomplete widget is unavailable to new customers.
            async function setupPlaceAutocomplete() {
                const { PlaceAutocompleteElement } = await google.maps.importLibrary('places');
                const autocompleteHost = document.getElementById('mapAutocompleteHost');

                autocompleteEl = new PlaceAutocompleteElement();
                autocompleteEl.placeholder = 'Start typing a street, barangay, landmark, or establishment...';
                autocompleteEl.includedRegionCodes = ['ph'];
                autocompleteEl.locationRestriction = angelesBounds;
                autocompleteEl.style.width = '100%';

                autocompleteHost.replaceChildren(autocompleteEl);

                autocompleteEl.addEventListener('gmp-select', async ({ placePrediction }) => {
                    const place = placePrediction.toPlace();
                    await place.fetchFields({ fields: ['displayName', 'formattedAddress', 'location'] });

                    if (!place.location) {
                        return;
                    }

                    await applySelectedLocation(place.location);
                });
            }

            setupPlaceAutocomplete().catch(() => {
                mapCoordDisplay.textContent = 'Location search is currently unavailable. You can still place the pin manually.';
            });
        }

        function isPointInRing(longitude, latitude, ring) {
            let inside = false;
            for (let current = 0, previous = ring.length - 1;
                 current < ring.length;
                 previous = current++) {
                const [currentLongitude, currentLatitude] = ring[current];
                const [previousLongitude, previousLatitude] = ring[previous];
                const crossesLatitude = (currentLatitude > latitude) !== (previousLatitude > latitude);

                if (crossesLatitude && longitude <
                    (previousLongitude - currentLongitude) * (latitude - currentLatitude) /
                    (previousLatitude - currentLatitude) + currentLongitude) {
                    inside = !inside;
                }
            }
            return inside;
        }

        function isPointInPolygon(longitude, latitude, polygon) {
            if (!polygon.length || !isPointInRing(longitude, latitude, polygon[0])) return false;
            return !polygon.slice(1).some(hole => isPointInRing(longitude, latitude, hole));
        }

        function isWithinAngelesBoundary(latitude, longitude) {
            return angelesBoundaryFeatures.some(feature => {
                const { type, coordinates } = feature.geometry || {};
                if (type === 'Polygon') return isPointInPolygon(longitude, latitude, coordinates);
                if (type === 'MultiPolygon') {
                    return coordinates.some(polygon => isPointInPolygon(longitude, latitude, polygon));
                }
                return false;
            });
        }

        function showOutsideAngelesMessage() {
            marker.setPosition(lastValidPosition);
            mapCoordDisplay.textContent = 'Outside Angeles City. Please choose a location within Angeles City only.';
            window.clearTimeout(mapBoundaryNoticeTimer);
            mapBoundaryNotice.hidden = false;
            mapBoundaryNotice.classList.remove('is-visible');
            requestAnimationFrame(() => mapBoundaryNotice.classList.add('is-visible'));
            mapBoundaryNoticeTimer = window.setTimeout(hideMapBoundaryNotice, 6500);
        }

        function hideMapBoundaryNotice() {
            window.clearTimeout(mapBoundaryNoticeTimer);
            mapBoundaryNotice.classList.remove('is-visible');
            window.setTimeout(() => {
                if (!mapBoundaryNotice.classList.contains('is-visible')) {
                    mapBoundaryNotice.hidden = true;
                }
            }, 180);
        }

        mapBoundaryNoticeClose.addEventListener('click', hideMapBoundaryNotice);

        async function validateAndApplyLocation(latLng, focusMap = true) {
            if (locationValidationPending) return Promise.resolve(false);

            locationValidationPending = true;
            mapConfirmBtn.disabled = true;
            mapCoordDisplay.textContent = 'Checking location...';

            try {
                await angelesBoundaryPromise;
            } catch {
                locationValidationPending = false;
                mapConfirmBtn.disabled = !hasValidMapSelection;
                marker.setPosition(lastValidPosition);
                mapCoordDisplay.textContent = 'The Angeles City boundary could not be loaded. Please reopen the map and try again.';
                return false;
            }

            if (!isWithinAngelesBoundary(latLng.lat(), latLng.lng())) {
                locationValidationPending = false;
                mapConfirmBtn.disabled = !hasValidMapSelection;
                showOutsideAngelesMessage();
                return false;
            }

            const geocoder = new google.maps.Geocoder();
            return new Promise(resolve => geocoder.geocode({ location: latLng }, (results, status) => {
                locationValidationPending = false;
                hasValidMapSelection = true;
                mapConfirmBtn.disabled = false;

                marker.setPosition(latLng);
                lastValidPosition = latLng;
                selectedLat = latLng.lat();
                selectedLng = latLng.lng();
                selectedAddress = status === 'OK' && results[0]
                    ? results[0].formatted_address
                    : `${selectedLat.toFixed(6)}, ${selectedLng.toFixed(6)}`;
                mapCoordDisplay.textContent = selectedAddress;

                if (focusMap) {
                    map.panTo(latLng);
                    map.setZoom(16);
                }

                resolve(true);
            }));
        }

        mapConfirmBtn.addEventListener('click', () => {
            if (locationValidationPending || !hasValidMapSelection ||
                selectedLat === null || selectedLng === null || !selectedAddress) return;

            concernLocationText.textContent = selectedAddress;
            document.getElementById('hdnLocationName').value = selectedAddress;
            document.getElementById('hdnLatitude').value = selectedLat;
            document.getElementById('hdnLongitude').value = selectedLng;
            document.querySelector('.concern-location-row').classList.remove('input-error');
            document.getElementById('err-location').textContent = '';
            mapModalOverlay.classList.remove('active');
        });

        // Only close on a genuine click on the backdrop itself — not a map-drag
        // (mousedown inside the map, mouseup outside it) which the browser would
        // otherwise resolve to a "click" on this overlay and wrongly dismiss it.
        let mapOverlayMouseDownOnBackdrop = false;
        mapModalOverlay.addEventListener('mousedown', (e) => {
            mapOverlayMouseDownOnBackdrop = (e.target === mapModalOverlay);
        });
        mapModalOverlay.addEventListener('mouseup', (e) => {
            if (mapOverlayMouseDownOnBackdrop && e.target === mapModalOverlay) {
                mapModalOverlay.classList.remove('active');
            }
            mapOverlayMouseDownOnBackdrop = false;
        });

        // Concern file upload
        const concernUploadBtn = document.getElementById('concernUploadBtn');
        const concernFileInput = document.getElementById('concernFileInput');
        const concernFileNames = document.getElementById('concernFileNames');
        const concernAttachmentPreview = document.getElementById('concernAttachmentPreview');
        const concernSaveDraftBtn = document.getElementById('concernSaveDraftBtn');
        const concernDeleteDraftBtn = document.getElementById('concernDeleteDraftBtn');
        const concernDraftStatus = document.getElementById('concernDraftStatus');
        let selectedConcernFiles = [];
        let selectedConcernCategory = '';
        let concernPreviewUrls = [];

        concernUploadBtn.addEventListener('click', () => concernFileInput.click());
        concernFileInput.addEventListener('change', () => {
            const newlySelectedFiles = Array.from(concernFileInput.files);
            let limitExceeded = false;

            newlySelectedFiles.forEach(file => {
                const isAlreadySelected = selectedConcernFiles.some(selectedFile =>
                    selectedFile.name === file.name &&
                    selectedFile.size === file.size &&
                    selectedFile.lastModified === file.lastModified);

                if (!isAlreadySelected) {
                    if (selectedConcernFiles.length >= maximumAttachmentCount) {
                        limitExceeded = true;
                        return;
                    }

                    selectedConcernFiles.push(file);
                }
            });

            syncConcernFileInput();
            renderConcernAttachmentPreview();
            document.getElementById('err-attachment').textContent = limitExceeded
                ? `You can upload a maximum of ${maximumAttachmentCount} attachments.`
                : '';

            if (selectedConcernFiles.length > 0) {
                concernUploadBtn.classList.remove('input-error');
            }
        });

        function syncConcernFileInput() {
            const transfer = new DataTransfer();
            selectedConcernFiles.forEach(file => transfer.items.add(file));
            concernFileInput.files = transfer.files;
        }

        function renderConcernAttachmentPreview() {
            concernPreviewUrls.forEach(URL.revokeObjectURL);
            concernPreviewUrls = [];
            concernAttachmentPreview.innerHTML = '';
            concernFileNames.textContent = selectedConcernFiles.length
                ? `${selectedConcernFiles.length} file${selectedConcernFiles.length === 1 ? '' : 's'} selected`
                : '';

            selectedConcernFiles.forEach((file, index) => {
                const item = document.createElement('div');
                item.className = 'concern-attachment-item';

                if (file.type.startsWith('image/')) {
                    const image = document.createElement('img');
                    const url = URL.createObjectURL(file);
                    concernPreviewUrls.push(url);
                    image.src = url;
                    image.alt = `Preview of ${file.name}`;
                    item.appendChild(image);
                } else if (file.type.startsWith('video/')) {
                    const video = document.createElement('video');
                    const url = URL.createObjectURL(file);
                    concernPreviewUrls.push(url);
                    video.src = url;
                    video.controls = true;
                    video.preload = 'metadata';
                    video.setAttribute('aria-label', `Preview of ${file.name}`);
                    item.appendChild(video);
                } else {
                    const placeholder = document.createElement('div');
                    placeholder.className = 'concern-file-placeholder';
                    placeholder.textContent = 'PDF document';
                    item.appendChild(placeholder);
                }

                const name = document.createElement('span');
                name.className = 'concern-attachment-name';
                name.title = file.name;
                name.textContent = file.name;
                item.appendChild(name);

                const removeButton = document.createElement('button');
                removeButton.type = 'button';
                removeButton.className = 'concern-attachment-remove';
                removeButton.textContent = '×';
                removeButton.title = `Remove ${file.name}`;
                removeButton.setAttribute('aria-label', `Remove ${file.name}`);
                removeButton.addEventListener('click', () => {
                    selectedConcernFiles.splice(index, 1);
                    syncConcernFileInput();
                    renderConcernAttachmentPreview();
                    document.getElementById('err-attachment').textContent = '';
                });
                item.appendChild(removeButton);
                concernAttachmentPreview.appendChild(item);
            });
        }

        function buildConcernDraftFormData() {
            const formData = new FormData();
            formData.append('Description', document.getElementById('concernDescription').value);
            formData.append('ConcernCategoryHint', selectedConcernCategory);
            formData.append('LocationName', document.getElementById('hdnLocationName').value);
            formData.append('Latitude', document.getElementById('hdnLatitude').value);
            formData.append('Longitude', document.getElementById('hdnLongitude').value);
            formData.append('__RequestVerificationToken',
                document.querySelector('input[name="__RequestVerificationToken"]').value);
            return formData;
        }

        concernSaveDraftBtn.addEventListener('click', async () => {
            concernDraftStatus.textContent = '';
            setSubmissionInteractionLock(concernForm, true);
            concernSaveDraftBtn.disabled = true;
            concernSaveDraftBtn.textContent = 'Saving...';

            try {
                const response = await fetch('?handler=SaveConcernDraft', {
                    method: 'POST',
                    body: buildConcernDraftFormData()
                });
                const data = await response.json().catch(() => null);
                if (!response.ok || !data?.success) {
                    throw new Error(data?.message || data?.error || `Server returned ${response.status}. Please try again.`);
                }

                concernDraftStatus.textContent = `${data.message} Attachments will be uploaded when you submit.`;
                concernDeleteDraftBtn.style.display = 'inline-flex';
                showDraftActionToast('Concern draft saved', 'Your progress is safe. You can return and continue it later.');
            } catch (error) {
                concernDraftStatus.textContent = error.message;
                console.error('Concern draft save error:', error);
            } finally {
                setSubmissionInteractionLock(concernForm, false);
                concernSaveDraftBtn.disabled = false;
                concernSaveDraftBtn.textContent = 'Save Draft';
            }
        });

        function restoreSavedConcernDraft() {
            if (!savedConcernDraft.HasDraft) return;

            document.getElementById('concernDescription').value = savedConcernDraft.Description || '';
            document.getElementById('hdnLocationName').value = savedConcernDraft.LocationName || '';
            document.getElementById('hdnLatitude').value = savedConcernDraft.Latitude ?? '';
            document.getElementById('hdnLongitude').value = savedConcernDraft.Longitude ?? '';

            if (savedConcernDraft.LocationName) {
                selectedAddress = savedConcernDraft.LocationName;
                concernLocationText.textContent = savedConcernDraft.LocationName;
            }
            if (savedConcernDraft.Latitude != null && savedConcernDraft.Longitude != null) {
                selectedLat = savedConcernDraft.Latitude;
                selectedLng = savedConcernDraft.Longitude;
            }

            pageTitle.textContent = 'Continue Your Concern Draft';
            concernDraftStatus.textContent = 'Your saved draft has been restored. Attachments upload when you submit.';
        }

        restoreSavedConcernDraft();

        const deleteDraftModal = document.getElementById('deleteDraftModal');
        const deleteDraftMessage = document.getElementById('deleteDraftMessage');
        const deleteDraftCancelBtn = document.getElementById('deleteDraftCancelBtn');
        const deleteDraftConfirmBtn = document.getElementById('deleteDraftConfirmBtn');
        let pendingDraftType = null;

        function openDeleteDraftModal(draftType) {
            pendingDraftType = draftType;
            deleteDraftMessage.textContent = draftType === 'recommendation'
                ? 'This permanently removes your unfinished recommendation. Submitted recommendations will not be affected.'
                : 'This permanently removes your unfinished concern. Submitted concerns will not be affected.';
            deleteDraftModal.classList.add('active');
            deleteDraftCancelBtn.focus();
        }

        function closeDeleteDraftModal() {
            if (deleteDraftConfirmBtn.disabled) return;
            pendingDraftType = null;
            deleteDraftModal.classList.remove('active');
        }

        btnDeleteRecommendationDraft.addEventListener('click', () => openDeleteDraftModal('recommendation'));
        concernDeleteDraftBtn.addEventListener('click', () => openDeleteDraftModal('concern'));
        deleteDraftCancelBtn.addEventListener('click', closeDeleteDraftModal);
        deleteDraftModal.addEventListener('click', event => {
            if (event.target === deleteDraftModal) closeDeleteDraftModal();
        });

        deleteDraftConfirmBtn.addEventListener('click', async () => {
            if (!pendingDraftType || deleteDraftConfirmBtn.disabled) return;

            const draftType = pendingDraftType;
            const handler = draftType === 'recommendation'
                ? 'DeleteRecommendationDraft'
                : 'DeleteConcernDraft';

            deleteDraftConfirmBtn.disabled = true;
            deleteDraftCancelBtn.disabled = true;
            deleteDraftConfirmBtn.textContent = 'Deleting...';

            try {
                const response = await fetch(`?handler=${handler}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
                const data = await response.json().catch(() => null);
                if (!response.ok || !data?.success) {
                    throw new Error(data?.message || 'The draft could not be deleted. Please try again.');
                }

                sessionStorage.setItem('voxAngelosDraftActionNotice', JSON.stringify({
                    action: 'deleted',
                    draftType
                }));
                window.location.replace(window.location.pathname);
            } catch (error) {
                const statusElement = draftType === 'recommendation' ? recommendationStatus : concernDraftStatus;
                statusElement.textContent = error.message;
                deleteDraftModal.classList.remove('active');
                deleteDraftConfirmBtn.disabled = false;
                deleteDraftCancelBtn.disabled = false;
                deleteDraftConfirmBtn.textContent = 'Delete Draft';
            }
        });

        function restoreLandingDraft() {
            const query = new URLSearchParams(window.location.search);
            if (query.get('landingDraft') !== '1') return;

            let landingDraft;
            try {
                landingDraft = JSON.parse(sessionStorage.getItem('voxAngelosLandingDraft'));
            } catch {
                sessionStorage.removeItem('voxAngelosLandingDraft');
                return;
            }

            if (!landingDraft || !['concern', 'recommendation'].includes(landingDraft.mode)) {
                sessionStorage.removeItem('voxAngelosLandingDraft');
                return;
            }

            const isRecommendation = landingDraft.mode === 'recommendation';
            const targetTab = Array.from(tabButtons)
                .find(button => button.dataset.view === (isRecommendation ? 'project' : 'concern'));
            const targetInput = document.getElementById(isRecommendation
                ? 'projectJustification'
                : 'concernDescription');
            const targetStatus = isRecommendation ? recommendationStatus : concernDraftStatus;
            const landingMessage = typeof landingDraft.message === 'string'
                ? landingDraft.message.trim()
                : '';

            targetTab?.click();

            if (landingMessage && targetInput && !targetInput.value.trim()) {
                targetInput.value = landingMessage;
                targetInput.dispatchEvent(new Event('input', { bubbles: true }));
                targetStatus.textContent = 'Your text from the home page has been restored. Complete the remaining details before submitting.';
                sessionStorage.removeItem('voxAngelosLandingDraft');
            } else if (landingMessage && targetInput?.value.trim()) {
                targetStatus.textContent = 'Your existing saved draft was kept so it would not be overwritten.';
            } else {
                targetStatus.textContent = `Continue by completing your ${isRecommendation ? 'recommendation' : 'concern'} details.`;
                sessionStorage.removeItem('voxAngelosLandingDraft');
            }

            query.delete('landingDraft');
            const remainingQuery = query.toString();
            history.replaceState(null, '', `${window.location.pathname}${remainingQuery ? `?${remainingQuery}` : ''}${window.location.hash}`);
            targetInput?.focus();
        }

        restoreLandingDraft();

        // Concern submit
                // Hidden fields for confirmed category
        let confirmedCategory = '';
        let concernSubmitting = false;
        const classificationErrorModal = document.getElementById('classificationErrorModal');
        const classificationErrorMessage = document.getElementById('classificationErrorMessage');
        const concernForm = document.getElementById('concernForm');
        const concernSuccessState = document.getElementById('concernSuccessState');
        const concernDescriptionInput = document.getElementById('concernDescription');
        const concernLocationRow = document.querySelector('.concern-location-row');
        const concernSubmitButton = document.getElementById('concernSubmitBtn');

        function resetConcernSubmissionState() {
            concernSubmitting = false;
            setSubmissionInteractionLock(concernForm, false);
            concernSubmitButton.textContent = 'Submit';
            concernSubmitButton.disabled = false;
            concernSaveDraftBtn.disabled = false;
        }

        concernDescriptionInput.addEventListener('input', () => {
            if (concernDescriptionInput.value.trim()) {
                concernDescriptionInput.classList.remove('input-error');
                document.getElementById('err-description').textContent = '';
            }
        });

        function showClassificationError(message) {
            classificationErrorMessage.textContent = message;
            classificationErrorModal.classList.add('active');
        }

        // Concern submit — Step 1: validate then classify
        concernSubmitButton.addEventListener('click', async () => {
            if (concernSubmitting) return;

            let valid = true;

            document.getElementById('err-description').textContent = '';
            document.getElementById('err-location').textContent = '';
            document.getElementById('err-attachment').textContent = '';
            concernDescriptionInput.classList.remove('input-error');
            concernLocationRow.classList.remove('input-error');
            concernUploadBtn.classList.remove('input-error');

            const desc = concernDescriptionInput.value.trim();
            if (!desc) {
                document.getElementById('err-description').textContent = 'Could you describe the concern? Every detail helps the city respond faster.';
                concernDescriptionInput.classList.add('input-error');
                valid = false;
            }

            const location = document.getElementById('hdnLocationName').value.trim();
            if (!location) {
                document.getElementById('err-location').textContent = 'We need to know where this is happening. Please drop a pin on the map.';
                concernLocationRow.classList.add('input-error');
                valid = false;
            }

            const files = document.getElementById('concernFileInput').files;
            if (!files || files.length === 0) {
                document.getElementById('err-attachment').textContent = 'A photo or video helps us verify the situation. Please attach at least one.';
                concernUploadBtn.classList.add('input-error');
                valid = false;
            }

            if (!valid) return;

            // Show loading state
            const submitBtn = concernSubmitButton;
            concernSubmitting = true;
            setSubmissionInteractionLock(concernForm, true);
            submitBtn.textContent = 'Analyzing...';
            submitBtn.disabled = true;
            concernSaveDraftBtn.disabled = true;
            let submissionSucceeded = false;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch('?handler=Classify', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ description: desc })
                });

                const result = await response.json();

                if (result.success) {
                    confirmedCategory = result.category;
                    if (isDevEnvironment) {
                        const confidenceLabel = result.confidence != null ? `${(result.confidence * 100).toFixed(1)}%` : 'n/a';
                        console.log(`[VoxAngelos] Concern classified via ${result.classifierTier}: category=${result.category}, office=${result.office}, confidence=${confidenceLabel}`);
                    }

                    submitBtn.textContent = 'Submitting...';
                    await submitConfirmedConcern();
                    submissionSucceeded = true;
                } else {
                    showClassificationError(result.message || 'The AI service could not categorize your concern right now. Please try again in a moment.');
                }
            } catch (e) {
                showClassificationError('We could not connect to the AI service. Please check your connection and try again.');
            } finally {
                if (!submissionSucceeded) {
                    concernSubmitting = false;
                    setSubmissionInteractionLock(concernForm, false);
                    submitBtn.textContent = 'Submit';
                    submitBtn.disabled = false;
                    concernSaveDraftBtn.disabled = false;
                }
            }
        });

        // Submit with the AI-determined routing category.
        async function submitConfirmedConcern() {
            const form = concernForm;

            // Add hidden fields for confirmed category/office
            let catField = document.getElementById('ConfirmedCategory');
            if (!catField) {
                catField = document.createElement('input');
                catField.type = 'hidden';
                catField.id = 'ConfirmedCategory';
                catField.name = 'ConfirmedCategory';
                form.appendChild(catField);
            }
            catField.value = confirmedCategory;

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const response = await fetch(window.location.pathname, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: new FormData(form)
            });

            const result = await response.json().catch(() => ({
                success: false,
                message: 'The server returned an unexpected response. Please try again.'
            }));

            if (!response.ok || !result.success) {
                throw new Error(result.message || 'Your concern could not be submitted. Please try again.');
            }

            setSubmissionInteractionLock(form, false);
            form.style.display = 'none';
            concernSuccessState.classList.add('active');
        }

        document.getElementById('btnNewConcern').addEventListener('click', () => {
            resetConcernSubmissionState();
            concernForm.reset();
            selectedConcernFiles = [];
            syncConcernFileInput();
            renderConcernAttachmentPreview();
            selectedConcernCategory = '';
            confirmedCategory = '';
            concernLocationText.textContent = 'No location selected';
            selectedAddress = '';
            selectedLat = null;
            selectedLng = null;
            concernDraftStatus.textContent = '';
            document.getElementById('err-description').textContent = '';
            document.getElementById('err-location').textContent = '';
            document.getElementById('err-attachment').textContent = '';
            concernSuccessState.classList.remove('active');
            concernForm.style.display = '';
            document.getElementById('concernDescription').focus();
        });

        // Browsers can restore this page from their back/forward cache with the old
        // disabled "Submitting..." button. Always restore an editable form on return.
        window.addEventListener('pageshow', event => {
            if (event.persisted && !concernSuccessState.classList.contains('active')) {
                resetConcernSubmissionState();
            }
        });

        document.getElementById('classificationErrorBackBtn').addEventListener('click', () => {
            classificationErrorModal.classList.remove('active');
            document.getElementById('concernDescription').focus();
        });
    </script>
    <script src="https://maps.googleapis.com/maps/api/js?key=@Model.GoogleMapsApiKey&libraries=places&v=beta&callback=initMap" async defer></script>
   
}
