        // Concern submit — Step 1: validate then classify
        document.getElementById('concernSubmitBtn').addEventListener('click', async () => {
            if (concernSubmitting) return;

            let valid = true;

            document.getElementById('err-description').textContent = '';
            document.getElementById('err-location').textContent = '';
            document.getElementById('err-attachment').textContent = '';

            const desc = document.getElementById('concernDescription').value.trim();
            if (!desc) {
                document.getElementById('err-description').textContent = 'Could you describe the concern? Every detail helps the city respond faster.';
                valid = false;
            }

            const location = document.getElementById('hdnLocationName').value.trim();
            if (!location) {
                document.getElementById('err-location').textContent = 'We need to know where this is happening. Please drop a pin on the map.';
                valid = false;
            }

            const files = document.getElementById('concernFileInput').files;
            if (!files || files.length === 0) {
                document.getElementById('err-attachment').textContent = 'A photo or video helps us verify the situation. Please attach at least one.';
                valid = false;
            }

            if (!valid) return;

            // Show loading state
            const submitBtn = document.getElementById('concernSubmitBtn');
            concernSubmitting = true;
            submitBtn.textContent = 'Analyzing...';
            submitBtn.disabled = true;
            concernSaveDraftBtn.disabled = true;
            let submissionSucceeded = false;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch('?handler=Classify', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ description: desc })
                });

                const result = await response.json();

                if (result.success) {
                    confirmedCategory = result.category;

                    submitBtn.textContent = 'Submitting...';
                    await submitConfirmedConcern();
                    submissionSucceeded = true;
                } else {
                    showClassificationError('The AI service could not categorize your concern right now. Please try again in a moment.');
                }
            } catch (e) {
                showClassificationError('We could not connect to the AI service. Please check your connection and try again.');
            } finally {
                if (!submissionSucceeded) {
                    concernSubmitting = false;
                    submitBtn.textContent = 'Submit';
                    submitBtn.disabled = false;
                    concernSaveDraftBtn.disabled = false;
                }
            }
        });

        // Submit with the AI-determined routing category.
        async function submitConfirmedConcern() {
            const form = concernForm;

            // Add hidden fields for confirmed category/office
            let catField = document.getElementById('ConfirmedCategory');
            if (!catField) {
                catField = document.createElement('input');
                catField.type = 'hidden';
                catField.id = 'ConfirmedCategory';
                catField.name = 'ConfirmedCategory';
                form.appendChild(catField);
            }
            catField.value = confirmedCategory;

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const response = await fetch(window.location.pathname, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: new FormData(form)
            });

            const result = await response.json().catch(() => ({
                success: false,
                message: 'The server returned an unexpected response. Please try again.'
            }));

            if (!response.ok || !result.success) {
                throw new Error(result.message || 'Your concern could not be submitted. Please try again.');
            }

            form.style.display = 'none';
            concernSuccessState.classList.add('active');
        }

        document.getElementById('btnNewConcern').addEventListener('click', () => {
            concernForm.reset();
            selectedConcernFiles = [];
            syncConcernFileInput();
            renderConcernAttachmentPreview();
            selectedConcernCategory = '';
            confirmedCategory = '';
            document.querySelectorAll('.concern-category-btn').forEach(button => button.classList.remove('selected'));
            concernLocationText.textContent = 'No location selected';
            selectedAddress = '';
            selectedLat = null;
            selectedLng = null;
            concernDraftStatus.textContent = '';
            document.getElementById('err-description').textContent = '';
            document.getElementById('err-location').textContent = '';
            document.getElementById('err-attachment').textContent = '';
            concernSuccessState.classList.remove('active');
            concernForm.style.display = '';
            document.getElementById('concernDescription').focus();
        });

        document.getElementById('classificationErrorBackBtn').addEventListener('click', () => {
            classificationErrorModal.classList.remove('active');
            document.getElementById('concernDescription').focus();
        });
    </script>
    <script src="https://maps.googleapis.com/maps/api/js?key=@Model.GoogleMapsApiKey&libraries=places&v=beta&callback=initMap" async defer></script>
   
}
