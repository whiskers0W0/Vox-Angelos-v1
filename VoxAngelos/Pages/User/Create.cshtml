        concernUploadBtn.addEventListener('click', () => concernFileInput.click());
        concernFileInput.addEventListener('change', () => {
            const newlySelectedFiles = Array.from(concernFileInput.files);
            newlySelectedFiles.forEach(file => {
                const isAlreadySelected = selectedConcernFiles.some(selectedFile =>
                    selectedFile.name === file.name &&
                    selectedFile.size === file.size &&
