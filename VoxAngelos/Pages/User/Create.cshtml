            reviewAttachmentPreviewUrls.forEach(URL.revokeObjectURL);
            reviewAttachmentPreviewUrls = [];
            attachmentContainer.innerHTML = '';

            if (selectedRecommendationFiles.length === 0) {
                attachmentContainer.textContent = 'None';
