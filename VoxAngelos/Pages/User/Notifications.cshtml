@page
@model VoxAngelos.Pages.User.NotificationsModel
@{
    Layout = "_CitizenLayout";
    ViewData["Title"] = "My Concerns";
    var visibleConcernCount = Model.Outbox.Count;
}

@section Styles {
    <link rel="stylesheet" href="~/css/citizen-notification.css" asp-append-version="true" />
}

<div class="concerns-page">
    <header class="content-header citizen-page-header concerns-page-header">
        <div>
            <span class="citizen-page-eyebrow">Citizen case desk</span>
            <h1 class="page-title">My Concerns</h1>
            <p class="citizen-page-description">Monitor the official status, supporting evidence, and LGU activity for every issue you report.</p>
        </div>
        <a asp-page="/User/Create" class="citizen-primary-action concerns-create-action">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
            </svg>
            Report a concern
        </a>
    </header>

    <section class="concerns-overview" aria-labelledby="tracking-overview-title">
        <div class="overview-copy">
            <span class="overview-kicker">Case tracking</span>
            <h2 id="tracking-overview-title">From report to resolution</h2>
            <p>Each concern keeps a permanent activity trail, so you can see what the city has received and what happens next.</p>
        </div>
        <ol class="concern-process" aria-label="Concern processing stages">
            <li><span>1</span><div><strong>Submitted</strong><small>Report received</small></div></li>
            <li><span>2</span><div><strong>Chosen</strong><small>Selected for action</small></div></li>
            <li><span>3</span><div><strong>In progress</strong><small>Work underway</small></div></li>
            <li><span>4</span><div><strong>Resolved</strong><small>Case completed</small></div></li>
        </ol>
    </section>

    <section class="concerns-workspace" aria-labelledby="concern-list-title">
        <div class="concerns-toolbar">
            <div class="toolbar-heading">
                <span class="toolbar-label">Your reports</span>
                <div>
                    <h2 id="concern-list-title">Concern records</h2>
                    <p>@visibleConcernCount record@(visibleConcernCount == 1 ? "" : "s") shown · @Model.CurrentStatusFilter</p>
                </div>
            </div>

            <nav class="status-filter" aria-label="Filter your concerns by status">
                @foreach (var filter in new[] { "All", "Unresolved", "Chosen", "In Progress", "Resolved" })
                {
                    <a asp-page="/User/Notifications"
                       asp-route-status="@filter"
                       class="status-filter-btn @(Model.CurrentStatusFilter == filter ? "active" : "")"
                       aria-current="@(Model.CurrentStatusFilter == filter ? "page" : null)">
                        @filter
                    </a>
                }
            </nav>
        </div>

        <div id="outboxView" class="view-section active-view">
            <div class="outbox-feed">
                @if (!Model.Outbox.Any())
                {
                    <div class="concern-empty-state">
                        <span class="empty-state-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                <path d="M14 2v6h6M8 13h8M8 17h5" />
                            </svg>
                        </span>
                        <strong>No @Model.CurrentStatusFilter.ToLowerInvariant() concerns found</strong>
                        <span>@(Model.CurrentStatusFilter == "All"
                            ? "When you submit a concern, its official record and progress will appear here."
                            : "There are no reports in this stage. Choose another status to continue browsing.")</span>
                        @if (Model.CurrentStatusFilter == "All")
                        {
                            <a asp-page="/User/Create">Report your first concern</a>
                        }
                        else
                        {
                            <a asp-page="/User/Notifications" asp-route-status="All">View all concerns</a>
                        }
                    </div>
                }

                @foreach (var concern in Model.Outbox)
                {
                    var statusCss = concern.Status.ToLowerInvariant().Replace(" ", "-");
                    <article class="concern-card concern-record">
                        <header class="record-header">
                            <div class="record-identity">
                                <span class="record-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                        <path d="M14 2v6h6" />
                                    </svg>
                                </span>
                                <div>
                                    <span class="record-reference">Concern #@concern.Id.ToString("D5")</span>
                                    <h2>@concern.Category</h2>
                                </div>
                            </div>
                            <div class="record-state">
                                <span class="concern-status @statusCss"><i aria-hidden="true"></i>@concern.Status</span>
                                <time datetime="@concern.SubmittedAt.ToString("O")" title="@concern.SubmittedAt.ToLocalTime().ToString("MMMM dd, yyyy 'at' h:mm tt")">
                                    Submitted @Model.GetTimeAgo(concern.SubmittedAt)
                                </time>
                            </div>
                        </header>

                        <div class="record-body">
                            <div class="record-main">
                                <section class="concern-narrative" aria-labelledby="concern-@concern.Id-title">
                                    <span class="section-label">Reported issue</span>
                                    <h3 id="concern-@concern.Id-title">Concern details</h3>
                                    <p class="concern-excerpt">@concern.Description</p>
                                </section>

                                @if (concern.Attachments.Any())
                                {
                                    <section class="record-evidence" aria-label="Supporting evidence">
                                        <div class="section-heading-row">
                                            <div>
                                                <span class="section-label">Evidence</span>
                                                <h3>Supporting files</h3>
                                            </div>
                                            <span class="attachment-count">@concern.Attachments.Count file@(concern.Attachments.Count == 1 ? "" : "s")</span>
                                        </div>
                                        <div class="concern-attachments">
                                            @foreach (var attachment in concern.Attachments)
                                            {
                                                if (attachment.FileType == "video")
                                                {
                                                    <div class="evidence-item video-evidence">
                                                        <video class="concern-media" controls preload="metadata">
                                                            <source src="@attachment.FilePath" />
                                                            Your browser does not support video playback.
                                                        </video>
                                                        <span>Video evidence</span>
                                                    </div>
                                                }
                                                else if (attachment.FileType == "document")
                                                {
                                                    <a class="concern-document evidence-item" href="@attachment.FilePath" target="_blank" rel="noopener" title="Open PDF document in a new tab">
                                                        <span class="concern-document-icon" aria-hidden="true">PDF</span>
                                                        <span>
                                                            <strong>Attached document</strong>
                                                            <small>Open in a new tab</small>
                                                        </span>
                                                        <svg class="evidence-open-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                                            <path d="M14 3h7v7M10 14 21 3M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5" />
                                                        </svg>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a class="concern-photo evidence-item" href="@attachment.FilePath" target="_blank" rel="noopener" title="Open image in a new tab">
                                                        <img src="@attachment.FilePath" alt="Supporting image for concern #@concern.Id" />
                                                        <span>View image</span>
                                                    </a>
                                                }
                                            }
                                        </div>
                                    </section>
                                }
                            </div>

                            <aside class="record-facts" aria-label="Concern information">
                                <span class="section-label">Case information</span>
                                <dl>
                                    <div>
                                        <dt>Current status</dt>
                                        <dd><span class="fact-status @statusCss">@concern.Status</span></dd>
                                    </div>
                                    <div>
                                        <dt>Submitted by</dt>
                                        <dd>@Model.CitizenFullName</dd>
                                    </div>
                                    <div>
                                        <dt>Date submitted</dt>
                                        <dd>@concern.SubmittedAt.ToLocalTime().ToString("MMM dd, yyyy")</dd>
                                    </div>
                                    @if (concern.UpdatedAt.HasValue)
                                    {
                                        <div>
                                            <dt>Last activity</dt>
                                            <dd>@concern.UpdatedAt.Value.ToLocalTime().ToString("MMM dd, yyyy")</dd>
                                        </div>
                                    }
                                </dl>
                                <div class="concern-location">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M12 2C8.686 2 6 4.686 6 8c0 5.25 6 13 6 13s6-7.75 6-13c0-3.314-2.686-6-6-6z" />
                                        <circle cx="12" cy="8" r="2" />
                                    </svg>
                                    <div><span>Location</span><strong>@concern.LocationName</strong></div>
                                </div>
                            </aside>
                        </div>

                        <details class="concern-timeline">
                            <summary>
                                <span class="timeline-summary-copy">
                                    <span class="timeline-summary-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                            <circle cx="12" cy="12" r="9" />
                                            <path d="M12 7v5l3 2" />
                                        </svg>
                                    </span>
                                    <span><strong>Case activity</strong><small>Review the complete status history</small></span>
                                </span>
                                <span class="timeline-summary-meta">
                                    <span class="timeline-count">@concern.Timeline.Count event@(concern.Timeline.Count == 1 ? "" : "s")</span>
                                    <svg class="timeline-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                        <path d="m9 6 6 6-6 6" />
                                    </svg>
                                </span>
                            </summary>
                            <ol class="timeline-list">
                                @foreach (var timelineEvent in concern.Timeline)
                                {
                                    var timelineStatusCss = timelineEvent.Status.ToLowerInvariant().Replace(" ", "-");
                                    <li class="timeline-item">
                                        <span class="timeline-marker @timelineStatusCss" aria-hidden="true"></span>
                                        <div class="timeline-content">
                                            <div class="timeline-heading">
                                                <strong>@timelineEvent.EventType</strong>
                                                <span class="timeline-status @timelineStatusCss">@timelineEvent.Status</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(timelineEvent.Message))
                                            {
                                                <p class="timeline-message">@timelineEvent.Message</p>
                                            }
                                            <div class="timeline-meta">
                                                <span>@(timelineEvent.ActorName ?? timelineEvent.ActorRole)</span>
                                                <time datetime="@timelineEvent.CreatedAt.ToString("O")">@timelineEvent.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy · h:mm tt")</time>
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ol>
                        </details>
                    </article>
                }
            </div>
        </div>
    </section>
</div>