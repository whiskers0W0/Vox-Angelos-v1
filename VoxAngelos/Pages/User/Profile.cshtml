@page
@model VoxAngelos.Pages.User.ProfileModel
@{
    Layout = "_CitizenLayout";
    ViewData["Title"] = "Profile";
    var profile = Model.Profile;
    var displayName = string.IsNullOrWhiteSpace(profile.DisplayName) ? "Citizen" : profile.DisplayName;
    var selectedAvatar = Model.AvatarOptions.FirstOrDefault(option => option.ImageUrl == profile.ProfilePhotoUrl);
    var selectedAvatarKey = selectedAvatar?.Key ?? "philippine-eagle";
}

@section Styles {
    <link rel="stylesheet" href="~/css/citizen-profile.css" asp-append-version="true" />
    <style>
        .animal-avatar {
            display: block;
            width: 100%;
            height: 100%;
            border-radius: inherit;
            background-image: url('@Url.Content("~/images/avatars/generated-animal-avatars.png")');
            background-repeat: no-repeat;
            background-size: 565.75% 282.5%;
        }

        .animal-avatar--philippine-eagle { background-position: 3.83% 20.6%; }
        .animal-avatar--philippine-tarsier { background-position: 27.15% 20.6%; }
        .animal-avatar--carabao { background-position: 50.05% 20.6%; }
        .animal-avatar--pawikan { background-position: 72.94% 20.6%; }
        .animal-avatar--owl { background-position: 95.84% 20.6%; }
        .animal-avatar--aspin { background-position: 3.83% 79.9%; }
        .animal-avatar--puspin { background-position: 27.15% 79.9%; }
        .animal-avatar--rabbit { background-position: 50.05% 79.9%; }
        .animal-avatar--dolphin { background-position: 72.94% 79.9%; }
        .animal-avatar--philippine-hornbill { background-position: 95.84% 79.9%; }

        .profile-avatar.profile-animal-avatar {
            background-color: #fff;
            background-image: url('@Url.Content("~/images/avatars/generated-animal-avatars.png")');
            background-repeat: no-repeat;
            background-size: 565.75% 282.5%;
        }

        .profile-animal-avatar.animal-avatar--philippine-eagle { background-position: 3.83% 20.6%; }
        .profile-animal-avatar.animal-avatar--philippine-tarsier { background-position: 27.15% 20.6%; }
        .profile-animal-avatar.animal-avatar--carabao { background-position: 50.05% 20.6%; }
        .profile-animal-avatar.animal-avatar--pawikan { background-position: 72.94% 20.6%; }
        .profile-animal-avatar.animal-avatar--owl { background-position: 95.84% 20.6%; }
        .profile-animal-avatar.animal-avatar--aspin { background-position: 3.83% 79.9%; }
        .profile-animal-avatar.animal-avatar--puspin { background-position: 27.15% 79.9%; }
        .profile-animal-avatar.animal-avatar--rabbit { background-position: 50.05% 79.9%; }
        .profile-animal-avatar.animal-avatar--dolphin { background-position: 72.94% 79.9%; }
        .profile-animal-avatar.animal-avatar--philippine-hornbill { background-position: 95.84% 79.9%; }

        .profile-avatar-wrap {
            gap: 14px;
        }

        .avatar-feedback {
            margin: 0 0 16px;
            padding: 12px 14px;
            border: 1px solid #b8e2cc;
            border-radius: 8px;
            background: #effaf4;
            color: #146c43;
            font-size: 13px;
            font-weight: 700;
        }

        .avatar-feedback--error {
            border-color: #f2b8bd;
            background: #fff2f3;
            color: #b4232f;
        }

        .avatar-picker {
            position: relative;
            width: 100%;
            margin-top: 0;
            padding-top: 0;
            border-top: 0;
        }

        .avatar-picker summary {
            display: inline-flex;
            cursor: pointer;
            align-items: center;
            gap: 8px;
            padding: 10px 15px;
            border: 1px solid #b9c9e3;
            border-radius: 8px;
            color: #0d47b5;
            font-size: 13px;
            font-weight: 800;
            list-style: none;
            justify-content: center;
            width: 100%;
            background: #fff;
        }

        .avatar-picker summary::-webkit-details-marker { display: none; }
        .avatar-picker summary:hover { background: #edf3ff; }

        .avatar-picker-panel {
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            z-index: 30;
            width: min(820px, calc(100vw - 330px));
            margin-top: 16px;
            padding: 18px;
            border: 1px solid #dbe3ef;
            border-radius: 10px;
            background: #f8faff;
            box-shadow: 0 14px 34px rgba(8, 26, 58, .16);
        }

        .avatar-picker-heading {
            margin: 0 0 4px;
            color: #081a3a;
            font-size: 16px;
        }

        .avatar-picker-description {
            margin: 0 0 16px;
            color: #60708b;
            font-size: 13px;
        }

        .avatar-options-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(92px, 1fr));
            gap: 12px;
        }

        .avatar-option {
            position: relative;
            display: grid;
            cursor: pointer;
            justify-items: center;
            gap: 8px;
            padding: 10px;
            border: 2px solid transparent;
            border-radius: 10px;
            background: #fff;
            color: #263957;
            text-align: center;
            transition: border-color .16s ease, box-shadow .16s ease, transform .16s ease;
        }

        .avatar-option:hover {
            transform: translateY(-2px);
            border-color: #9bb7ed;
            box-shadow: 0 6px 16px rgba(13, 71, 181, .09);
        }

        .avatar-option input {
            position: absolute;
            width: 1px;
            height: 1px;
            opacity: 0;
            pointer-events: none;
        }

        .avatar-option:has(input:checked) {
            border-color: #174db7;
            box-shadow: 0 0 0 3px rgba(23, 77, 183, .12);
        }

        .avatar-option-preview {
            width: 76px;
            height: 76px;
            overflow: hidden;
            border-radius: 50%;
        }

        .avatar-option-name {
            font-size: 11px;
            font-weight: 800;
            line-height: 1.25;
        }

        .save-avatar-button {
            margin-top: 16px;
            padding: 10px 18px;
            border: 0;
            border-radius: 8px;
            background: #174db7;
            color: #fff;
            cursor: pointer;
            font: inherit;
            font-size: 13px;
            font-weight: 800;
        }

        .save-avatar-button:hover { background: #103c92; }

        @@media (max-width: 820px) {
            .avatar-options-grid { grid-template-columns: repeat(3, minmax(86px, 1fr)); }
            .avatar-picker-panel {
                left: 50%;
                width: min(620px, calc(100vw - 48px));
                transform: translateX(-50%);
            }
        }

        @@media (max-width: 520px) {
            .avatar-options-grid { grid-template-columns: repeat(2, minmax(86px, 1fr)); }
            .avatar-picker-panel { padding: 14px; }
        }
    </style>
}

<header class="content-header citizen-page-header">
    <div>
        <span class="citizen-page-eyebrow">Citizen account</span>
        <h1 class="page-title">Profile</h1>
        <p class="citizen-page-description">Review the verified identity information connected to your account.</p>
    </div>
</header>

<div class="profile-container">
    @if (TempData["ProfileAvatarSuccess"] is string avatarSuccess)
    {
        <p class="avatar-feedback" role="status">@avatarSuccess</p>
    }
    @if (TempData["ProfileAvatarError"] is string avatarError)
    {
        <p class="avatar-feedback avatar-feedback--error" role="alert">@avatarError</p>
    }

    <div class="profile-card-wrapper">
        <div class="profile-avatar-wrap">
            <div class="profile-avatar profile-animal-avatar animal-avatar--@selectedAvatarKey"
                 role="img"
                 aria-label="@((selectedAvatar?.Name ?? "Philippine Eagle") + " profile avatar")"></div>
            <details class="avatar-picker">
                <summary>Change avatar</summary>
                <div class="avatar-picker-panel">
                    <h3 class="avatar-picker-heading">Select your profile avatar</h3>
                    <p class="avatar-picker-description">Choose one of the built-in animal characters. Uploaded personal photos are not used.</p>

                    <form method="post" asp-page-handler="UpdateAvatar">
                        <div class="avatar-options-grid">
                            @foreach (var avatar in Model.AvatarOptions)
                            {
                                <label class="avatar-option" for="avatar-@avatar.Key">
                                    <input asp-for="SelectedAvatar"
                                           id="avatar-@avatar.Key"
                                           type="radio"
                                           value="@avatar.Key"
                                           checked="@(selectedAvatarKey == avatar.Key)" />
                                    <span class="avatar-option-preview">
                                        <span class="animal-avatar animal-avatar--@avatar.Key" aria-hidden="true"></span>
                                    </span>
                                    <span class="avatar-option-name">@avatar.Name</span>
                                </label>
                            }
                        </div>

                        <button type="submit" class="save-avatar-button">Save avatar</button>
                    </form>
                </div>
            </details>
        </div>

        <div class="profile-card">
            <div class="profile-header-info">
                <h2 class="user-display-name">@displayName</h2>
                <span class="user-role-badge">Verified Citizen</span>
                <p class="profile-verification-summary">@profile.VerificationSummary</p>
            </div>

            <p class="profile-security-note">Your identity information is protected and cannot be changed from this page.</p>

            <section class="profile-details-section" aria-labelledby="personalInformationHeading">
                <h3 id="personalInformationHeading" class="profile-section-heading">Personal information</h3>
                <div class="profile-fields-grid">
                    <div class="profile-field">
                        <label>First Name</label>
                        <div class="field-value-box">@(profile.FirstName ?? "Not available")</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(profile.MiddleName))
                    {
                        <div class="profile-field">
                            <label>Middle Name</label>
                            <div class="field-value-box">@profile.MiddleName</div>
                        </div>
                    }
                    <div class="profile-field">
                        <label>Last Name</label>
                        <div class="field-value-box">@(profile.LastName ?? "Not available")</div>
                    </div>
                    <div class="profile-field">
                        <label>Birth Date</label>
                        <div class="field-value-box">@(profile.BirthDate?.ToString("MMMM dd, yyyy") ?? "Not available")</div>
                    </div>
                </div>
            </section>

            <section class="profile-details-section" aria-labelledby="contactInformationHeading">
                <h3 id="contactInformationHeading" class="profile-section-heading">Contact information</h3>
                <div class="profile-fields-grid">
                    <div class="profile-field">
                        <label>Phone Number</label>
                        <div class="field-value-box">@(profile.PhoneNumber ?? "Not available")</div>
                    </div>
                    <div class="profile-field">
                        <label>Email Address</label>
                        <div class="field-value-box">@(profile.EmailAddress ?? "Not available")</div>
                        <small class="profile-readonly-note">Change this securely from Account Security in the sidebar.</small>
                    </div>
                </div>
            </section>

            <section class="profile-details-section" aria-labelledby="addressInformationHeading">
                <h3 id="addressInformationHeading" class="profile-section-heading">Address information</h3>
                <div class="profile-fields-grid">
                    <div class="profile-field">
                        <label>Barangay</label>
                        <div class="field-value-box">@(profile.Barangay ?? "Not available")</div>
                    </div>
                    <div class="profile-field">
                        <label>City</label>
                        <div class="field-value-box">@(profile.City ?? "Not available")</div>
                    </div>
                </div>
            </section>

        </div>
    </div>
</div>
