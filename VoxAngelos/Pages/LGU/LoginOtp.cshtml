@page
@model VoxAngelos.Pages.LGU.LoginOtpModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vox Angelos | LGU OTP</title>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&family=Syne+Mono&family=Barlow:wght@300;400&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/lgu-login.css" asp-append-version="true" />
</head>
<body>
    <div class="bg"></div>
    <div class="bg-grid"></div>
    <div class="corner c-tl"></div>
    <div class="corner c-tr"></div>
    <div class="corner c-bl"></div>
    <div class="corner c-br"></div>

    <div class="tech-wrapper">
        <div class="row g-0">
            <div class="col-lg-5 panel-left">
                <div class="eyebrow mb-2">Vox Angelos</div>
                <h1 class="title mb-3">LGU<br />Portal</h1>
                <p class="tagline mb-0">
                    Identity verification<br />
                    <strong>authorized personnel</strong>
                </p>
            </div>

            <div class="col-lg-7 panel-right">
                <div class="eyebrow mb-3">Identity Verification</div>
                <h2 style="font-family:var(--font-oswald); font-weight:700; font-size:1.8rem; color:var(--color-primary); letter-spacing:0.02em; margin-bottom:0.5rem; text-transform:uppercase;">
                    Confirm Access
                </h2>
                <p style="font-family:var(--font-stack); font-size:0.9rem; color:var(--color-text-sub); margin-bottom:2rem; line-height:1.6;">
                    A 6-digit verification code has been sent. Enter it below to authorize this session.
                </p>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="error-alert">
                        <p style="font-family: var(--font-stack); font-size:0.75rem; color:var(--color-error); margin:0; font-weight:700; text-transform:uppercase; letter-spacing:0.02em;">
                            ⚠️ @Model.ErrorMessage
                        </p>
                    </div>
                }

                <form id="otpForm" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <div class="mb-4 otp-field">
                        <span id="otpCodeLabel" class="form-text-label d-block mb-1">Verification Code</span>
                        <input type="hidden" id="OtpCode" name="OtpCode" value="@Model.OtpCode" />
                        <div class="otp-digit-group" role="group" aria-labelledby="otpCodeLabel" aria-describedby="otpCodeHelp otpClientError">
                            <input id="OtpDigit1" class="form-control tech-input otp-digit" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="one-time-code" aria-label="Digit 1 of 6" autofocus />
                            <input id="OtpDigit2" class="form-control tech-input otp-digit" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="off" aria-label="Digit 2 of 6" />
                            <input id="OtpDigit3" class="form-control tech-input otp-digit" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="off" aria-label="Digit 3 of 6" />
                            <input id="OtpDigit4" class="form-control tech-input otp-digit" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="off" aria-label="Digit 4 of 6" />
                            <input id="OtpDigit5" class="form-control tech-input otp-digit" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="off" aria-label="Digit 5 of 6" />
                            <input id="OtpDigit6" class="form-control tech-input otp-digit" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" autocomplete="off" aria-label="Digit 6 of 6" />
                        </div>
                        <p id="otpCodeHelp" class="otp-help">Enter the six-digit code from your email.</p>
                        <p id="otpClientError" class="otp-client-error" role="alert"></p>
                    </div>

                    <div class="mb-4">
                        <button type="submit" class="cta w-100">
                            Verify &amp; Sign In
                            <span class="cta-arr ms-2"></span>
                        </button>
                    </div>

                    <div style="text-align:center;">
                        <a href="/LGU/Login" style="font-family:var(--font-stack); font-size:0.8rem; color:var(--color-text-sub);">
                            Back to login
                        </a>
                    </div>
                </form>

                <script>
                    (() => {
                        const form = document.getElementById('otpForm');
                        const hiddenCode = document.getElementById('OtpCode');
                        const digits = Array.from(document.querySelectorAll('.otp-digit'));
                        const clientError = document.getElementById('otpClientError');
                        if (!form || !hiddenCode || !clientError || digits.length !== 6) return;

                        const normalize = value => (value || '').replace(/\D/g, '').slice(0, 6);
                        const sync = () => {
                            hiddenCode.value = digits.map(input => input.value).join('');
                            clientError.textContent = '';
                        };
                        const writeDigits = (value, startIndex = 0, focusNext = true) => {
                            const code = normalize(value);
                            for (let index = startIndex; index < digits.length; index++) {
                                digits[index].value = code[index - startIndex] ?? '';
                            }
                            sync();
                            if (focusNext && code.length) {
                                digits[Math.min(startIndex + code.length, digits.length - 1)].focus();
                            }
                        };

                        writeDigits(hiddenCode.value, 0, false);
                        if (!hiddenCode.value) digits[0].focus();

                        digits.forEach((input, index) => {
                            input.addEventListener('focus', () => input.select());
                            input.addEventListener('input', () => {
                                const value = normalize(input.value);
                                if (input.value !== value) input.value = value;
                                if (value.length > 1) {
                                    writeDigits(value, index);
                                } else {
                                    sync();
                                    if (value && index < digits.length - 1) digits[index + 1].focus();
                                }
                            });
                            input.addEventListener('paste', event => {
                                event.preventDefault();
                                writeDigits(event.clipboardData?.getData('text') ?? '', index);
                            });
                            input.addEventListener('keydown', event => {
                                if (event.key === 'Backspace' && !input.value && index > 0) {
                                    event.preventDefault();
                                    digits[index - 1].value = '';
                                    digits[index - 1].focus();
                                    sync();
                                }
                                if (event.key === 'ArrowLeft' && index > 0) digits[index - 1].focus();
                                if (event.key === 'ArrowRight' && index < digits.length - 1) digits[index + 1].focus();
                            });
                        });

                        form.addEventListener('submit', event => {
                            sync();
                            if (hiddenCode.value.length !== 6) {
                                event.preventDefault();
                                clientError.textContent = 'Enter all six verification-code digits.';
                                digits.find(input => !input.value)?.focus();
                            }
                        });
                    })();
                </script>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @if (Configuration.GetValue<bool>("Email:ShowOtpInBrowser", true) && TempData["LGU_2FA_OtpPreview"] is string lguOtpPreview && !string.IsNullOrEmpty(lguOtpPreview))
    {
        <script>
            console.log("%c[DEV] LGU login OTP:", "color:#39ff14;font-weight:bold;", @Json.Serialize(lguOtpPreview));
        </script>
    }
</body>
</html>
