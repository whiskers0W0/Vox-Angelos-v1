@page
@model VoxAngelos.Pages.LGU.DashboardModel
@{ Layout = "_LGULayout"; ViewData["Title"] = "Welcome, Department of " + Model.DepartmentName + "!"; }
@section Styles { <link rel="stylesheet" href="~/css/dashboard_lgu.css" asp-append-version="true" /> }
<div class="lgu-operations-dashboard">
    <header class="lgu-dashboard-header">
        <div><span class="lgu-dashboard-eyebrow">Angeles City · @Model.DepartmentName operations</span><h1>Service delivery overview</h1><p>Monitor current concern volume, field response, recommendation intake, and location trends from one operational workspace.</p></div>
        <div class="lgu-dashboard-context"><span>Reporting scope</span><strong>Platform-wide activity</strong></div>
    </header>
    <section class="lgu-stat-grid" aria-label="Concern operations summary">
        <article class="lgu-stat-card"><span class="lgu-stat-label">Total concerns</span><strong>@Model.TotalConcerns.ToString("D2")</strong><span class="lgu-stat-note">All active records</span></article>
        <article class="lgu-stat-card lgu-stat-card--alert"><span class="lgu-stat-label">Unresolved</span><strong>@Model.TotalUnresolved.ToString("D2")</strong><span class="lgu-stat-note">Awaiting next action</span></article>
        <article class="lgu-stat-card"><span class="lgu-stat-label">Chosen</span><strong>@Model.TotalChosen.ToString("D2")</strong><span class="lgu-stat-note">Assigned for handling</span></article>
        <article class="lgu-stat-card lgu-stat-card--progress"><span class="lgu-stat-label">In progress</span><strong>@Model.TotalInProgress.ToString("D2")</strong><span class="lgu-stat-note">Being addressed</span></article>
        <article class="lgu-stat-card lgu-stat-card--positive"><span class="lgu-stat-label">Resolved</span><strong>@Model.TotalResolved.ToString("D2")</strong><span class="lgu-stat-note">Completed concerns</span></article>
        <article class="lgu-stat-card"><span class="lgu-stat-label">Pending recommendations</span><strong>@Model.PendingRecommendations.ToString("D2")</strong><span class="lgu-stat-note">Awaiting review</span></article>
        <article class="lgu-stat-card lgu-stat-card--positive"><span class="lgu-stat-label">Resolution rate</span><strong>@Model.ResolutionRate%</strong><span class="lgu-stat-note">Of all concerns</span></article>
        <article class="lgu-stat-card"><span class="lgu-stat-label">Avg. response time</span><strong>@Model.AvgResponseDays <small>days</small></strong><span class="lgu-stat-note">Submission to resolution</span></article>
        <article class="lgu-stat-card"><span class="lgu-stat-label">Today’s concerns</span><strong>@Model.TodayConcerns.ToString("D2")</strong><span class="lgu-stat-note">Submitted today</span></article>
    </section>
    <section class="lgu-dashboard-section" aria-labelledby="activityHeading">
        <div class="lgu-section-heading"><div><span>Activity monitoring</span><h2 id="activityHeading">Service pulse</h2></div><p>Last seven days and latest updates</p></div>
        <div class="lgu-dashboard-grid lgu-dashboard-grid--two">
            <article class="lgu-panel"><header class="lgu-panel-header"><h3>Concern trend</h3><span>7 days</span></header><div class="lgu-chart-wrap"><canvas id="concernTrendChart"></canvas></div></article>
            <article class="lgu-panel lgu-activity-panel"><header class="lgu-panel-header"><h3>Recent activity</h3><span>Live feed</span></header><div class="lgu-activity-feed">@foreach (var item in Model.RecentActivities) { <div class="lgu-activity-item @item.Type"><span class="lgu-activity-dot"></span><div><p>@Html.Raw(item.Text)</p><time>@item.TimeAgo</time></div></div> } @if (!Model.RecentActivities.Any()) { <p class="lgu-empty-state">No recent activity yet.</p> }</div></article>
        </div>
    </section>
    <section class="lgu-dashboard-section" aria-labelledby="distributionHeading">
        <div class="lgu-section-heading"><div><span>Location and category</span><h2 id="distributionHeading">Demand distribution</h2></div><p>Where attention is needed</p></div>
        <div class="lgu-dashboard-grid lgu-dashboard-grid--two">
            <article class="lgu-panel"><header class="lgu-panel-header"><h3>Concerns by category</h3><span>Breakdown</span></header><div class="lgu-chart-wrap"><canvas id="categoryChart"></canvas></div></article>
            <article class="lgu-panel"><header class="lgu-panel-header"><h3>Top barangays by concern volume</h3><span>Top 5</span></header><div class="lgu-barangay-list">@if (!Model.TopBarangays.Any()) { <p class="lgu-empty-state">No data yet.</p> } @foreach (var b in Model.TopBarangays) { var pct = Model.TotalConcerns > 0 ? (int)((double)b.Count / Model.TotalConcerns * 100) : 0; <div class="lgu-barangay-row"><div><strong>@b.Barangay</strong><span>@b.Count concerns</span></div><div class="lgu-progress-track"><span style="width:@pct%"></span></div></div> }</div></article>
        </div>
    </section>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const trendCtx = document.getElementById('concernTrendChart').getContext('2d'); new Chart(trendCtx, { type: 'line', data: { labels: @Html.Raw(Model.TrendLabels), datasets: [{ label: 'New Reports', data: @Html.Raw(Model.TrendData), borderColor: '#1646a0', backgroundColor: 'rgba(22, 70, 160, 0.08)', fill: true, tension: 0.35, pointRadius: 3 }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { grid: { display: false } }, y: { min: 0, ticks: { stepSize: 1, callback: function(value) { if (value <= 10 || value % 5 === 0) return value; return null; } } } } } });
        const categoryCtx = document.getElementById('categoryChart').getContext('2d'); new Chart(categoryCtx, { type: 'bar', data: { labels: @Html.Raw(Model.CategoryLabels), datasets: [{ label: 'Concerns', data: @Html.Raw(Model.CategoryData), backgroundColor: ['rgba(22, 70, 160, .88)', 'rgba(22, 70, 160, .72)', 'rgba(22, 70, 160, .56)', 'rgba(22, 70, 160, .42)', 'rgba(22, 70, 160, .3)'], borderColor: '#1646a0', borderWidth: 1, borderRadius: 5 }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { grid: { display: false } }, y: { min: 0, ticks: { stepSize: 1, callback: function(value) { if (value <= 10 || value % 5 === 0) return value; return null; } } } } } });
    </script>
}