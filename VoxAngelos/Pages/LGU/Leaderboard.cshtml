@page
@model VoxAngelos.Pages.LGU.LeaderboardModel
@{ Layout = "_LGULayout"; ViewData["Title"] = "Top Project Recommendations"; }
@section Styles { <link rel="stylesheet" href="~/css/lgu_leaderboard.css" asp-append-version="true" /> }
<div class="lgu-leaderboard-workspace">
    <header class="lgu-page-header"><div><span class="lgu-page-eyebrow">Community signal monitoring</span><h1>Recommendation leaderboard</h1><p>Review the highest-rated published recommendations using the combined citizen urgency, relevance, and feasibility scores.</p></div><div class="lgu-page-context"><span>Ranking basis</span><strong>Published recommendations</strong></div></header>
    <div id="leaderboardView" class="view-section"><div class="leaderboard-wrapper"><section class="leaderboard-feed" aria-label="Ranked citizen recommendations">@if (!Model.TopRated.Any()) { <div class="leaderboard-empty"><strong>No approved recommendations yet.</strong><p>Published recommendations will appear here when they receive community ratings.</p></div> }
    @for (int rank = 0; rank < Model.TopRated.Count; rank++) { var rec = Model.TopRated[rank]; <article class="leaderboard-item"><div class="rank-col" aria-label="Rank @(rank + 1)"><span class="rank-arrow @(rank == 0 ? "up" : "down")">@(rank == 0 ? "▲" : "▼")</span><strong class="rank-number">@(rank + 1)</strong></div><div class="proposal-card leaderboard-card"><header class="card-header"><div class="author-info"><div class="avatar" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8" r="4" /><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" /></svg></div><div><span class="lgu-record-label">Citizen recommendation</span><strong class="author-name">@rec.CitizenName</strong></div></div><time class="card-date">@rec.ApprovedAt.ToString("MM/dd/yy")</time></header><div class="card-meta"><span class="meta-label">Category</span><span class="meta-value">@rec.Category</span>@if (!string.IsNullOrEmpty(rec.AssignedOffice)) { <span class="meta-label">Office</span><span class="meta-value">@rec.AssignedOffice</span> }</div><div class="card-body"><h2 class="proposal-title">@rec.Title</h2><p class="proposal-excerpt" id="desc-@rec.Id">@rec.Description</p><a href="#" class="view-more" id="viewmore-@rec.Id" onclick="toggleViewMore(event, '@rec.Id')">View More</a></div>
    @if (rec.AttachmentPaths.Any()) { <div class="attachments">@{ var maxShow = Math.Min(2, rec.AttachmentPaths.Count); var extra = rec.AttachmentPaths.Count - maxShow; } @for (int i = 0; i < maxShow; i++) { var path = rec.AttachmentPaths[i]; var type = rec.AttachmentTypes[i]; <div class="attachment-thumb">@if (type == "image" || type.StartsWith("image/")) { <button type="button" aria-label="Open attachment" onclick="openLightbox('@path', 'image')"><img src="@path" alt="Recommendation attachment" /></button> } else if (type == "video" || type.StartsWith("video/")) { <button type="button" aria-label="Open attachment video" onclick="openLightbox('@path', 'video')"><video src="@path"></video></button> } else { <a href="@path" target="_blank" rel="noopener" aria-label="Open document attachment">Document</a> }</div> } @if (extra > 0) { <div class="attachment-thumb more-files"><span>@extra+</span><small>Files</small></div> }</div> }
    <footer class="leaderboard-votes rating-summary"><span class="rating-chip composite">Composite @rec.CompositeScore.ToString("0.0")★</span><span class="rating-chip urgency">Urgency @rec.AvgUrgency.ToString("0.0")★</span><span class="rating-chip relevance">Relevance @rec.AvgRelevance.ToString("0.0")★</span><span class="rating-chip feasibility">Feasibility @rec.AvgFeasibility.ToString("0.0")★</span><span class="rating-count">@rec.RatingCount rating@(rec.RatingCount == 1 ? "" : "s")</span></footer></div></article> }</section>
    <aside class="ranking-sidebar"><div class="ranking-box"><header class="ranking-header"><svg class="trophy-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2H6a2 2 0 00-2 2v2c0 2.21 1.79 4 4 4h1v2c0 2.33 1.59 4.28 3.74 4.83C12.3 19.46 11 21.08 11 23h2c0-1.92-1.3-3.54-1.74-4.17 2.15-.55 3.74-2.5 3.74-4.83v-2h1c2.21 0 4-1.79 4-4V4a2 2 0 00-2-2zM6 8c-1.1 0-2-.9-2-2V4h2v4zm14-2c0 1.1-.9 2-2 2V4h2v2z" /></svg><div><span>Scoreboard</span><h2 class="ranking-title">Current ranking</h2></div></header><div class="ranking-list">@if (!Model.TopRated.Any()) { <p class="ranking-empty">No data yet.</p> } @for (int i = 0; i < Model.TopRated.Count; i++) { var r = Model.TopRated[i]; var shortTitle = r.Title.Length > 22 ? r.Title.Substring(0, 22) + "..." : r.Title; <div class="mini-rank-item"><span class="mini-number">@(i + 1)</span><div class="mini-content"><p class="mini-title">@shortTitle</p><div class="mini-votes"><span class="up">@r.CompositeScore.ToString("0.0")★ <small>score</small></span><span class="down">@r.RatingCount <small>ratings</small></span></div></div></div> }</div></div></aside></div></div>
</div>
<div id="lightboxOverlay" class="lgu-lightbox" onclick="closeLightbox()"><button type="button" onclick="closeLightbox()" aria-label="Close attachment preview">×</button><div onclick="event.stopPropagation()"><img id="lightboxImg" src="" alt="" /><video id="lightboxVideo" src="" controls></video></div></div>
@section Scripts { <script>
document.addEventListener('DOMContentLoaded', () => { document.querySelectorAll('.proposal-excerpt').forEach(desc => { const id = desc.id.replace('desc-', ''); const btn = document.getElementById('viewmore-' + id); if (desc.scrollHeight > desc.clientHeight) btn.style.display = 'inline-flex'; }); });
function toggleViewMore(e, id) { e.preventDefault(); const desc = document.getElementById('desc-' + id); const btn = document.getElementById('viewmore-' + id); const isCollapsed = desc.classList.contains('expanded'); desc.classList.toggle('expanded'); btn.textContent = isCollapsed ? 'View More' : 'View Less'; }
function openLightbox(src, type) { const overlay = document.getElementById('lightboxOverlay'); const img = document.getElementById('lightboxImg'); const video = document.getElementById('lightboxVideo'); img.style.display = 'none'; video.style.display = 'none'; video.pause(); if (type === 'image') { img.src = src; img.style.display = 'block'; } else if (type === 'video') { video.src = src; video.style.display = 'block'; } overlay.classList.add('is-open'); document.body.style.overflow = 'hidden'; }
function closeLightbox() { const overlay = document.getElementById('lightboxOverlay'); const video = document.getElementById('lightboxVideo'); video.pause(); overlay.classList.remove('is-open'); document.body.style.overflow = ''; }
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });
</script> }