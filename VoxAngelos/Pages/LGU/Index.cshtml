@page
@model VoxAngelos.Pages.LGU.IndexModel
@{ Layout = "_LGULayout"; ViewData["Title"] = "Citizen Concerns"; }
@functions { string GetTimeAgo(DateTime dt) { var diff = DateTime.UtcNow - dt; if (diff.TotalSeconds < 60) return $"{(int)diff.TotalSeconds}s ago"; if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago"; if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago"; return $"{(int)diff.TotalDays}d ago"; } }
@section Styles { <link rel="stylesheet" href="~/css/lgu_concerns.css" asp-append-version="true" /> }
<div class="lgu-concerns-workspace">
    <header class="lgu-page-header"><div><span class="lgu-page-eyebrow">Citizen service operations</span><h1>Concern intake queue</h1><p>Review classified reports, confirm routing quality, and move assigned concerns through resolution.</p></div><div class="lgu-page-context"><span>Current view</span><strong>@Model.CurrentFilter concerns</strong></div></header>
    @if (TempData["ConcernError"] != null) { <div class="floating-toast toast-error" role="alert"><span>@TempData["ConcernError"]</span><div class="toast-progress"></div></div> }
    @if (TempData["ConcernSuccess"] != null) { <div class="floating-toast toast-success" role="status"><span>@TempData["ConcernSuccess"]</span><div class="toast-progress"></div></div> }
    <section class="lgu-queue-controls" aria-label="Concern status filters"><div class="lgu-filter-label"><span>Queue status</span><strong>Select a work stage</strong></div><div class="feed-filter-group">@{ var filters = new[] { "Unresolved", "Chosen", "In Progress", "Resolved", "Closed", "All" }; } @foreach (var f in filters) { var isActive = Model.CurrentFilter == f ? "active" : ""; <a class="filter-btn @isActive" asp-page="/LGU/Index" asp-route-filter="@f" asp-route-search="@Model.SearchTerm" asp-route-barangay="@Model.BarangayFilter" asp-route-dateFrom="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" asp-route-dateTo="@(Model.DateTo?.ToString("yyyy-MM-dd"))" asp-route-sort="@Model.SortOrder">@f</a> }</div></section>
    <form method="get" class="lgu-advanced-filters" aria-label="Filter concerns">
        <input type="hidden" name="filter" value="@Model.CurrentFilter" />
        <label class="filter-field filter-search"><span>Search words</span><input type="search" name="search" value="@Model.SearchTerm" placeholder="Search description or location" /></label>
        <label class="filter-field"><span>Barangay</span><select name="barangay"><option value="">All barangays</option>@foreach (var name in Model.BarangayOptions) { <option value="@name" selected="@(Model.BarangayFilter == name)">@name</option> }</select></label>
        <label class="filter-field"><span>From</span><input type="date" name="dateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" /></label>
        <label class="filter-field"><span>To</span><input type="date" name="dateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" /></label>
        <label class="filter-field"><span>Order</span><select name="sort"><option value="newest" selected="@(Model.SortOrder == "newest")">Newest first</option><option value="oldest" selected="@(Model.SortOrder == "oldest")">Oldest first</option></select></label>
        <div class="filter-actions"><button type="submit" class="btn-va-primary">Apply filters</button><a class="btn-va-secondary" asp-page="/LGU/Index" asp-route-filter="@Model.CurrentFilter">Clear</a></div>
    </form>
    <div class="selection-hint">Long-press a card to select it</div>
    <form method="post" asp-page="/LGU/Index" asp-page-handler="BulkConfirmCategory" id="bulk-confirm-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="filter" value="@Model.CurrentFilter" />
    </form>
    <form method="post" asp-page="/LGU/Index" asp-page-handler="BulkChooseConcerns" id="bulk-accept-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="filter" value="@Model.CurrentFilter" />
    </form>
    <form method="post" asp-page="/LGU/Index" asp-page-handler="BulkCloseInvalid" id="bulk-close-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="filter" value="@Model.CurrentFilter" />
        <input type="hidden" name="reason" id="bulk-close-reason-value" />
    </form>
    <form method="post" asp-page="/LGU/Index" asp-page-handler="BulkUpdateStatus" id="bulk-status-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="filter" value="@Model.CurrentFilter" />
        <input type="hidden" name="expectedStatus" value="@Model.CurrentFilter" />
        <input type="hidden" name="newStatus" value="@(Model.CurrentFilter == "Chosen" ? "In Progress" : Model.CurrentFilter == "In Progress" ? "Resolved" : "")" />
        <input type="hidden" name="notes" id="bulk-status-notes-value" />
    </form>
    <div>
        <div class="bulk-toolbar" id="bulk-toolbar" style="display:none;">
            <div class="bulk-selection-summary">
                <span class="bulk-toolbar-label">Selection</span>
                <strong id="bulk-count">0 selected</strong>
            </div>
            <div class="bulk-action-group bulk-selection-actions">
                <button type="button" class="btn-va-secondary" id="select-all-btn">Select all</button>
            </div>
            @if (Model.CurrentFilter == "Unresolved")
            {
                <div class="bulk-action-group bulk-routing-actions">
                    <span class="bulk-toolbar-label">Routing</span>
                    <div class="bulk-action-buttons">
                        <button type="submit" form="bulk-confirm-form" class="btn-feedback-correct">Correct</button>
                    </div>
                </div>
                <div class="bulk-action-group bulk-workflow-actions">
                    <span class="bulk-toolbar-label">Workflow</span>
                    <div class="bulk-action-buttons">
                        <button type="button" class="btn-va-primary" id="bulk-accept-btn" data-bs-toggle="modal" data-bs-target="#bulkAcceptModal">Accept</button>
                        <button type="button" class="bulk-danger-btn" id="bulk-close-btn" data-bs-toggle="modal" data-bs-target="#bulkCloseInvalidModal">Close duplicates</button>
                    </div>
                </div>
            }
            else
            {
                <div class="bulk-action-group bulk-workflow-actions">
                    <span class="bulk-toolbar-label">Next stage</span>
                    <div class="bulk-action-buttons"><button type="button" class="btn-va-primary" id="bulk-status-btn" data-bs-toggle="modal" data-bs-target="#bulkStatusModal">@(Model.CurrentFilter == "Chosen" ? "Start Progress" : "Mark Resolved")</button></div>
                </div>
            }
            <div class="bulk-action-group bulk-exit-actions">
                <button type="button" class="bulk-clear-btn" id="bulk-clear-btn" aria-label="Exit batch selection">&times;<span>Clear</span></button>
            </div>
        </div>
    </div>
    <div id="concern-feed">
        @foreach (var concern in Model.Concerns)
        {
            var statusCss = concern.Status.ToLower().Replace(" ", "-"); var timeAgo = GetTimeAgo(concern.SubmittedAt);
            var selectableAttr = concern.Status is "Unresolved" or "Chosen" or "In Progress" && concern.Status == Model.CurrentFilter ? "true" : "false";
            var hasCoordinates = concern.Latitude.HasValue && concern.Longitude.HasValue;
            var latitude = concern.Latitude.GetValueOrDefault();
            var longitude = concern.Longitude.GetValueOrDefault();
            var coordinatesText = hasCoordinates
                ? FormattableString.Invariant($"{latitude:F6}, {longitude:F6}")
                : string.Empty;
            var hasReadableSavedLocation = !string.IsNullOrWhiteSpace(concern.LocationName)
                && concern.LocationName != "No location provided"
                && concern.LocationName.Any(char.IsLetter);
            var locationHeading = !string.IsNullOrWhiteSpace(concern.BarangayName)
                ? $"Barangay {concern.BarangayName}, Angeles City"
                : hasReadableSavedLocation
                    ? concern.LocationName
                    : hasCoordinates ? "Exact map pin available" : "No location provided";
            var mapUrl = hasCoordinates
                ? $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(coordinatesText)}"
                : null;
            <article class="concern-card" id="concern-@concern.Id" data-id="@concern.Id" data-selectable="@selectableAttr">
                @if (selectableAttr == "true") { <input type="checkbox" class="concern-select" data-id="@concern.Id" hidden /> }
                <header class="card-header"><div class="author-info"><div class="avatar" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8" r="4" /><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" /></svg></div><div><span class="lgu-record-label">Resident report</span><strong class="author-name">@concern.CitizenName</strong></div></div><div class="lgu-card-status"><span class="card-date">@timeAgo</span><span class="concern-status @statusCss">@concern.Status</span></div></header>
                <div class="lgu-card-body"><div class="lgu-concern-summary"><div class="card-meta"><span class="meta-label">Classified category</span><span class="meta-value">@concern.Category</span></div><p class="concern-excerpt">@concern.Description</p></div>
                @if (concern.FirstAttachmentPath != null) { <button class="concern-photo" type="button" aria-label="Open concern photo" onclick="openLightbox('@concern.FirstAttachmentPath', 'image')"><img src="@concern.FirstAttachmentPath" alt="Concern photo" /></button> }</div>
                @if (concern.RawCategory != null) { <div class="classification-feedback"><span class="lgu-feedback-label">Routing review</span>@if (concern.HasFeedback) { <span class="feedback-logged">Classification reviewed</span> } else { <form method="post" asp-page="/LGU/Index" asp-page-handler="ConfirmCategory">@Html.AntiForgeryToken()<input type="hidden" name="concernId" value="@concern.Id" /><button type="submit" class="btn-feedback-correct">Category correct</button></form>@if (concern.Status == "Unresolved") { <button type="button" class="btn-feedback-wrong" data-bs-toggle="modal" data-bs-target="#sendToAdminModal" onclick="openSendToAdminModal(@concern.Id)">Wrong department</button> } }</div> } else if (concern.Status == "Unresolved") { <div class="classification-feedback"><span class="lgu-feedback-label">Routing review</span><span class="feedback-uncategorized">Awaiting Admin assignment</span></div> }
                <footer class="card-footer-lgu"><div class="lgu-card-metadata"><div class="concern-location"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C8.686 2 6 4.686 6 8c0 5.25 6 13 6 13s6-7.75 6-13c0-3.314-2.686-6-6-6z" /><circle cx="12" cy="8" r="2" /></svg><div><strong>@locationHeading</strong>@if (hasReadableSavedLocation && concern.LocationName != locationHeading) { <br /><span>@concern.LocationName</span> }@if (hasCoordinates) { <br /><small>Coordinates: @coordinatesText</small> }</div>@if (mapUrl != null) { <a class="btn-va-secondary" href="@mapUrl" target="_blank" rel="noopener noreferrer" aria-label="View concern location on Google Maps">View on map</a> }</div>@if (concern.LocationDensityScore > 0) { <div class="concern-density-badge" title="Other unresolved concerns reported within 300m in the last 30 days">@concern.LocationDensityScore nearby report@(concern.LocationDensityScore == 1 ? "" : "s")</div> }</div>
                @if (concern.Status == "Unresolved") { <div class="action-container" style="display:flex; gap:8px;">@if (concern.RawCategory == Model.CurrentUserDepartment) { <button type="button" class="btn-va-secondary" data-bs-toggle="modal" data-bs-target="#closeInvalidModal" onclick="openCloseInvalidModal(@concern.Id)">Close as invalid</button> }<button type="button" class="btn-dark-pill" data-bs-toggle="modal" data-bs-target="#acceptConcernModal" onclick="openAcceptConcernModal(@concern.Id)">Accept concern</button></div> } else if (concern.Status == "Chosen" || concern.Status == "In Progress") { <div class="action-container"><button type="button" class="btn-dark-pill" data-bs-toggle="modal" data-bs-target="#statusModal" onclick="openStatusModal(@concern.Id, '@concern.CitizenName')">Update status</button></div> }</footer>
            </article>
        }
        @if (!Model.Concerns.Any()) { <div class="feed-empty"><strong>No concerns in this queue.</strong><p>Choose another status filter to review a different work stage.</p></div> }
    </div>
<div class="modal fade modal-va" id="acceptConcernModal" tabindex="-1" aria-labelledby="acceptConcernModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div class="modal-title" id="acceptConcernModalLabel">Accept this concern?</div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><form method="post" asp-page="/LGU/Index" asp-page-handler="ChooseConcern">@Html.AntiForgeryToken()<input type="hidden" name="concernId" id="accept-concern-id" /><div class="modal-body"><p>By confirming, your office will take responsibility for reviewing and acting on this concern.</p><p>The citizen will be notified that the concern has been accepted.</p></div><div class="modal-footer"><button type="button" class="btn-va-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn-va-primary">Confirm acceptance</button></div></form></div></div></div>
<div class="modal fade modal-va" id="closeInvalidModal" tabindex="-1" aria-labelledby="closeInvalidModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div class="modal-title" id="closeInvalidModalLabel">Close this concern as invalid?</div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><form method="post" asp-page="/LGU/Index" asp-page-handler="CloseInvalid">@Html.AntiForgeryToken()<input type="hidden" name="concernId" id="close-invalid-concern-id" /><div class="modal-body"><p>Use this only for spam, test submissions, or reports that do not contain an actionable concern.</p><label class="form-label" for="close-invalid-reason">Reason for closing</label><textarea class="form-control" name="reason" id="close-invalid-reason" minlength="10" maxlength="500" required placeholder="Clearly explain why this concern cannot be acted on..."></textarea><small>The citizen will receive this explanation.</small></div><div class="modal-footer"><button type="button" class="btn-va-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn-feedback-wrong">Close concern</button></div></form></div></div></div>
<div class="modal fade modal-va" id="bulkAcceptModal" tabindex="-1" aria-labelledby="bulkAcceptModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div class="modal-title" id="bulkAcceptModalLabel">Accept selected concerns?</div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><p>Your office will take responsibility for every eligible selected concern. Each affected citizen will be notified.</p></div><div class="modal-footer"><button type="button" class="btn-va-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn-va-primary" id="bulk-accept-confirm-btn">Confirm acceptance</button></div></div></div></div>
<div class="modal fade modal-va" id="bulkCloseInvalidModal" tabindex="-1" aria-labelledby="bulkCloseInvalidModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div class="modal-title" id="bulkCloseInvalidModalLabel">Close selected duplicate concerns?</div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><p>Every selected concern will be closed. Use this only after confirming that the reports are duplicates or otherwise non-actionable.</p><label class="form-label" for="bulk-close-reason">Reason for closing</label><textarea class="form-control" id="bulk-close-reason" minlength="10" maxlength="500" required placeholder="Explain which report is the duplicate or why these concerns are being closed..."></textarea><small>Each affected citizen will receive this explanation.</small></div><div class="modal-footer"><button type="button" class="btn-va-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn-feedback-wrong" id="bulk-close-confirm-btn">Close selected</button></div></div></div></div>
@if (Model.CurrentFilter is "Chosen" or "In Progress") { <div class="modal fade modal-va" id="bulkStatusModal" tabindex="-1" aria-labelledby="bulkStatusModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div class="modal-title" id="bulkStatusModalLabel">@(Model.CurrentFilter == "Chosen" ? "Start progress on selected concerns?" : "Resolve selected concerns?")</div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><p id="bulk-status-confirmation-text"></p><label class="form-label" for="bulk-status-notes">Shared public update / response</label><textarea class="form-control" id="bulk-status-notes" minlength="10" maxlength="1000" required placeholder="Write the update that each affected citizen will see..."></textarea><small>This response will be recorded separately on every selected concern. Each citizen will receive an in-system notification and, if enabled, an email.</small></div><div class="modal-footer"><button type="button" class="btn-va-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn-va-primary" id="bulk-status-confirm-btn">Confirm and notify</button></div></div></div></div> }
<div class="modal fade modal-va" id="statusModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div class="modal-title" id="statusModalLabel">Update status <span id="modal-citizen-name"></span></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><form method="post" asp-page="/LGU/Index" asp-page-handler="UpdateStatus">@Html.AntiForgeryToken()<input type="hidden" name="concernId" id="modal-concern-id" /><div class="modal-body"><div class="mb-3"><label class="form-label" for="modal-status-select">New status</label><select class="form-select" name="status" id="modal-status-select"><option value="" disabled selected>Status...</option><option value="In Progress">In Progress</option><option value="Resolved">Resolved</option></select></div><div><label class="form-label" for="modal-notes">Notes / public response</label><textarea class="form-control" name="notes" id="modal-notes" placeholder="Add a response to the resident..."></textarea></div></div><div class="modal-footer"><button type="button" class="btn-va-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn-va-primary">Save update</button></div></form></div></div></div>
<div class="modal fade modal-va" id="sendToAdminModal" tabindex="-1" aria-labelledby="sendToAdminModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div class="modal-title" id="sendToAdminModalLabel">Send this concern to Admin?</div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><form method="post" asp-page="/LGU/Index" asp-page-handler="SendToAdminForReassignment">@Html.AntiForgeryToken()<input type="hidden" name="concernId" id="send-to-admin-concern-id" /><div class="modal-body"><p>This concern will be removed from your office and placed in the Admin routing queue.</p><p>Admin will choose the correct department. Your office will no longer be able to reassign it directly.</p></div><div class="modal-footer"><button type="button" class="btn-va-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn-feedback-wrong">Confirm and send to Admin</button></div></form></div></div></div>
<div id="lightboxOverlay" class="lgu-lightbox" onclick="closeLightbox()"><button type="button" onclick="closeLightbox()" aria-label="Close image preview">×</button><div onclick="event.stopPropagation()"><img id="lightboxImg" src="" alt="" /><video id="lightboxVideo" src="" controls></video></div></div>
<button type="button" id="backToTopBtn" class="back-to-top-btn" hidden aria-label="Back to top" title="Back to top">
    <span aria-hidden="true">↑</span>
    <span class="back-to-top-label">Top</span>
</button>
</div>
@section Scripts { <script>
const backToTopBtn = document.getElementById('backToTopBtn');
function openAcceptConcernModal(concernId) { document.getElementById('accept-concern-id').value = concernId; }
function openCloseInvalidModal(concernId) { const idInput = document.getElementById('close-invalid-concern-id'); const reasonInput = document.getElementById('close-invalid-reason'); idInput.value = concernId; reasonInput.value = ''; }
function updateBackToTopVisibility() { backToTopBtn.hidden = window.scrollY < 360; }
window.addEventListener('scroll', updateBackToTopVisibility, { passive: true });
backToTopBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

// Every action on this page is a full POST + redirect, which the browser resets to
// the top for by default. Save scroll position before submitting and restore it once
// the reloaded page has finished rendering, so acting on a card doesn't jump you away
// from where you were in the list.
const CONCERN_SCROLL_KEY = 'lguConcernsScrollY';
document.querySelectorAll('form').forEach(form => {
    form.addEventListener('submit', () => sessionStorage.setItem(CONCERN_SCROLL_KEY, String(window.scrollY)));
});
window.addEventListener('load', () => {
    const focusedConcernId = new URLSearchParams(window.location.search).get('concernId');
    const savedScrollY = sessionStorage.getItem(CONCERN_SCROLL_KEY);
    if (focusedConcernId) {
        sessionStorage.removeItem(CONCERN_SCROLL_KEY);
        const focusedCard = document.querySelector(`.concern-card[data-id="${CSS.escape(focusedConcernId)}"]`);
        if (focusedCard) {
            focusedCard.classList.add('concern-card-focused');
            focusedCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            window.setTimeout(() => focusedCard.classList.remove('concern-card-focused'), 3500);
        }
    } else if (savedScrollY !== null) {
        sessionStorage.removeItem(CONCERN_SCROLL_KEY);
        window.scrollTo(0, parseInt(savedScrollY, 10));
    }
});

function openSendToAdminModal(concernId) { document.getElementById('send-to-admin-concern-id').value = concernId; }

// --- Bulk selection: long-press a card to toggle it, no visible checkbox ---
const concernFeed = document.getElementById('concern-feed');
const bulkToolbar = document.getElementById('bulk-toolbar');
const bulkAcceptForm = document.getElementById('bulk-accept-form');
const bulkCloseForm = document.getElementById('bulk-close-form');
const bulkStatusForm = document.getElementById('bulk-status-form');
const LONG_PRESS_MS = 500;
let pressTimer = null;
let pressStartX = 0, pressStartY = 0;
let longPressFired = false;

function anyCardSelected() {
    return document.querySelectorAll('.concern-select:checked').length > 0;
}

function isInteractiveTarget(el) {
    return el.closest('button, a, input, select, textarea, label');
}

function setCardSelected(card, selected) {
    const checkbox = card.querySelector('.concern-select');
    if (!checkbox) return;
    checkbox.checked = selected;
    card.classList.toggle('card-selected', selected);
}

function toggleCardSelection(card) {
    const checkbox = card.querySelector('.concern-select');
    if (!checkbox) return;
    setCardSelected(card, !checkbox.checked);
    updateBulkToolbar();
    if (navigator.vibrate) navigator.vibrate(15);
}

function updateBulkToolbar() {
    const checked = document.querySelectorAll('.concern-select:checked');
    document.getElementById('bulk-count').textContent = checked.length + ' selected';
    bulkToolbar.style.display = checked.length > 0 ? 'flex' : 'none';
    document.body.classList.toggle('concern-selection-mode', checked.length > 0);
}

document.getElementById('select-all-btn').addEventListener('click', () => {
    document.querySelectorAll('.concern-card[data-selectable="true"]').forEach(card => setCardSelected(card, true));
    updateBulkToolbar();
});

document.getElementById('bulk-clear-btn').addEventListener('click', () => {
    document.querySelectorAll('.concern-card.card-selected').forEach(card => setCardSelected(card, false));
    updateBulkToolbar();
});

document.getElementById('bulk-accept-confirm-btn').addEventListener('click', () => {
    if (!anyCardSelected()) return;
    const button = document.getElementById('bulk-accept-confirm-btn');
    button.disabled = true;
    button.textContent = 'Processing...';
    syncSelectedIdsIntoForm(bulkAcceptForm);
    bulkAcceptForm.submit();
});

document.getElementById('bulk-close-confirm-btn').addEventListener('click', () => {
    const reasonInput = document.getElementById('bulk-close-reason');
    const reason = reasonInput.value.trim();
    if (reason.length < 10 || reason.length > 500) { reasonInput.reportValidity(); return; }
    const button = document.getElementById('bulk-close-confirm-btn');
    button.disabled = true;
    button.textContent = 'Processing...';
    document.getElementById('bulk-close-reason-value').value = reason;
    syncSelectedIdsIntoForm(bulkCloseForm);
    bulkCloseForm.submit();
});

const bulkStatusBtn = document.getElementById('bulk-status-btn');
const bulkStatusConfirmBtn = document.getElementById('bulk-status-confirm-btn');
if (bulkStatusBtn && bulkStatusConfirmBtn) {
    bulkStatusBtn.addEventListener('click', () => {
        const count = document.querySelectorAll('.concern-select:checked').length;
        const nextStatus = '@(Model.CurrentFilter == "Chosen" ? "In Progress" : "Resolved")';
        document.getElementById('bulk-status-confirmation-text').textContent =
            `Change ${count} selected concern${count === 1 ? '' : 's'} to ${nextStatus}?`;
        document.getElementById('bulk-status-notes').value = '';
    });
    bulkStatusConfirmBtn.addEventListener('click', () => {
        const notesInput = document.getElementById('bulk-status-notes');
        const notes = notesInput.value.trim();
        if (notes.length < 10 || notes.length > 1000) { notesInput.reportValidity(); return; }
        if (!anyCardSelected()) return;
        document.getElementById('bulk-status-notes-value').value = notes;
        bulkStatusConfirmBtn.disabled = true;
        bulkStatusConfirmBtn.textContent = 'Processing...';
        syncSelectedIdsIntoForm(bulkStatusForm);
        bulkStatusForm.submit();
    });
}

concernFeed.addEventListener('pointerdown', e => {
    const card = e.target.closest('.concern-card');
    if (!card || card.dataset.selectable !== 'true' || isInteractiveTarget(e.target)) return;
    pressStartX = e.clientX; pressStartY = e.clientY;
    pressTimer = setTimeout(() => { toggleCardSelection(card); pressTimer = null; longPressFired = true; }, LONG_PRESS_MS);
});
concernFeed.addEventListener('pointermove', e => {
    if (pressTimer && (Math.abs(e.clientX - pressStartX) > 10 || Math.abs(e.clientY - pressStartY) > 10)) {
        clearTimeout(pressTimer); pressTimer = null;
    }
});
['pointerup', 'pointerleave', 'pointercancel'].forEach(evt => {
    concernFeed.addEventListener(evt, () => { if (pressTimer) { clearTimeout(pressTimer); pressTimer = null; } });
});
concernFeed.addEventListener('contextmenu', e => {
    const card = e.target.closest('.concern-card');
    if (card && card.dataset.selectable === 'true' && !isInteractiveTarget(e.target)) e.preventDefault();
});

// While in selection mode (something already selected), a plain click toggles the
// card instead of requiring another long-press — matching the usual "selection mode"
// pattern in mobile/photo-picker style UIs. Before selection mode starts, only the
// long-press above can select the first card.
concernFeed.addEventListener('click', e => {
    if (longPressFired) { longPressFired = false; return; } // this click is the tail end of a long-press that already toggled the card
    const card = e.target.closest('.concern-card');
    if (!card || card.dataset.selectable !== 'true' || isInteractiveTarget(e.target)) return;
    if (anyCardSelected()) toggleCardSelection(card);
});

function syncSelectedIdsIntoForm(form) {
    form.querySelectorAll('input[name="concernIds"]').forEach(el => el.remove());
    document.querySelectorAll('.concern-select:checked').forEach(cb => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'concernIds';
        input.value = cb.dataset.id;
        form.appendChild(input);
    });
}
document.getElementById('bulk-confirm-form').addEventListener('submit', function () { syncSelectedIdsIntoForm(this); });

document.querySelectorAll('.floating-toast').forEach(toast => setTimeout(() => toast.remove(), 5000));

function openStatusModal(concernId, citizenName) { document.getElementById('modal-citizen-name').textContent = citizenName; document.getElementById('modal-concern-id').value = concernId; document.getElementById('modal-status-select').value = ''; document.getElementById('modal-notes').value = ''; }
function refreshConcernFeed() {
    fetch(window.location.href).then(res => res.text()).then(html => {
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const newFeed = doc.getElementById('concern-feed');
        const currentFeed = document.getElementById('concern-feed');
        if (!newFeed || !currentFeed) return;

        // The refresh swaps in brand-new card elements, which would otherwise silently
        // drop any in-progress selection (and leave the floating toolbar's stale count
        // pointing at checkboxes that no longer exist). Re-apply selection by concern ID
        // to whichever of the refreshed cards still match, then resync the toolbar.
        const selectedIds = new Set(Array.from(document.querySelectorAll('.concern-select:checked')).map(cb => cb.dataset.id));

        currentFeed.innerHTML = newFeed.innerHTML;

        if (selectedIds.size > 0) {
            currentFeed.querySelectorAll('.concern-select').forEach(cb => {
                if (selectedIds.has(cb.dataset.id)) {
                    cb.checked = true;
                    cb.closest('.concern-card')?.classList.add('card-selected');
                }
            });
        }
        updateBulkToolbar();
    }).catch(() => { });
}
window.VoxAngelosRealtime = { onConcernFeedChanged: refreshConcernFeed }; setInterval(refreshConcernFeed, 45000);
function openLightbox(src, type) { const overlay = document.getElementById('lightboxOverlay'); const img = document.getElementById('lightboxImg'); const video = document.getElementById('lightboxVideo'); img.style.display = 'none'; video.style.display = 'none'; video.pause(); if (type === 'image') { img.src = src; img.style.display = 'block'; } else if (type === 'video') { video.src = src; video.style.display = 'block'; } overlay.classList.add('is-open'); document.body.style.overflow = 'hidden'; }
function closeLightbox() { const overlay = document.getElementById('lightboxOverlay'); const video = document.getElementById('lightboxVideo'); video.pause(); overlay.classList.remove('is-open'); document.body.style.overflow = ''; }
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });
</script> }
